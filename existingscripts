ALTER      PROCEDURE [dbo].[anthem_recon_file_Insert]  
 @anthem_recon_file_id int OUTPUT,  
 @file_name varchar(250),  
 @file_type varchar(250),  
 @load_rows int,  
 @created_user varchar(250)   

AS  
  
BEGIN  
 SET NOCOUNT ON  
 
 DECLARE @sp_name	VARCHAR(50) = OBJECT_NAME(@@PROCID)
 DECLARE @ServerName VARCHAR(100) = (SELECT @@SERVERNAME)
 DECLARE @NotificationType VARCHAR(100)    
 DECLARE @ProgramName VARCHAR(100) 
 DECLARE @Email_Subject VARCHAR(300) = ''  
 DECLARE	@error_message		VARCHAR(MAX),  
			@dt					DATETIME		= GETDATE() ,
			@sec_user_id		INT,     
			@sec_user_name		VARCHAR(50),    
			@start				INT,    
			@login_name			VARCHAR(50)    

	SELECT @sec_user_name = suser_sname()   
	SELECT @start = charindex('\',@sec_user_name) 
	SELECT @login_name = substring(@sec_user_name,@start+1,len(@sec_user_name)-@start)     
	SELECT @sec_user_id = 0   
	SELECT @sec_user_id = sec_user_id FROM mcr_dc_prod.dbo.sec_user WHERE login_name = @login_name     
  
 BEGIN TRY  
    BEGIN  
      
    INSERT INTO Edee.[dbo].[anthem_recon_file]  
     (file_name, file_type,load_rows,created_user,created_user_id,modified_user_id)   
    VALUES  
     (@file_name,@file_type,@load_rows,@created_user,@sec_user_id,@sec_user_id)  
      	     
    SET @anthem_recon_file_id = SCOPE_IDENTITY()  

   END  
     
 END TRY  
 BEGIN CATCH  
    
 		SET @Email_Subject = @NotificationType + ' - ' + @ProgramName + ' - ' + @ServerName 
		SET @ProgramName = 'Finance Support'
		SET @error_message = 'A database error occurred:'
			+ CHAR(13) + CHAR(10)
			+ 'Procedure Name: ' + @sp_name
			+ CHAR(13) + CHAR(10)
			+ 'Error Description: ' + ERROR_MESSAGE()
			+ CHAR(13) + CHAR(10)
			+ 'User: ' + @login_name
		EXEC mcr_dc_prod.[dbo].[finance_email_notification] @sec_user_id, @error_message, @ProgramName, @sp_name
  
  ;THROW  
 END CATCH  
  
 RETURN 0  
  
END  


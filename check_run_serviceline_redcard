                                                          --AND code_type.code_type = 'comp_rbrvs'
                   AND [code_type].[eff_date] <= @service_from_date
                   AND
                   (
                       [code_type].[term_date] > @service_from_date
                       OR [code_type].[term_date] IS NULL
                   )
        WHERE [comp_rbrvs].[comp_rbrvs_ud] = @procedure_code_ud;




        BEGIN
            SET @copay_amount = 0.00; -- 08/22/2021
            SET @coinsurance_amount = 0.00; -- 08/22/2021
            SET @deductible = 0.00; -- 08/22/2021
            IF @medicare_patient_responsibility <> 0.00
                SET @patient_responsibility = @medicare_patient_responsibility - @net_amount;
            ELSE
                SET @patient_responsibility = 0.00; -- if the medicare patient resposibility is 0 the patient responsibility is 0.00
        END;
        ELSE IF (@employergroup_id = 5132 AND @checkbook_id = 509) -- PS 7/22/2024 Remove ineligible amount from calculation for LSU checkbook 509
        BEGIN
            SET @patient_responsibility
                = ISNULL(@deductible, 0) + ISNULL(@coinsurance_amount, 0) + ISNULL(@copay_amount, 0) - ISNULL(@msa_total_used, 0);
        END;
		ELSE IF @IsCorrectedClaim = 1 -- 47175 Remove benefit ineligible amount from patient responsibility on corrected claims
        BEGIN

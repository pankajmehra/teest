       @employergroup_id = [e].[employergroup_id],
       @checkbook_id = [v].[checkbook_id]
FROM [dbo].[voucher] AS [v]
    INNER JOIN [dbo].[voucher_claim_procedure_map] AS [vcpm]
        ON [vcpm].[voucher_id] = [v].[voucher_id]
    INNER JOIN [dbo].[claim_procedure] AS [cp]
        ON [cp].[claim_procedure_id] = [vcpm].[claim_procedure_id]
    INNER JOIN [dbo].[claim] AS [c]
        ON [c].[claim_id] = [cp].[claim_id]
    INNER JOIN [dbo].[eligibility] AS [e]
        ON [e].[eligibility_id] = [c].[eligibility_id]
    INNER JOIN [dbo].[check_run_account_header] AS [crah]
        ON [crah].[check_run_id] = [v].[check_run_id]
    --INNER JOIN [dbo].[claim_procedure_attachment] AS [cpa]
    --ON [cpa].[claim_procedure_id] = [cp].[claim_procedure_id]
    LEFT JOIN [dbo].[check_run_attachment] AS [cra]
        ON [cra].[check_run_id] = [crah].[check_run_id]
    LEFT JOIN [dbo].[check_run_eob_claim] AS [crec]
        ON [crec].[claim_id] = [c].[claim_id]
    LEFT JOIN [dbo].[check_run_eop_claim] AS [crec2]
        ON [crec2].[claim_id] = [c].[claim_id]
WHERE [cp].[claim_procedure_id] = @claim_procedure_id
      AND [v].[deleted] = 0;



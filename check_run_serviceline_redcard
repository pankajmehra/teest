        IF @print_accumulators_on_eob = 1
           AND (@doc_type = 'EOB')
           AND @first_claim_procedure = 1
        BEGIN
            --------------------------------------------------
            -- Fill the temp table with information from the
            -- accumulator and benefit_accum_def table for the member
            --------------------------------------------------
            SET @VISIT_TYPE = 4;
            --DELETE FROM @member_accum_info		-- don't delete accumulate all of them

            DELETE FROM @member_accum;
            INSERT INTO @member_accum
            (
                [benefit_accum_def_id],
                [amount],
                [carryover_amount],
                [flow_amount],
                [seed_amount],
                [period_begin_date],
                [period_end_date],
                [benefitplan_id],
                [employergroup_id]
            )
            SELECT --DISTINCT
                [a].[benefit_accum_def_id],
                [a].[amount],
                [a].[carryover_amount],
                [a].[flow_amount],
                [a].[seed_amount],
                [a].[period_begin_date],
                [a].[period_end_date],
                [a].[benefitplan_id],
                [a].[employergroup_id]
            FROM [accumulator] [a]
            WHERE [a].[member_id] = @claim_member_id
                  AND
                  (
                      [a].[period_begin_date] IS NULL
                      OR @service_from_date
                  BETWEEN [a].[period_begin_date] AND [a].[period_end_date]
                      OR [a].[period_begin_date]
                  BETWEEN @service_from_date AND @service_to_date
                  );

            DELETE FROM @member_accum_info;
            INSERT INTO @member_accum_info
            (
                [line_number],
                [benefit_accum_def_id],
                --,	benefit_accum_def_ud
                [print_on_eob],
                [eob_display_name],
                [benefit_accum_type_id],
                [carryover_amount],
                [accumulated_amount],
                [flow_amount],
                [seed_amount],
                [total_amount],
                [maximum],
                [period_begin_date],
                [period_end_date],
                [member_id],
                [benefitplan_id],
                [employergroup_id],
                [apply_copay],
                [apply_coinsurance],
                [apply_deductible],
                [apply_netpay],
                [apply_visits],
                [is_individual]
            )
            SELECT --distinct
                SUBSTRING(@servicelinesequence_char, 3, 4),
                [benefit_accum_def].[benefit_accum_def_id],
                                --benefit_accum_def.benefit_accum_def_ud, 
                [benefit_accum_def].[print_on_eob],
                [benefit_accum_def].[eob_display_name],
                [benefit_accum_def].[benefit_accum_type_id],
                [a].[carryover_amount],
                [a].[amount] AS [accumulated_amount],
                [a].[flow_amount],
                [a].[seed_amount],
                0 AS [total_amount],
                [benefit_accum_def].[maximum],
                [a].[period_begin_date],
                [a].[period_end_date],
                @claim_member_id,
                [benefit_accum_def].[benefitplan_id],
                [a].[employergroup_id],
                [apply_copay],
                [apply_coinsurance],
                [apply_deductible],
                [apply_netpay],
                [apply_visits],
                [is_individual] -- elva 02/10/2020

            FROM [benefit_accum_def]
                INNER JOIN @member_accum [a]
                    ON [benefit_accum_def].[benefit_accum_def_id] = [a].[benefit_accum_def_id]
            WHERE [benefit_accum_def].[benefitplan_id] = @benefitplan_id
                  AND [a].[employergroup_id] = @employergroup_id;


            UPDATE @member_accum_info
            SET [carryover_amount] = 0
            WHERE [carryover_amount] IS NULL;
            UPDATE @member_accum_info
            SET [accumulated_amount] = 0
            WHERE [accumulated_amount] IS NULL;
            UPDATE @member_accum_info
            SET [seed_amount] = 0
            WHERE [seed_amount] IS NULL;
            UPDATE @member_accum_info
            SET [flow_amount] = 0
            WHERE [flow_amount] IS NULL;

            -- remove rows with no MONEY so the join below fOR visit totals doesn't make extra display rows fOR days that should'nt have a value.  just a display issue but confusing to look it.
            DELETE FROM @member_accum_info
            WHERE [carryover_amount] = 0
                  AND [accumulated_amount] = 0
                  AND [seed_amount] = 0
                  AND [flow_amount] = 0;

            UPDATE [mai]
            SET [accumulated_amount] = [total_visit].[claim_amount],
                [total_amount] = [total_visit].[total_amount] + [flow_amount]
            FROM
            (
                SELECT SUM([accumulated_amount]) AS [claim_amount],
                       SUM([accumulated_amount]) AS [total_amount],
                       [mai_total].[benefit_accum_def_id]
                FROM @member_accum_info [mai_total]
                WHERE [mai_total].[benefit_accum_type_id] = @VISIT_TYPE
                GROUP BY [mai_total].[benefit_accum_def_id]
            ) AS [total_visit]
                INNER JOIN @member_accum_info [mai]
                    ON [total_visit].[benefit_accum_def_id] = [mai].[benefit_accum_def_id]
            WHERE [mai].[benefit_accum_type_id] = @VISIT_TYPE; -- these are visit type

            UPDATE [mai]
            SET [total_amount] = ROUND([carryover_amount] + [accumulated_amount] + [seed_amount] + [flow_amount], 2)
            FROM @member_accum_info [mai]
            WHERE [mai].[benefit_accum_type_id] <> @VISIT_TYPE;

            INSERT INTO [#remark_table_accum]
            (
                [line_number],
                [remark],
                [remark_type]
            )
            SELECT SUBSTRING(@servicelinesequence_char, 3, 4),
                   LEFT([eob_display_name]
                        --benefit_accum_def_ud 
                        + CASE [benefit_accum_type_id]
                              WHEN @VISIT_TYPE THEN
                                  ' '
                              ELSE
                                  ' $'
                          END + CASE [benefit_accum_type_id]
                                    WHEN @VISIT_TYPE THEN
                                        CONVERT(VARCHAR(20), CONVERT(INT, [total_amount]))
                                    ELSE
                                        CONVERT(VARCHAR(20), [total_amount])
                                END + CASE [benefit_accum_type_id]
                                          WHEN @VISIT_TYPE THEN
                                              '/'
                                          ELSE
                                              '/$'
                                      END + CASE [benefit_accum_type_id]
                                                WHEN @VISIT_TYPE THEN
                                                    CONVERT(VARCHAR(20), CONVERT(INT, [maximum]))
                                                ELSE
                                                    CONVERT(VARCHAR(20), [maximum])
                                            END, 450) AS [remark],
                   'ACCUM' AS [remark_type]
            FROM
            (
                SELECT DISTINCT
                       [mai].[benefit_accum_def_id],
                       --,	mai.benefit_accum_def_ud
                       [mai].[benefit_accum_type_id],
                       [mai].[print_on_eob],
                       [mai].[eob_display_name],
                       [mai].[total_amount],
                       [mai].[maximum],
                       [mai].[member_id],
                       [mai].[benefitplan_id],
                       [mai].[employergroup_id]
                FROM @member_accum_info [mai]
            --	WHERE print_on_eob = 1
            ) AS [final_table]
            ORDER BY [eob_display_name],
                     [maximum],
                     [benefit_accum_def_id];
            --ORDER BY benefit_accum_def_ud, maximum, benefit_accum_def_id
            -- if check_run_communit_id = 50 (nextera) we need to create two  accumulator records  elva 12/10/2019
            -- Nextera has a special Members Health Statement which print after the EOB with the oop and the deductable 
            -- they have a new community also 51 
            -- 08/19/2021 I think all of blue cross blue shield groups Check_run_community_id = 55 will use the 

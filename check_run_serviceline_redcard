                = ISNULL(@deductible, 0) + ISNULL(@coinsurance_amount, 0) + ISNULL(@copay_amount, 0) - ISNULL(@msa_total_used, 0);
        END;
		ELSE IF @IsClaimNegate = 1    -- 47175 Remove benefit ineligible amount from patient responsibility on claim reversals

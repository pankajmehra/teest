     INNER JOIN eligibility e  ON cl.eligibility_id = e.eligibility_id  
     LEFT JOIN group_contract gc  ON e.group_contract_id = gc.group_contract_id  
    WHERE  
     claim_ud > @claim_number  
     AND c.correspondence_id = @correspondence_id  
     AND c.deleted = 0  
     AND ccl.deleted = 0  
    ORDER BY  
     claim_ud  
  

     SET @forms_servicedt_to = DATEADD(month, @prex_look_back_period, @lookback_date)  
    end   
   WHILE @claim_number IS NOT NULL AND @count <= 5  
   BEGIN  
    --  lets get the fisrt 5 claim numbers linked to this correspondence  
    SELECT TOP 1  
     @claim_number = cl.claim_ud,  
     @claim_id = cl.claim_id ,  
     @forms_servicedt_from= cl.first_from_service_date,  
     @forms_servicedt_to = cl.last_to_service_date,  
     @lookback_date = cl.pre_existing_lookback_date,  

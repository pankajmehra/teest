  BEGIN   
		select 
			@claim_procedure_id = cp.claim_procedure_id,
			@claim_id = cp.claim_id,
			@claim_revision_number = c.revision_number,
			@invoice_number = isnull(co.claim_overpayment_id, ''), -- DA US 42325 (08/28/2025)
			@original_claim_id = c.original_claim_id,
			@accident_date = isnull(c.accident_date,''),
			@accident_case_number ='',
			@fb_allowance = '',
			@other_carrier_name = '',
			@audit_number = '' ,
			@total_combined_payment = ''
		FROM
			claim c  
			inner join correspondence_claim_link cl on cl.claim_id  = c.claim_id
			inner join eligibility e ON c.eligibility_id = e.eligibility_id 
			inner join claim_procedure cp   ON c.claim_id = cp.claim_id
			inner join claim_procedure_eob cpe   ON cp.claim_procedure_id = cpe.claim_procedure_id
			inner join eob on eob.eob_id = cpe.eob_id
			inner join claim_overpayment co ON co.claim_procedure_id = cp.claim_procedure_id  -- DA US 42325 (08/28/2025)
		WHERE
			 cl.correspondence_id = @correspondence_id
			 and (c.claim_payment_to_id = 1 or c.claim_payment_to_id is null)
			and c.claim_id = @claim_id

		-- Get all procedure codes that are overpaid. 
		SELECT @remarkinfo_overpay = string_agg(procedurecode_ud,',') from claim_procedure where
					claim_procedure_status_id NOT IN (22,37,38) -- Get all procedure codes
					AND claim_id = @claim_id


		-- Get balance due and Total balance due i.e. Overpayment amount(cOpenField4)
			SELECT  @total_amount = sum(isnull(overpayment_amount,0))
				FROM claim_overpayment co where co.claim_id = @claim_id 

		-- Get eob_nm from claim procedure eob id of claim overpayment table
			SELECT  @overpayment_reason =  eob.eob_nm
			FROM claim_overpayment co 
			inner join claim_procedure_eob cpe   ON co.claim_procedure_eob_id = cpe.claim_procedure_eob_id
			inner join eob on eob.eob_id = cpe.eob_id
			where co.claim_id = @claim_id

		-- Get amount from rev 0 claim = deductible + co-insurance + copay amount + ineligible_amount
		SELECT 
			@original_amount =sum ( isnull(cpb.deductible,0)+isnull(cpb.coinsurance_amount,0)+ isnull(cpb.copay_amount,0)+isnull(cpb.ineligible_amount,0) )-- *-1  Negating the value to be listed as positive overpayment letter
			from claim_procedure_benefit cpb
		inner join claim_procedure cp on cpb.claim_procedure_id = cp.claim_procedure_id
		inner join correspondence_claim_link cl on cl.claim_id = cp.claim_id
		and cp.claim_id = @original_claim_id


		-- Get amount from rev+1 of claim that has PEND OVERPAYMENT status as per Tania Benitez
		SELECT @correctedamount_claim_id = c.claim_id 
		FROM claim c 
		WHERE revision_number = @claim_revision_number + 1		
			AND c.claim_ud = @claim_number
		--print @correctedamount_claim_id
		-- Get amount from rev 2 claim = deductible + co-insurance + copay amount + ineligible_amount
		SELECT 
			@corrected_amount = sum ( isnull(cpb.deductible,0)+isnull(cpb.coinsurance_amount,0)+ isnull(cpb.copay_amount,0)+isnull(cpb.ineligible_amount,0) )-- *-1  Negating the value to be listed as positive overpayment letter
			from claim_procedure_benefit cpb
		inner join claim_procedure cp on cpb.claim_procedure_id = cp.claim_procedure_id		
		and cp.claim_id = @correctedamount_claim_id

			SELECT 	-- Overpayment claim will Only have 1 row for overpayment status id's( 37/22/28	)
			--@total_amount = sum(isnull(cpb.net_amount,0))*-1, -- Negating the value to be listed as positive overpayment letter
			@original_invoice_amount =  sum(isnull(cpb.net_amount,0))*-1, -- Negating the value to be listed as positive overpayment letter
			@other_carrier_amount = sum(isnull(cpb.cob_savings_amount,0))*-1 -- Negating the value to be listed as positive overpayment letter,
			--@original_amount =sum ( isnull(cpb.deductible,0)+isnull(cpb.coinsurance_amount,0)+ isnull(cpb.copay_amount,0)+isnull(cpb.ineligible_amount,0) ) *-1, -- Negating the value to be listed as positive overpayment letter
			--@corrected_amount= sum ( isnull(cpb.deductible,0)+isnull(cpb.coinsurance_amount,0)+ isnull(cpb.copay_amount,0)+isnull(cpb.ineligible_amount,0) ) *-1 -- Negating the value to be listed as positive overpayment letter
		from claim_procedure_benefit cpb
		inner join claim_procedure cp on cpb.claim_procedure_id = cp.claim_procedure_id
		inner join correspondence_claim_link cl on cl.claim_id = cp.claim_id
		and cp.claim_id = @claim_id
		and cl.correspondence_id = @correspondence_id

	-- Get Check number and check date for the overpaid and closed claim using @claim_number
		select top 1 @overpay_check_date =  cc.check_date  --cc.created_date
			,@overpay_check_number = coalesce( cc.trace_number,convert(varchar(50),cc.alt_check_number),convert(varchar(50),cc.payment_reference))
		from claim c
		inner join claim_procedure cp on cp.claim_id = c.claim_id
		inner join voucher_claim_procedure_map vcp on vcp.claim_procedure_id = cp.claim_procedure_id
		inner join voucher v on v.voucher_id = vcp.voucher_id
		inner join voucher_payment vp on vp.voucher_id = v.voucher_id
		inner join checkbook cb on cb.checkbook_id = v.checkbook_id
		inner join checkbook_check cc on cc.checkbook_check_id = vp.checkbook_check_id
		where c.claim_id = @original_claim_id
		and cc.deleted = 0
		and cb.deleted = 0
		and vcp.deleted = 0
		and vp.deleted = 0
		and v.deleted = 0		
		--and vp.check_run_id = @check_run_id
		order by vp.voucher_payment_id desc
  END  


// =======================================================
// 1. VIEWMODEL
// =======================================================

private bool _isInitialLoadComplete;

public async Task LoadAsync()
{
    // Loaded can fire more than once, so prevent duplicate searches
    if (_isInitialLoadComplete)
        return;

    _isInitialLoadComplete = true;

    var thruDate = DateTime.Today;
    var effectiveDate = thruDate.AddMonths(-6);

    // Actual values used by the API
    SearchCriteria.EffectiveDate = effectiveDate;
    SearchCriteria.ThruDate = thruDate;

    // Values displayed in the TextBoxes
    SearchCriteria.EffectiveDateText =
        effectiveDate.ToString("MM/dd/yyyy");

    SearchCriteria.ThruDateText =
        thruDate.ToString("MM/dd/yyyy");

    SearchCommand.NotifyCanExecuteChanged();

    if (SearchCommand.CanExecute(null))
    {
        await SearchCommand.ExecuteAsync(null);
    }
}


// =======================================================
// 2. SEARCH COMMAND CAN-EXECUTE
// =======================================================

protected override bool OnSearchCommandCanExecute()
{
    return SelectedParentEmployerGroupUD != null
        || SelectedEmployerGroupUD != null
        || SelectedGroupContractUD != null
        || SelectedBenefitPlanUd != null
        || SearchCriteria.EffectiveDate.HasValue
        || SearchCriteria.ThruDate.HasValue
        || !string.IsNullOrWhiteSpace(SearchCriteria.Comment);
}


// =======================================================
// 3. PAGE CODE-BEHIND
// GroupHoldoverSearchPage.xaml.cs
// =======================================================

private async void Page_Loaded(object sender, RoutedEventArgs e)
{
    await ViewModel.LoadAsync();
}



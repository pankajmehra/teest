private void EffectiveDate_TextChanged(
    object sender,
    TextChangedEventArgs e)
{
    var textBox = (TextBox)sender;

    var digits = new string(
        textBox.Text.Where(char.IsDigit).ToArray());

    // User has not finished typing yet
    if (digits.Length < 8)
    {
        ViewModel.GroupHoldoverRow.EffectiveDate = null;
        return;
    }

    // Prevent more than 8 digits
    if (digits.Length > 8)
        return;

    var formattedDate = DateHelper.FormatDateStr(
        digits,
        DateFormat.MMDDYYYYwSlashes);

    if (DateTime.TryParse(formattedDate, out var date))
    {
        ViewModel.GroupHoldoverRow.EffectiveDate = date;

        // Rewrite only once, after a complete valid date was entered
        if (textBox.Text != formattedDate)
        {
            textBox.Text = formattedDate;
            textBox.SelectionStart = textBox.Text.Length;
        }
    }
    else
    {
        ViewModel.GroupHoldoverRow.EffectiveDate = null;
    }
}
ALTER PROCEDURE [dbo].[Usp_adj_l10_line_level_deny_external]
    @claim_procedure_id INT,
    @claim_type_id INT,
    @group_contract_id INT,
    @adjudication_step_id INT,
    @employergroup_id INT,
    @parent_employergroup_id INT
AS
/*************************************************************************
Name:			[dbo].[Usp_adj_l10_line_level_deny_external]
Description:	
Used by:		
Test harness:	
DECLARE @claim_procedure_id int = 224003815
DECLARE @claim_type_id int = 2
DECLARE @group_contract_id int = 248404
DECLARE @adjudication_step_id int = 2
declare @employergroup_id int = 56729
DECLARE @parent_employergroup_id int = 56727
DECLARE @return_status int

EXEC @return_status = [dbo].[Usp_adj_l10_line_level_deny_external] @claim_procedure_id, @claim_type_id, @group_contract_id, @adjudication_step_id, @employergroup_id, @parent_employergroup_id

Print @return_status


Execution time: 
Return values:	Procedure returns zero for success and non-zero for failure.
Created:		KDW 7/8/2020
Modified:		
Modified: 05/12/2026	KDW 	44814   update for External Edit Direct Deny 
Modified: 05/13/2026	DA 	    46447   update for External Edit Direct Deny  of Institutional claims 
**************************************************************************/
BEGIN

    ---------------------------------------
    --	Always include these two lines just above the "begin try".
    --	ALL other lines of code go in the try/catch block.
    ---------------------------------------
    SET NOCOUNT ON;
    SET XACT_ABORT ON;


    ---------------------------------------
    --	ALL content within TRY/CATCH
    ---------------------------------------
    BEGIN TRY

        DECLARE @reportdate DATETIME;
        DECLARE @SProc VARCHAR(50);
        SET @reportdate = GETDATE();
        SET @SProc = OBJECT_NAME(@@PROCID);

        DECLARE @all_edits BIT = 'False';
        DECLARE @remove_remarks BIT = 'False';
        DECLARE @edit_code VARCHAR(50) = '';
        DECLARE @set_to_deny BIT = 'False';
        DECLARE @adlp_id INT ;
        DECLARE @return_status INT = 0;
        DECLARE @exclusion_check INT = 0;
        DECLARE @revision_number INT;
        DECLARE @adjudication_procedure_deny_log_id INT; --44814
        DECLARE @claim_procedure_external_edit_id BIGINT; --44814
        DECLARE @tc_error_message NVARCHAR(4000);
                --US 46447
        DECLARE @UB9_edits_exist bit = 0;
        DECLARE @all_service_lines_denied BIT = 1
        DECLARE @claim_procedure_status_id INT
        DECLARE @denycounter INT = 0
        DECLARE @service_lines_count INT = 0
        DECLARE @diff_edit_codes BIT
        --DECLARE @edit_code VARCHAR(5)
        DECLARE @new_claim_procedure_id INT
          IF OBJECT_ID('UB9_Servicelines1', 'U') IS NOT NULL
          DROP TABLE UB9_Servicelines1
        -- Create table to hold service lines
       CREATE TABLE UB9_Servicelines1(
       ID INT IDENTITY(1,1) PRIMARY KEY,
       claim_procedure_id INT,
       claim_ub92_service_id INT,
       claim_ub92_service_external_edit_id INT,
       adjudication_procedure_line_deny INT,
       edit_code VARCHAR(5),
      -- sequence_number INT,
      -- claim_procedure_status_id INT,
       deny_service_line bit
       )


        ----44814
        ----first, let's show we were here
        --INSERT INTO [dbo].[adjudication_procedure_line_deny_log]
        --(
        --    [claim_procedure_id],
        --    [log_date]
        --)
        --VALUES
        --(@claim_procedure_id, @reportdate);

        --SET @adjudication_procedure_deny_log_id = SCOPE_IDENTITY();

        ---------------------------------------------------------
        --	JJT	10/12/2023
        --	For revision # > 0 we'll allow examiner to override.
        --	Shannon Junek	10/12/2023
        ---------------------------------------------------------
        SELECT @revision_number = [c].[revision_number]
        FROM [claim] [c]
            INNER JOIN [claim_procedure] [cp]
                ON [cp].[claim_id] = [c].[claim_id]
        WHERE [cp].[claim_procedure_id] = @claim_procedure_id;

        IF @revision_number > 0
        BEGIN
            IF EXISTS(     SELECT 1
            FROM [dbo].[claim_procedure_external_edit] AS [cpee]
            WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
                  AND [cpee].[deny_service_line] = 1
                  --  10.12.2023  JJT  Allow examiners to override if revision # > 0
                  AND [cpee].[deleted] = 0
                  AND [cpee].[override] = 0 )
                BEGIN
                    --is there an edit for this procedure line and is it set to deny
                    --gather edit code in case this is specific to edit
                    SELECT TOP 1
                           @set_to_deny = 'True',
                           @edit_code = [cpee].[edit_code],
                           @claim_procedure_external_edit_id = [cpee].[claim_procedure_external_edit_id]
                    FROM [dbo].[claim_procedure_external_edit] AS [cpee]
                    WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
                          AND [cpee].[deny_service_line] = 1

                          --  10.12.2023  JJT  Allow examiners to override if revision # > 0
                          AND [cpee].[deleted] = 0
                          AND [cpee].[override] = 0;
                END
          -- Check claim type for UB9
            ELSE IF (@claim_type_id = 3) AND (@set_to_deny = 'False')-- Institutional claims US 46447
            BEGIN
                SELECT TOP 1
				       @set_to_deny = 'True',
				      -- @edit_code = [cpee].[edit_code],
                       @UB9_edits_exist = 1 -- 46447 set flag to do UB9 service line updates
			    FROM [dbo].[claim_ub92_service_external_edit] AS [cpee]
                 INNER JOIN [dbo].[claim_ub92_service] AS [ubs]
                                ON [ubs].[claim_ub92_service_id] = [cpee].[claim_ub92_service_id]
                 INNER JOIN [dbo].[claim_procedure] AS [cp]
                        ON [cp].[claim_procedure_id] = [ubs].[claim_procedure_id]
			    WHERE [ubs].[claim_procedure_id] = @claim_procedure_id
                      AND [cpee].deny_service_line = 1
				      and cpee.deleted = 0
            END -- @claim_type_id = 3

       --    SELECT  @UB9_edits_exist UB9_edits_exist

        END;
        ELSE
        BEGIN
            IF EXISTS( SELECT  1
            FROM [dbo].[claim_procedure_external_edit] AS [cpee]
            WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
                  AND [cpee].[deny_service_line] = 1
                  AND [cpee].[deleted] = 0)
            BEGIN
                --is there an edit for this procedure line and is it set to deny
                --gather edit code in case this is specific to edit
                SELECT TOP 1
                       @set_to_deny = 'True',
                       @edit_code = [cpee].[edit_code],
                       @claim_procedure_external_edit_id = [cpee].[claim_procedure_external_edit_id]
                FROM [dbo].[claim_procedure_external_edit] AS [cpee]
                WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
                      AND [cpee].[deny_service_line] = 1
                      AND [cpee].[deleted] = 0;
            END
         -- Check claim type for UB9
            ELSE IF (@claim_type_id = 3) AND (@set_to_deny = 'False')-- Institutional claims US 46447
            BEGIN
                SELECT TOP 1
				       @set_to_deny = 'True',
				      -- @edit_code = [cpee].[edit_code],
                       @UB9_edits_exist = 1 -- 46447 set flag to do UB9 service line updates
			    FROM [dbo].[claim_ub92_service_external_edit] AS [cpee]
                 INNER JOIN [dbo].[claim_ub92_service] AS [ubs]
                                ON [ubs].[claim_ub92_service_id] = [cpee].[claim_ub92_service_id]
                 INNER JOIN [dbo].[claim_procedure] AS [cp]
                        ON [cp].[claim_procedure_id] = [ubs].[claim_procedure_id]
			    WHERE [ubs].[claim_procedure_id] = @claim_procedure_id
                      AND [cpee].deny_service_line = 1
				      and cpee.deleted = 0

     -- SELECT  @UB9_edits_exist UB9_edits_exist

            END -- @claim_type_id = 3

        END;

        --	JJT 10/12/2023 Replaced with code above.
        --is there an edit for this procedure line and is it set to deny
        --gather edit code in case this is specific to edit
        --SELECT TOP 1
        --       @set_to_deny = 'True',
        --       @edit_code = [cpee].[edit_code]
        --FROM [dbo].[claim_procedure_external_edit] AS [cpee]
        --WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
        --      AND [cpee].[recommended_action] = 'DENY'


        SELECT @exclusion_check = COUNT(*)
        FROM [dbo].[adjudication_edit_exclusion] AS [aee]
            INNER JOIN [dbo].[adjudication_procedure_line_edit_type] AS [aplet]
                ON [aplet].[adjudication_procedure_line_edit_type_id] = [aee].[adjudication_procedure_line_edit_type_id]
        WHERE [aplet].[adjudication_procedure_line_edit_type_name] = 'external_edits'
              AND [aee].[employer_group_id] = @employergroup_id
              AND [aee].[adjudication_edit_code] = @edit_code
              AND [aee].[deleted] = 0;


  --      Print 'set to deny'
  --      Print @set_to_deny
  --      Print 'edit code'
  --      Print @edit_code
		--PRINT @exclusion_check


         SELECT @all_edits = [apld].[include_all_edits],
                       @remove_remarks = [apld].[remove_remark_codes],
                       @adlp_id = [apld].[adjudication_procedure_line_deny_id]
                FROM [dbo].[adjudication_procedure_line_deny] AS [apld]
                    INNER JOIN [dbo].[adjudication_procedure_line_edit_type] AS [aplet]
                        ON [aplet].[adjudication_procedure_line_edit_type_id] = [apld].[adjudication_procedure_line_edit_type_id]
                WHERE [aplet].[adjudication_procedure_line_edit_type_name] = 'external_edits'
                      AND [apld].[claim_type_id] = @claim_type_id
                      AND
                      (
                          (
                              ISNULL([apld].[group_contract_id], 0) = @group_contract_id
                              AND [apld].[adjudication_field_type_id] = 1
                          )
                          OR
                          (
                              ISNULL([apld].[employergroup_id], 0) = @employergroup_id
                              AND [apld].[adjudication_field_type_id] = 2
                          )
                          OR
                          (
                              ISNULL([apld].[parent_employergroup_id], 0) = @parent_employergroup_id
                              AND [apld].[adjudication_field_type_id] = 3
                          )
                      )
                      AND [apld].[adjudication_step_id] = @adjudication_step_id
                      AND [apld].[Active] = 'True';

                --Print 'all edits'
                --Print @all_edits
                --Print 'remove remarks'
                --Print @remove_remarks
                --Print 'id'
                --Print @adlp_id

   
          IF @UB9_edits_exist = 1 AND @set_to_deny = 'True' 
            BEGIN

                INSERT INTO UB9_Servicelines1( claim_procedure_id, claim_ub92_service_id, claim_ub92_service_external_edit_id, adjudication_procedure_line_deny, edit_code, deny_service_line)
                SELECT [ubs].[claim_procedure_id],
                        [ubs].[claim_ub92_service_id],
                        [cpee].[claim_ub92_service_external_edit_id],
                        @adlp_id ,
                        [cpee].[edit_code],
                        [cpee].deny_service_line                        
                FROM [dbo].[claim_ub92_service_external_edit] AS [cpee]
                        INNER JOIN [dbo].[claim_ub92_service] AS [ubs]
                                    ON [ubs].[claim_ub92_service_id] = [cpee].[claim_ub92_service_id]
                        INNER JOIN [dbo].[claim_procedure] AS [cp]
                            ON [cp].[claim_procedure_id] = [ubs].[claim_procedure_id]
			        WHERE [ubs].[claim_procedure_id] = @claim_procedure_id				           
                            AND [cpee].deny_service_line = 1
				            and cpee.deleted = 0  

                 SELECT @denycounter = COUNT(*) from UB9_Servicelines1 WHERE deny_service_line = 1
                 SELECT @service_lines_count = COUNT(*) FROM [dbo].[claim_ub92_service] AS [ubs] where ubs.claim_procedure_id = @claim_procedure_id

                 --select @service_lines_count service_lines_count
                 --SELECT @denycounter denycounter 
                 --select * from UB9_Servicelines

  			    IF ( SELECT COUNT(DISTINCT edit_code) 
                        FROM UB9_Servicelines1 WHERE edit_code IS NOT NULL) = 1
                     BEGIN
                            SET @diff_edit_codes = 0
                             SELECT @edit_code =  edit_code  FROM UB9_Servicelines1 
 				    END
                        ELSE
                        BEGIN
                             SET @diff_edit_codes = 1
                        END  
                    
                     --   SELECT @diff_edit_codes diff_edit_codes
             END
                                  
            --US DA 46447
            IF (@diff_edit_codes = 0)  -- All service lines of claim_procedure status are denied
            BEGIN

            IF (@denycounter = @service_lines_count) AND (@set_to_deny = 'True')-- All service lines of claim_procedure status are denied
                BEGIN
                EXEC @return_status = [dbo].[claim_ub92_service_external_edit_deny] @all_service_lines_denied,@edit_code,@claim_procedure_id,  @new_claim_procedure_id OUT
                    IF @return_status <> 0  
                    BEGIN  
                        -- ========== RAISE ERROR: LOG MESSAGE A =================================
                        SET @tc_error_message = 'Error creating new claim Procedure and assigning ALL denied service lines to new claim_procedure'
	                   -- RAISERROR(@error_message, 16, 1) 
                    END
                END
            ELSE IF (@denycounter <> @service_lines_count) AND (@set_to_deny = 'True') -- Atleast one service line of claim_procedure not denied
                BEGIN
                    SET @all_service_lines_denied = 0
                    EXEC @return_status = [dbo].[claim_ub92_service_external_edit_deny] @all_service_lines_denied,@edit_code, @claim_procedure_id, @new_claim_procedure_id OUT
                    IF @return_status <> 0  
                    BEGIN  
                        -- ========== RAISE ERROR: LOG MESSAGE A =================================
                        SET @tc_error_message = 'Error creating new claim Procedure and assigning DENIED service lines to new claim_procedure'
	                   -- RAISERROR(@error_message, 16, 1) 
                    END
                END

                -- Add to deny log for all service lines that are denied 
                   INSERT INTO [dbo].[adjudication_procedure_line_deny_log]
                            SELECT @adlp_id,@claim_procedure_id, null, claim_ub92_service_id, claim_ub92_service_external_edit_id, edit_code,  @set_to_deny,@reportdate,0, null
                             FROM  UB9_Servicelines1 WHERE edit_code = @edit_code

             END -- End diff edit codes = 0
            ELSE IF (@diff_edit_codes = 1)
            BEGIN
             DECLARE @edit_codes TABLE(
                RowNum INT IDENTITY(1,1),
                edit_code VARCHAR(5)
                )
           
                INSERT INTO @edit_codes
                SELECT DISTINCT(edit_code) FROM UB9_Servicelines1

                DECLARE @totalCount  INT
                DECLARE @counter INT = 1
                SELECT @totalCount = COUNT(*) FROM @edit_codes;
                WHILE (@counter <= @totalCount)
                BEGIN
                 -- SELECT @edit_code = remark_code FROM @edit_codes  where RowNum = @counter
                    SELECT @edit_code = edit_code FROM @edit_codes  where RowNum = @counter
                --SELECT @denycounter = COUNT(*) FROM UB9_Servicelines WHERE deny_service_line = 1 and remark_code = @edit_code  
                   SELECT @denycounter = COUNT(*) FROM UB9_Servicelines1 WHERE deny_service_line = 1 and edit_code = @edit_code
                    SELECT @service_lines_count = COUNT(*) FROM [dbo].[claim_ub92_service] [cus]
                     INNER JOIN [dbo].[claim_ub92_service_external_edit] [cpee]                       
                        ON [cus].[claim_ub92_service_id] = [cpee].[claim_ub92_service_id]
                      --  WHERE [cus].[claim_procedure_id] = @claim_procedure_id and cpee.era_remark_code = @edit_code
                      WHERE [cus].[claim_procedure_id] = @claim_procedure_id and cpee.edit_code = @edit_code
                    
                        IF (@denycounter = @service_lines_count) AND (@set_to_deny = 'True')  
                        BEGIN
                        SET @all_service_lines_denied = 1
                        EXEC @return_status = [dbo].[claim_ub92_service_external_edit_deny] @all_service_lines_denied, @edit_code,@claim_procedure_id,  @new_claim_procedure_id OUT
                            IF @return_status <> 0  
                            BEGIN  
                                -- ========== RAISE ERROR: LOG MESSAGE A =================================
                                SET @tc_error_message = 'Error creating new claim Procedure and assigning ALL denied service lines to new claim_procedure'
	                           -- RAISERROR(@error_message, 16, 1) 
                            END
                         END
                        ELSE IF (@denycounter <> @service_lines_count) AND (@set_to_deny = 'True')  -- Atleast one service line of claim_procedure not denied
                            BEGIN
                                SET @all_service_lines_denied = 0
                            EXEC @return_status = [dbo].[claim_ub92_service_external_edit_deny] @all_service_lines_denied,@edit_code,@claim_procedure_id,  @new_claim_procedure_id OUT
                            IF @return_status <> 0  
                            BEGIN  
                                -- ========== RAISE ERROR: LOG MESSAGE A =================================
                                SET @tc_error_message = 'Error creating new claim Procedure and assigning DENIED service lines to new claim_procedure'
	                           -- RAISERROR(@error_message, 16, 1) 
                            END
                            -- Add to deny log for service lines that are denied with different remark codes
                            INSERT INTO [dbo].[adjudication_procedure_line_deny_log]
                            SELECT @adlp_id,@claim_procedure_id, null, claim_ub92_service_id, claim_ub92_service_external_edit_id, edit_code,  @set_to_deny,@reportdate,0, null
                             FROM  UB9_Servicelines1 WHERE edit_code = @edit_code
                        END

                       SET @counter += 1
                END 
            END --End diff remark codes = 0

            IF @set_to_deny = 'True' 
               AND ISNULL(@exclusion_check, 0) = 0
            BEGIN
		
               
                --right now this is only written for all edits.  
                --the flexibility is there to add the else for specific edits later.
                IF @all_edits = 'True'
                BEGIN
                    IF @remove_remarks = 'False'
                    BEGIN
                        SET @return_status = -200;
                   -- Print @return_status
                    RETURN @return_status;  --44814
                    END; --@remove_remarks = 'False'
                    ELSE --remove remark codes
                    BEGIN
                        --remove remark codes here
                        --there is a trigger tr_claim_procedure_eob_del that will move a copy of this to claim_procedure_eob_audit
                        DELETE FROM [dbo].[claim_procedure_eob]
                        WHERE [claim_procedure_id] = @claim_procedure_id;

                        SET @return_status = -200;
                   -- Print @return_status
                    RETURN @return_status;  --44814
                    END;

                END; --@all_edits = 'True'


            END; --@set_to_deny = 'True'
                 --if it is not set to deny we aren't worried about it right now
                 --this could have a pend option later if needed
                 --right now this should also handle if the record is not there
            ELSE
            BEGIN
                SET @return_status = 0;
            --Print @return_status
            --RETURN @return_status;  --44814
            END;

            IF @claim_type_id = 2  AND @set_to_deny = 'True' 
            BEGIN
                INSERT INTO [dbo].[adjudication_procedure_line_deny_log]
               SELECT @adlp_id,@claim_procedure_id, @claim_procedure_external_edit_id, null, null, @edit_code, @set_to_deny,@reportdate, 0,null                
            END
            --ELSE
            --BEGIN

            --    INSERT INTO [dbo].[adjudication_procedure_line_deny_log](
            --   [adjudication_procedure_line_deny_id],[claim_procedure_id],[claim_procedure_external_edit_id],[edit_code],[denied],[log_date])
            --    VALUES(@adlp_id,@claim_procedure_id, @claim_procedure_external_edit_id, @edit_code,@set_to_deny,@reportdate)          

            --END    
          --  select * from [dbo].[adjudication_procedure_line_deny_log] order by adjudication_procedure_line_deny_log_id desc
          
        RETURN @return_status;

    END TRY
    BEGIN CATCH

        SET @tc_error_message = ERROR_MESSAGE();

        INSERT INTO [dbo].[adjudication_procedure_line_deny_log]( claim_procedure_id,is_error, error_message, log_date)
         VALUES(@claim_procedure_id, 1,@tc_error_message, GETDATE())
        --UPDATE [dbo].[adjudication_procedure_line_deny_log]
        --SET [is_error] = 1,
        --    [error_message] = @tc_error_message
        --WHERE [adjudication_procedure_line_deny_log_id] = @adjudication_procedure_deny_log_id;


		--still raise error to catch in adjudication
		RAISERROR(@tc_error_message, 15,1)


        RETURN 1; --	Execution aborts if throw is executed in a catch statement so this return is here just for show.  The return value will actually be NULL, which is not 0, so NULL = failure.

    END CATCH;
END;

IF @revision_number > 0 OR ISNULL(@newborn_processing_flag, 0) = 1     
        BEGIN
            SET @set_to_deny = 'False';
            SET @UB9_edits_exist = 0;
        END;
        ELSE
        BEGIN
            IF EXISTS( SELECT  1
            FROM [dbo].[claim_procedure_external_edit] AS [cpee]
            WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
                  AND [cpee].[deny_service_line] = 1
                  AND [cpee].[deleted] = 0)
            BEGIN
                --is there an edit for this procedure line and is it set to deny
                --gather edit code in case this is specific to edit
                SELECT TOP 1
                       @set_to_deny = 'True',
                       @edit_code = [cpee].[edit_code],
                       @claim_procedure_external_edit_id = [cpee].[claim_procedure_external_edit_id]
                FROM [dbo].[claim_procedure_external_edit] AS [cpee]
                WHERE [cpee].[claim_procedure_id] = @claim_procedure_id
                      AND [cpee].[deny_service_line] = 1
                      AND [cpee].[deleted] = 0;
            END
         -- Check claim type for UB9
            ELSE IF (@claim_type_id = 3) AND (@set_to_deny = 'False')-- Institutional claims US 46447
            BEGIN
                SELECT TOP 1
				       @set_to_deny = 'True',
				      -- @edit_code = [cpee].[edit_code],
                       @UB9_edits_exist = 1 -- 46447 set flag to do UB9 service line updates
			    FROM [dbo].[claim_ub92_service_external_edit] AS [cpee]
                 INNER JOIN [dbo].[claim_ub92_service] AS [ubs]
                                ON [ubs].[claim_ub92_service_id] = [cpee].[claim_ub92_service_id]
                 INNER JOIN [dbo].[claim_procedure] AS [cp]
                        ON [cp].[claim_procedure_id] = [ubs].[claim_procedure_id]
			    WHERE [ubs].[claim_procedure_id] = @claim_procedure_id
                      AND [cpee].deny_service_line = 1
				      and cpee.deleted = 0

     -- SELECT  @UB9_edits_exist UB9_edits_exist

            END -- @claim_type_id = 3

        END;

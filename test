SELECT  @revision_number = [c].[revision_number],
                @claim_id=[c].claim_id
        FROM [claim] [c]
            INNER JOIN [claim_procedure] [cp]
                ON [cp].[claim_id] = [c].[claim_id]
        WHERE [cp].[claim_procedure_id] = @claim_procedure_id;

        IF EXISTS 
        (
        SELECT 1 FROM 
            claim c  (NOLOCK) 
            LEFT JOIN claim_processing_flag cpf  (NOLOCK) ON c.claim_processing_flag_id = cpf.claim_processing_flag_id
        WHERE 
            c.claim_id = @claim_id 
            AND cpf.name = 'NEWBORN'
        )

        BEGIN
            
        SET @newborn_processing_flag = 1	
            
        END	

        IF @revision_number > 0 OR ISNULL(@newborn_processing_flag, 0) = 1  
          BEGIN
           --46714 Commenting out the code and setting the set_to_deny flag to false
            SET @set_to_deny = 'False';
            SET @UB9_edits_exist = 0;

            END

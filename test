SELECT 
    check_run_id,
    voucher_id,
    doc_type,
    doc_id,
    remark,
    COUNT(line_number)                     AS line_count,
    LEN('Line') + (COUNT(line_number) * 6) 
        + LEN(remark) + 2                  AS estimated_total_length
FROM check_run_redcard_remark
WHERE deleted = 0
GROUP BY check_run_id, voucher_id, doc_type, doc_id, remark
HAVING LEN('Line') + (COUNT(line_number) * 6) + LEN(remark) + 2 > 1200
ORDER BY estimated_total_length DESC



BEGIN CATCH

    SET @error_message = 'A database error occurred:'
        + CHAR(13) + CHAR(10)
        + 'Procedure Name: ' + '[dbo].[group_holdover_sav]'
        + CHAR(13) + CHAR(10)
        + 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR(30))
        + CHAR(13) + CHAR(10)
        + 'Error Description: ' + ERROR_MESSAGE()
        + CHAR(13) + CHAR(10)
        + 'User: ' + SUSER_SNAME()



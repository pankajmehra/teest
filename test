				exec dbo.x12_error_message
								@x12_file_id = @x12_file_id,
								@x12_interchange_id = @x12_interchange_id,
								@x12_functional_group_id = @x12_functional_group_id,
								@x12_transaction_id = @x12_transaction_id,
								@x12_record_id = @x12_837_2300_id,
								@x12_record_table = 'x12_837_2300',
								@message_text = @errmsg

				-- mark the claim as an error if it isn't already
				update dbo.x12_837_2300 set error = 1
				where x12_837_2300_id = @x12_837_2300_id
					and error = 0

				return 1

			end catch

			if @return = 1
			begin
				set @errmsg = 'An error was encountered while parsing x12_837_2300_id = [' + isnull(convert(varchar,@x12_837_2300_id),'null') + '].  ' + DB_NAME() + '.' + OBJECT_NAME(@@PROCID) + '.'
				exec dbo.x12_error_message
								@x12_file_id = @x12_file_id,
								@x12_interchange_id = @x12_interchange_id,
								@x12_functional_group_id = @x12_functional_group_id,
								@x12_transaction_id = @x12_transaction_id,
								@x12_record_id = @x12_837_2300_id,
								@x12_record_table = 'x12_837_2300',
								@message_text = @errmsg

				-- mark the claim as an error if it isn't already
				update dbo.x12_837_2300 set error = 1
				where x12_837_2300_id = @x12_837_2300_id
					and error = 0

				return 1

			end
		end

		if (@is_transactional = 0)
			goto NEXT_CLAIM
	end

	--------------------------------------------------
	--  File Imported
	--------------------------------------------------
	if exists (
		-- we have at least one processed claim
		select 1
		from dbo.x12_file f 
			inner join dbo.x12_interchange i  on f.x12_file_id = i.x12_file_id
			inner join dbo.x12_functional_group g  on g.x12_interchange_id = i.x12_interchange_id
			inner join dbo.x12_transaction t  on t.x12_functional_group_id = g.x12_functional_group_id
			inner join dbo.x12_837_2300 c  on t.x12_transaction_id = c.x12_transaction_id
		where 
			f.x12_file_id = @p_x12_file_id
			and c.processed = 1	)
	and not exists (
		-- we have no claims that are un-processed
		select 1
		from dbo.x12_file f 
			inner join dbo.x12_interchange i  on f.x12_file_id = i.x12_file_id
			inner join dbo.x12_functional_group g  on g.x12_interchange_id = i.x12_interchange_id
			inner join dbo.x12_transaction t  on t.x12_functional_group_id = g.x12_functional_group_id
			inner join dbo.x12_837_2300 c  on t.x12_transaction_id = c.x12_transaction_id
		where 
			f.x12_file_id = @p_x12_file_id
			and c.processed = 0	)
	begin
		update dbo.x12_file set is_imported = 1
		where x12_file_id = @p_x12_file_id
	end

	/*
		US 40374
		Adding logic to copy the prof/inst conduent inbound file to the data/done directory
	*/
	--need to validate trading_partner and trading_partner_file_types
	if @trading_partner_id in (747,748) and @trading_partner_file_type_id in (4357,4358,4360,4361) --conduent and conduent test
	begin
		select @inbound_file_id = x.inbound_file_id
		from dbo.x12_file x
		where x.x12_file_id = @p_x12_file_id

		exec dbo.wf_con_90_copy_files @inbound_file_id
								,	  @trading_partner_id
								,	  @trading_partner_file_type_id
	end

	insert into application_log (
			application_type_id
		,	program_step
		,	program_data
		,	stack_trace
		,	instance_id
		,	is_error
		,	error_message	
		,	trading_partner_id)
	values (
			7
		,	'wf_ib_21_837_import - Completed.'
		,	@program_data
		,	null
		,	@instance_id
		,	0
		,	@error_message	
		,	null ) --@p_trading_partner_id)

	return (0)
end

                                           END,
                        [cPayment] = CASE
                                         WHEN @ccx_IsReversal = 1 THEN
                                             CAST(CONVERT(MONEY, [cPayment]) * -1 AS VARCHAR)
                                         ELSE
                                             '0.00'
                                     END,

                --			 cRARC				   + @tab +
                --			 cCARCGroupCode		   + @tab +
                --			 cOpenField4		   + @tab +
                --			 cOpenField5		   + @tab +
                --			 cClaimNumber		   + @tab +
                --			 cQuantity
                --	    FROM @Overpayment_ClaimAdjustment)

                --	-- Save record to check run batch
                --	EXEC @return_status = [dbo].[check_run_record_insert_redcard] @check_run_id, @line_number OUTPUT, @record, 1, @user_id;


                --END

                -- Process next Claim
                SET @recId = @recId + 1;

            END; -- WHILE @recId <= @total_count

        END; -- @vendor_tax_id = 'CCX'

    END TRY

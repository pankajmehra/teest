				------------------------------
				--	NSA Claim  --PL 4/14/2022
				------------------------------	
				begin
					exec [dbo].[wf_ib_2170_nsa]
							@x12_837_2300_id			= @x12_837_2300_id
						,@inbound_file_id			= @inbound_file_id
						,@claim_id					= @claim_id
						,@repricing_claim_type_id	= @repricing_claim_type_id
						,@qpa_type					= @qpa_type
						,@claim_is_par              = @claim_is_par
						--,@debug int = 0				-- this for debug select all variable tables from the SP
				end		
			else
				if @QPA_repricing_claim_history_id is not null	--@QPA_repricing_claim_history_id is the var that points to the logged QPA amounts that we need to update iiiPUT with.
				begin
					--For single hop situations, we may not need this.
					--For muiltiple hop situations we will need to reset these vars to the values of the first hop
					--Using @QPA_repricing_claim_history_id (set in network_router_inbound_EDEE_logic) to look up these values
					declare @x12_837_2300_id_hop1 int, @inbound_file_id_hop1 int, @repricing_claim_type_id_hop1 int, @claim_is_par_hop1 bit
					
					--JRO 9/18/2023 split the logic for when the current claim has the QPA amounts vs perviously loaded claim (US 24279)
					--@QPA_repricing_claim_history_id is set in SP network_router_inbound_EDEE_logic and holds the record the applied QPA amounts are comming from
					--if @QPA_repricing_claim_history_id = @repricing_claim_history_id, then the applied QPA amounts are commng from the current load and we need use vars (table repricing_claim_history isn't updated yet)
					--if @QPA_repricing_claim_history_id<> @repricing_claim_history_id, then the applied QPA amounts are commng from table repricing_claim_history (from a previous load)
					IF @QPA_repricing_claim_history_id = @repricing_claim_history_id
					begin
						set @x12_837_2300_id_hop1			= @x12_837_2300_id
						set @inbound_file_id_hop1			= @inbound_file_id
						set @repricing_claim_type_id_hop1	= @repricing_claim_type_id
						set @claim_is_par_hop1				= @claim_is_par
					end
					else
					begin
					select	top 1 
							@x12_837_2300_id_hop1		= h.x12_837_2300_id,
							@inbound_file_id_hop1		= h.inbound_file_id,
							@repricing_claim_type_id_hop1	= @repricing_claim_type_id,						--2=HCFA, 3 = UB
							@claim_is_par_hop1			= h.is_par

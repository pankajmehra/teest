	/*----------------------------------------------------------------------------------------------

		Multiplan/NCN performs 5 different kinds of pricing for WebTPA we call "repricing methodologies".
		Payment Integrity performs a 6th kind of processing called post-adjudication validation.
		
			Default		Traditional Network Pricing (PHCS)
			MLR			Medicare Like Repricing
			MR			Medicare Repricing
			WSR			WaterStone Repricing
			NCN			NCN Repricing
			PI			Payment Integrity post adjudication validation
	
		The rules for Payment Integrity post-adjudication processing are below. The rules for
		Multiplan repricing are just above this code.
		There are three scenario categories returned on the 837 file:

		1.	If a Payment Integrity claim is submitted with pricing information on the HCP Segment, and is not
			eligible to route to the Payment Integrity claim review process due to valid reasons such as threshold
			limitations.

			2300*HCP*04 = 54
			2300*NTE*02 = CPC

			2400*HCP*04 = 54
			2400*NTE segment will not be populated

		2.	If a Payment Integrity claim is submitted without pricing information (No HCP segment) and is not
			eligible to route to the Payment Integrity claim review process.

			2300*HCP*04 = 57
			2300*NTE*02 = 51

			2400*HCP*04 = 57
			2400*NTE segment will not be populated

		3.	If a Payment Integrity claim is submitted (with or without pricing information), and is eligible to
			route to the Payment Integrity claim review process.

			2300*HCP*04 = 290
			2300*NTE*02 = CR0		Pay claim

			2300*HCP*04 = 290
			+ one of these:			
			2300*NTE*02 = CR1		Deny whole claim (notes will be in supplemental file)
			2300*NTE*02 = CR2		Deny one or more lines(notes will be in supplemental file)
			2300*NTE*02 = CR3		Suspect claim (notes were not always in supplemental file during testing)
			+ zero or more of these:
			2400*HCP*04 = 290		Deny line
			2400*NTE*02 = LAF1		Deny line

	----------------------------------------------------------------------------------------------*/
	if @trading_partner_id = 24		--	Multiplan - Reprice In
		and @inbound_trading_partner_file_type_id in (1453,1454)			--	Multiplan/Payment Integrity
	begin

		--	These two trading partner file types are only for Multiplan/Payment Integrity pricing
		set @inbound_repricing_methodology_id = @PI_pricing

		---------------------------------
		--	We must have the methodology under which we sent the claim
		---------------------------------
		if @outbound_repricing_methodology_id is null
		begin
			set @send_to_review_queue = 1
			select @comment = 'EDI: The Multiplan/Payment Integrity outbound pricing methodology is missing from this claim.  Please send to iii:PUT issues for research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		if @outbound_repricing_methodology_id not in ( @PI_pricing )
		begin
			set @send_to_review_queue = 1
			select @comment = 'EDI: The Multiplan/Payment Integrity outbound pricing methodology on the claim is invalid for Multiplan/Payment Integrity.  Please send to iii:PUT issues for research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end


		---------------------------------
		--	Multiplan/Payment Integrity Global Rules
		---------------------------------
		--	Note that par/non-par has not meaning for Payment Inegrity processing...just here to provide a value for the repricing_configuration table.
		set @claim_is_par = 1

		--	00 Zero Pricing (Not Covered Under Contract)
		if @L2300_hcp01_pricing_methodology = '00'
			set @claim_is_par = 0

		--	These require intervention (usually correction and resubmit for pricing).
		if @L2300_hcp13_reject_reason_code in ('T1','T6')
		begin
			set @claim_is_par = 0

			set @send_to_review_queue = 1
			select @comment = 'EDI: The Multiplan/Payment Integrity  repricer reject code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '] indicates the claim is missing information that prevents repricing.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Multiplan only sends HCP13 as blank, T1, or T6 so something has gone wrong here.
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The Multiplan/Payment Integrity non-par indicator/reject code at the claim level is an invalid code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Multiplan only sends HCP01 as 00, 10, or 14 so something has gone wrong here.
		if isnull(@L2300_hcp01_pricing_methodology,'') not in ( '00','01','10','14' )
		begin
			set @claim_is_par = 0

			set @send_to_review_queue = 1
			select @comment = 'EDI: The Multiplan/Payment Integrity pricing methodology at the claim level is an invalid code [' + isnull(@L2300_hcp01_pricing_methodology,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Multiplan always sends either T1 or T6 with HCP01 00 so if we find something else we have missed our agreed upon handshake.
		if @L2300_hcp01_pricing_methodology = '00' and isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0

			set @send_to_review_queue = 1
			select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid pricing methodology [00] and reject reason code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '] combination.  We expect 00 with T1 or T6.  Please send to iii:PUT issues for research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		-------------------------------------------
		--	Grab the repricing organization ID
		-------------------------------------------
		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier		--	Don't use line level...there MUST be a claim level network ID for this implementation

		--	Multiplan/Payer Integrity always sends one of these network ID values: 54, 57, 290
		if @repriced_organization_identifier is null or @repriced_organization_identifier not in ( '54', '57', '290' )
		begin
			set @send_to_review_queue = 1
			select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid pricing network ID [' + isnull(@repriced_organization_identifier,'') + '].  We only expect 54, 57, or 290.  Please send to iii:PUT issues for research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		----------------------------------------
		--	These are not repriced claims so leave the claim repricing flag at it's current value.
		----------------------------------------
		set @claim_repricing_flag_id = null	

		select @claim_repricing_flag_id = c.claim_repricing_flag_id
		from mcr_dc_prod.dbo.claim c
		where c.claim_id = @claim_id



				set @review_workflow_id = 153304			--	MR Repricing Review
				select @comment = 'EDI: MR has sent an unknown pricing methodology and reject reason code combination.  We expect 00 with T1.  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
			end		
			
			--	We have to assume NCN was unable to price the MR claim at this point		
			if isnull(@claim_repricing_flag_id,0) not in ( 1,258 )
			begin
				set @claim_is_par = 0
				set @claim_repricing_flag_id = 1			-- Standard NON-PAR flag
				
				set @send_to_review_queue = 1
				set @review_workflow_id = 153304			--	MR Repricing Review
				select @comment = 'EDI: MR failed to price this claim or the EDI engine could not determine the claim repricing flag.  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
			end	
								
		end		
		
		
		----------------------------
		--	WSR pricing (vs NCN)
		----------------------------
		if @is_NCN_WSR_pricing = 1 or @repriced_organization_identifier in ( 'MRD','MRN' )		--	WSR Only (NCN is up above)
		begin
		
			--	Priced as Waterstone Repricing
			if @repriced_organization_identifier in ( 'MRD','MRN' )
			begin
				set @inbound_repricing_methodology_id = @WSR_pricing

				if @L2300_hcp01_pricing_methodology = '00'		-- unable to price
				begin
					set @claim_is_par = 0
					--set @claim_repricing_flag_id = 1			-- Standard NON-PAR flag
					set @claim_repricing_flag_id = 149			-- NCN - UNABLE TO PRICE NON-PAR flag
					
					set @send_to_review_queue = 1
					set @review_workflow_id = 210019			--	WSR Repricing Review
					select @comment = 'EDI: WSR is unable to price this claim.  Please research.'
					insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
					
				end

				if @L2300_hcp01_pricing_methodology in ( '01','10' )			
				begin
					set @claim_is_par = 1
					if @repriced_organization_identifier = 'MRD'
						set @claim_repricing_flag_id = 314		--	NCN - MRD WATERSTONE
					if @repriced_organization_identifier = 'MRN'
						set @claim_repricing_flag_id = 315		--	NCN - MRN WATERSTONE						
				end		
			end	
			--	Only the MR pricing flag is valid for claims we sent for MR pricing or claims that were returned as MR priced.
			else
			begin
				set @claim_is_par = 0
				set @claim_repricing_flag_id = 149			-- NCN - UNABLE TO PRICE NON-PAR flag
				
				set @send_to_review_queue = 1
				set @review_workflow_id = 210019			--	WSR Repricing Review
				select @comment = 'EDI: WSR sent us an unknown repricing organization identifier.  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
			end

			--	If NCN sent a reject reason code this should be non-par (and also have hcp01 = 00)
			if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1' )
			begin
				set @claim_is_par = 0
				set @claim_repricing_flag_id = 149			-- NCN - UNABLE TO PRICE NON-PAR flag				
				
				set @send_to_review_queue = 1
				set @review_workflow_id = 210019			--	WSR Repricing Review
				select @comment = 'EDI: WSR has sent an unknown reject reason code.  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
			end
			
			--	Non-par NCN claims must have a pricing methodology of '00' and reject reason code 'T1'
			if @L2300_hcp01_pricing_methodology = '00' and isnull(@L2300_hcp13_reject_reason_code,'') <> 'T1'
			begin
				set @claim_is_par = 0
				set @claim_repricing_flag_id = 149			-- NCN - UNABLE TO PRICE NON-PAR flag
				
				set @send_to_review_queue = 1
				set @review_workflow_id = 210019			--	WSR Repricing Review
				select @comment = 'EDI: WSR has sent an unknown pricing methodology and reject reason code combination.  We expect 00 with T1.  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
			end		
			
			--	We have to assume NCN was unable to price the WSR claim at this point		
			if isnull(@claim_repricing_flag_id,0) not in ( 149,314,315 )
			begin
				set @claim_is_par = 0
				set @claim_repricing_flag_id = 149			-- NCN - UNABLE TO PRICE NON-PAR flag
				
				set @send_to_review_queue = 1
				set @review_workflow_id = 210019			--	WSR Repricing Review
				select @comment = 'EDI: WSR failed to price this claim or the EDI engine could not determine the claim repricing flag.  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
			end	
								
		end			
		
		---------------------------------------------------------------
		--	If the MLR employergroup should be sent to review and isn't
		--	already set to go there do it now.
		---------------------------------------------------------------
		if (@is_NCN_MLR_pricing = 1 or @repriced_organization_identifier = 'MLR')
			and @send_to_review_queue = 0
		begin
			if exists (
				select 1
				from dbo.repricing_employergroup_MLR_map m 
				where m.employergroup_id = @employergroup_id
					and m.repricing_configuration_id = @repricing_configuration_id
					and m.send_to_review_queue = 1
					and m.deleted = 0	)
			begin
				--	send this claim to the NCN MLR review queue (Not the NCN review queue)
				set @send_to_review_queue = 1
				set @review_workflow_id = 130543		--	MLR Repricing Review
				set @comment = 'EDI: This new MLR employer group is tagged to be sent to the MLR repricing review queue.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment,99)			
			end
		end	
		
		---------------------------------------------------------------
		--	If the MR employergroup should be sent to review and isn't
		--	already set to go there do it now.
		---------------------------------------------------------------
		if (@is_NCN_MR_pricing = 1 or @repriced_organization_identifier = 'MR')
			and @send_to_review_queue = 0
		begin
			if exists (
				select 1
				from dbo.repricing_employergroup_MR_map m 
				where m.employergroup_id = @employergroup_id
					and m.repricing_configuration_id = @repricing_configuration_id
					and m.send_to_review_queue = 1
					and m.deleted = 0	)
			begin
				--	send this claim to the NCN MLR review queue (Not the NCN review queue)
				set @send_to_review_queue = 1
				set @review_workflow_id = 153304			--	MR Repricing Review
				set @comment = 'EDI: This new MR employer group is tagged to be sent to the MR repricing review queue.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment,99)			
			end
		end		
		
		---------------------------------------------------------------
		--	If the WSR employergroup should be sent to review and isn't
		--	already set to go there do it now.
		---------------------------------------------------------------
		if (@is_NCN_WSR_pricing = 1 or @repriced_organization_identifier in ( 'MRD','MRN' ))
			--and @send_to_review_queue = 0		This is really an NCN queue but we want a special review queue for these
		begin
			if exists (
				select 1
				from dbo.repricing_employergroup_WSR_map m 
				where m.employergroup_id = @employergroup_id
					and m.repricing_configuration_id = @repricing_configuration_id
					and m.deleted = 0	)
			begin
				--	send this claim to the NCN WSR review queue (Not the NCN review queue)
				set @send_to_review_queue = 1
				set @review_workflow_id = 210019			--	WSR Repricing Review
				set @comment = 'EDI: This new WSR employer group is tagged to be sent to the WSR repricing review queue.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment,99)			
			end
			
			--	If we sent the claim out for WSR pricing or it came back WSR pricing don't let it go to the normal NCN review queue
			if @send_to_review_queue = 1
				set @return_to_oon_complete_queue = 0
		end					

	end
		
	
	-----------------------------------
	--	Aetna : The claim repricing flag must be taken from a different location.  
	--	The HCP04 contains the Aetna ASA Pin and Pin Suffix for the provider that Aetna matched in their provider database.
	--	Network Name and ID for determing the claim repricing flag are taken from 
	--	the outbound 837 in either Loop ID 2310B for Professional and Dental or Loop ID 2310A for Institutional claims.
	--	Note, the Aetna ID is a 5-digit number and the Name has a maximum of 25 characters.
	--
	--	TODO:	Find a way to validate this HCP04 returned PIN against our Aetna provider listing and send mis-matches to review.	
	-----------------------------------

	if @trading_partner_id = 99		--	Aetna
	begin
	
		declare @L2300_nte02_claim_note_text varchar(80)	--32586 JRO
		set @L2300_nte02_claim_note_text = NULL				--32586 JRO

		set @claim_repricing_flag_id = null		
		set @repriced_organization_identifier = null
		set @repriced_organization_name = null

		set @claim_is_par = 1
		
		
		--	00 Zero Pricing (Not Covered Under Contract)
		if @L2300_hcp01_pricing_methodology = '00'
			set @claim_is_par = 0
		
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0
		
		--	T6 Claim does not have enough information for pricing
		if @L2300_hcp13_reject_reason_code = 'T6'
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level indicates we did not send enough information to price the claim: @L2300_hcp13_reject_reason_code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end			
		
		--	All reject codes except T1 go to the review queue
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		

		--	Network ID : 5010 Aetna moved the Network ID to the 2300 HCP segment so look for it there.
		if @gs08_version_id_code like '005010X%'
		begin
			
			select @repriced_organization_identifier = c.L2300_hcp04_repriced_organization_identifier
			from dbo.x12_837_2300 c
			where x12_837_2300_id = @x12_837_2300_id
			
			select top 1 @L2300_nte02_claim_note_text = nte.L2300_nte02_claim_note_text		--32586 JRO
			from dbo.x12_837_2300_NTE nte													--32586 JRO
			where nte.x12_837_2300_id = @x12_837_2300_id									--32586 JRO

			--	Verify we have the network id
			if @repriced_organization_identifier is null
			begin
				set @claim_is_par = 0
				set @claim_repricing_flag_id = 1				-- Default Non-Par flag
				
				--	Aetna is always supposed to send the network id here.
				set @send_to_review_queue = 1
				select @comment = 'EDI: The repricing network indicator is missing or invalid in the repriced claim data element 2310B REF N5 [' + ISNULL(@repriced_organization_identifier,'null') + '].'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end	
			
			--	Aetna 5010 network IDs are always 10 digits followed by the network name, just look for the 10 digits in our table.
			if @repriced_organization_identifier is not null and @claim_repricing_flag_id is null
			begin

				-----------------------------------------------------------
				--	Grab the repricing flag using TPFT first
				-----------------------------------------------------------
				select 
					@claim_repricing_flag_id = claim_repricing_flag_id
				,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.

				--	As we convert Aetna contracts to using external edits...change the specific repricing flag map to use the generic 448	ASA MEDICAL and add the stuff below as external edits.
				--	After we load the service lines below, add the claim level network EOB message to all the service lines.
				,	@claim_pricer_network_name = m.pricer_network_name
				,	@claim_pricer_description_short = m.pricer_description_short
				,	@claim_pricer_description_long = m.pricer_description_long
				,	@claim_pricer_recommended_action = m.pricer_recommended_action
				,	@claim_era_adjustment_group = m.era_adjustment_group
				,	@claim_era_adjustment_reason_code = m.era_adjustment_reason_code
				,	@claim_era_remark_code = m.era_remark_code
				,	@claim_is_overridable = m.is_overridable
				,	@claim_print_on_eop = m.print_on_eop
				,	@claim_pend_service_line = m.pend_service_line

				from dbo.claim_repricing_flag_organization_map m
				where m.organization_identifier = left(@repriced_organization_identifier,9)
					and m.provider_is_participating = @claim_is_par
					and m.trading_partner_id = @trading_partner_id
					and m.trading_partner_file_type_id = @inbound_trading_partner_file_type_id

			end						

			if @repriced_organization_identifier is not null and @claim_repricing_flag_id is null
			begin

				-----------------------------------------------------------
				--	Grab the repricing flag without TPFT
				-----------------------------------------------------------
				select 
					@claim_repricing_flag_id = claim_repricing_flag_id
				,	@route_to_claim_workflow_id = isnull(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.

				--	As we convert Aetna contracts to using external edits...change the specific repricing flag map to use the generic 448	ASA MEDICAL and add the stuff below as external edits.
				--	After we load the service lines below, add the claim level network EOB message to all the service lines.
				,	@claim_pricer_network_name = m.pricer_network_name
				,	@claim_pricer_description_short = m.pricer_description_short
				,	@claim_pricer_description_long = m.pricer_description_long
				,	@claim_pricer_recommended_action = m.pricer_recommended_action
				,	@claim_era_adjustment_group = m.era_adjustment_group
				,	@claim_era_adjustment_reason_code = m.era_adjustment_reason_code
				,	@claim_era_remark_code = m.era_remark_code
				,	@claim_is_overridable = m.is_overridable
				,	@claim_print_on_eop = m.print_on_eop
				,	@claim_pend_service_line = m.pend_service_line

				from dbo.claim_repricing_flag_organization_map m
				where m.organization_identifier = left(@repriced_organization_identifier,9)
					and m.provider_is_participating = @claim_is_par
					and m.trading_partner_id = @trading_partner_id
					and m.trading_partner_file_type_id is null

			end						

			--32586 start JRO
			--For L2300_nte02_claim_note_text = '16QPA'
			--we did not update claim_repricing_flag_organization_map.organization_identifier from '16QPA' to '0000000000'
			--because '0000000000' is not unique and would match the TP only (above lookup) and thats not what we want to happen.
			--Leaving this column value = '16QPA' will allow the all claim data where HCP04 = '0000000000' and L2300_nte02_claim_note_text <> '16QPA' to work as previouly
			if @repriced_organization_identifier in ('000000000','QPAAPPLIED','QPAPOTENTIAL') and @L2300_nte02_claim_note_text in ('16QPA', '45QPA','45QPAP')
			begin
				-----------------------------------------------------------
				--	Grab the repricing flag without TPFT and with @L2300_nte02_claim_note_text
				-----------------------------------------------------------
				select 
					@claim_repricing_flag_id = claim_repricing_flag_id
				,	@route_to_claim_workflow_id = isnull(@route_to_claim_workflow_id, route_to_claim_workflow_id)
				,	@claim_pricer_network_name = m.pricer_network_name
				,	@claim_pricer_description_short = m.pricer_description_short
				,	@claim_pricer_description_long = m.pricer_description_long
				,	@claim_pricer_recommended_action = m.pricer_recommended_action
				,	@claim_era_adjustment_group = m.era_adjustment_group
				,	@claim_era_adjustment_reason_code = m.era_adjustment_reason_code
				,	@claim_era_remark_code = m.era_remark_code
				,	@claim_is_overridable = m.is_overridable
				,	@claim_print_on_eop = m.print_on_eop
				,	@claim_pend_service_line = m.pend_service_line
				from dbo.claim_repricing_flag_organization_map m
				where m.organization_identifier = @L2300_nte02_claim_note_text		--for these 3 codes only the @L2300_nte02_claim_note_text will natch m.organization_identifier
					and m.nte02_claim_note_text = @L2300_nte02_claim_note_text
					and m.provider_is_participating = @claim_is_par
					and m.trading_partner_id = @trading_partner_id
					and m.trading_partner_file_type_id is null

				--for this condition, flip the par clami to non-par and continue
				if @repriced_organization_identifier = 'QPAPOTENTIAL' and @L2300_nte02_claim_note_text = '45QPAP' and @claim_is_par = 1
					set @claim_is_par = 0

			end	--32586 end

			--23899 create procedure for external edit 
			if  @claim_repricing_flag_id = 448  --ASA MEDICIAL
			begin	
				select top 1 @claim_procedure_id = cp.claim_procedure_id
				from mcr_dc_prod.dbo.claim_procedure cp
				where cp.claim_id = @claim_id
				order by cp.claim_procedure_id
			end

		end
				
		
		if @claim_repricing_flag_id is null and @claim_is_par = 0
			set @claim_repricing_flag_id = 1				-- Default Non-Par flag
		
		if @claim_repricing_flag_id is null and @claim_is_par = 1
		begin
			set @claim_is_par = 0
			set @claim_repricing_flag_id = 1				-- Default Non-Par flag
			
			--	Aetna sent a new or unknown network id.
			set @send_to_review_queue = 1
			set @comment = 'EDI: A PAR claim repricing flag could not be found in the claim_repricing_flag_organization_map lookup table for organization id [' + @repriced_organization_identifier + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

	end		
	
	-----------------------------------
	--	HACK : Some Non-Par Multiplan (57) repriced claims need to have the PHCS non-par repricing flag
	-----------------------------------
	if @claim_is_par = 0 and @repriced_organization_identifier = '57'
	begin
		if exists (
			select 1
			from dbo.x12_837_2300 c 
				inner join dbo.x12_837_2010BX b  on b.x12_837_2000B_id = c.x12_837_2000B_id
				inner join dbo.x12_837_2010BX_REF br  on b.x12_837_2010BX_id = br.x12_837_2010BX_id
			where c.x12_837_2300_id = @x12_837_2300_id
				and br.L2000BX_ref01_code = 'IG'
				and br.L2000BX_ref02_reference in ('MCC PPO','MCC HD')	)
		begin
			set @claim_repricing_flag_id = 20	-- PHCS Non-Par
		end
	end
	
	
	-----------------------------------
	--	First Health Coventry has more complex rules
	--	for determining the repricing flag and par/non-par.
	-----------------------------------
	if @trading_partner_id = 224		--	First Health Coventry
	begin
	
		set @claim_repricing_flag_id = null		
		set @repriced_organization_identifier = null

		set @claim_is_par = 1
		
		--	00 Zero Pricing (Not Covered Under Contract)
		if @L2300_hcp01_pricing_methodology = '00'
			set @claim_is_par = 0
		
		--	T6 Claim does not have enough information for pricing
		if @L2300_hcp13_reject_reason_code = 'T6'
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level indicates we did not send enough information to price the claim: @L2300_hcp13_reject_reason_code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end			
		
		--	All reject codes go to the review queue for First Health Coventry
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		
		select @repriced_organization_identifier = c.L2300_hcp04_repriced_organization_identifier
		from dbo.x12_837_2300 c
		where x12_837_2300_id = @x12_837_2300_id
		
		--	Verify we have the network id
		if @repriced_organization_identifier is null or @repriced_organization_identifier <> '201736437'
		begin
			set @claim_is_par = 0
			set @claim_repricing_flag_id = 1				-- Default Non-Par flag
			
			--	First Health Coventry is always supposed to send the network id here.
			set @send_to_review_queue = 1
			select @comment = 'EDI: The repricing network indicator is missing or invalid in the repriced claim data element 2300 HCP 04 [' + ISNULL(@repriced_organization_identifier,'null') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end	
		

		--	We need another field to determine the @claim_repricing_flag_id
		if @repriced_organization_identifier = '201736437' and @claim_is_par = 1
		begin

			--	Default to "FIRST HEALTH (CCN)" flag then see if we need to override
			set @claim_repricing_flag_id = 31		--	FIRST HEALTH (CCN)


			--	If we sent the claim over with this Firsth Health Coventry group code (acronym) MS4
			--		then it must use the FIRST HEALTH SHANNON TRAV DOCS flag  <-- not as of 6/19/2012
			--	otherwise use the FIRST HEALTH (CCN) flag.
			if exists (
				select 1
				from dbo.x12_837_2300 c 
					inner join dbo.x12_837_2010BX p  on p.x12_837_2000B_id = c.x12_837_2000B_id
					inner join dbo.x12_837_2010BX_REF r  on p.x12_837_2010BX_id = r.x12_837_2010BX_id
						and r.L2000BX_ref01_code = 'FY'
						and r.L2000BX_ref02_reference = 'MS4' --	SHANNON MEDICAL CENTER
				where c.x12_837_2300_id = @x12_837_2300_id	)						
			begin
				set @send_to_review_queue = 1
				set @comment = 'EDI: Review traveling Shannon doctors network to determine the pricing flag.'
			end

			--	12/31/2018	The Cofinity engine now operated by First Health uses it's own rule.
			if @repricing_configuration_id in (86,87)
			begin
				set @claim_repricing_flag_id = 416	--	COFINITY EDI RT
			end

		end		
		

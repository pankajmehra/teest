			,	@line_pend_service_line = null
			,	@line_print_on_eop = null
			
			--	we only bother with all the line level stuff if we found claim level pricing information
			if @claim_level_pricing_found = 1
			begin					
									
				------------------------------
				--  Line level par/non-par
				------------------------------
				set @line_is_par = 1
				
				--	00 Zero Pricing (Not Covered Under Contract)
				if @L2400_hcp01_pricing_methodology = '00'
					set @line_is_par = 0
				
				--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant

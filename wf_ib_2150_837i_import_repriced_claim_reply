		begin
			select @pipe1 = null
				,	@pipe2 = null
				,	@pipe3 = null
				,	@pipe4 = null
				,	@pipe5 = null
				,	@pipe6 = null

			select @hcp06_value = L2300_hcp06_repriced_approved_drg_code
			from dbo.x12_837_2300
			where x12_837_2300_id = @x12_837_2300_id

			delete from @hcp06_values
			insert into @hcp06_values
			(hcp06_values_id, pipe_value)
			select ROW_NUMBER() over (order by (select(null))) as hcp_values_id, value
			from string_split(@hcp06_value, '|')

			declare hcp06_cursor cursor for
			select hcp06_values_id, pipe_value
			from @hcp06_values

			open hcp06_cursor
			fetch next from hcp06_cursor into @hcp06_values_id, @hcp06_value

			while @@fetch_status = 0
			begin
				if @hcp06_values_id = 1
					set @pipe1 = @hcp06_value
				if @hcp06_values_id = 2
					set @pipe2 = @hcp06_value
				if @hcp06_values_id = 3
					set @pipe3 = @hcp06_value					
				if @hcp06_values_id = 4
					set @pipe4 = @hcp06_value
				if @hcp06_values_id = 5
					set @pipe5 = @hcp06_value
				if @hcp06_values_id = 6
					set @pipe6 = @hcp06_value
				fetch next from hcp06_cursor into @hcp06_values_id, @hcp06_value

		,	@L2400_hcp13_reject_reason_code = isnull(l.L2400_hcp13_reject_reason_code,'')
		,	@procedurecode_ud = replace(left(L2400_sv202_procedure_code,15),'.','')
		,	@charges = 
				case when isnumeric(L2400_sv203_line_item_charge_amount) = 1 then convert(money,L2400_sv203_line_item_charge_amount)

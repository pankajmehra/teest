			update mcr_dc_prod.dbo.claim set 
				claim_repricing_flag_id = @claim_repricing_flag_id
			,	claim_workflow_id = @claim_workflow_id
			,	hold_until_date = null
			,	claim_processing_flag_id = 
					case 
						when @claim_processing_flag_id > 0 then @claim_processing_flag_id
						when @claim_processing_flag_id = -1 then null
					else claim_processing_flag_id end
			where claim_id = @claim_id

			if @load_revenue_lines = 0
			begin
				select top 1 @claim_procedure_id = claim_procedure_id
				from mcr_dc_prod.dbo.claim_procedure cp
				where claim_id = @claim_id
				order by claim_procedure_id

				update cp set allowed_amount = @claim_allowed_amount
				from mcr_dc_prod.dbo.claim_procedure cp
				where cp.claim_id = @claim_id
					and cp.claim_procedure_id = @claim_procedure_id

				if @remove_allowed_amount = 1
				begin
					--	In some situations, such as sending a claim out for MLR pricing but receiving back as NCN pricing, we will null out the service line allowed amounts (8/5/2015)
					update cp set allowed_amount = null
					from mcr_dc_prod.dbo.claim_procedure cp
					where cp.claim_id = @claim_id
						and cp.claim_procedure_id = @claim_procedure_id
				end
				else
				begin
					--	For "claim level" pricing we'll put the total claim allowed amount on the first line.
					update cp set allowed_amount = @claim_allowed_amount
					from mcr_dc_prod.dbo.claim_procedure cp
					where cp.claim_id = @claim_id
						and cp.claim_procedure_id = @claim_procedure_id
				end								
			end
			else
			begin
				if @remove_allowed_amount = 1
				begin
					--	In some situations, such as sending a claim out for MLR pricing but receiving back as NCN pricing, we will null out the service line allowed amounts (8/5/2015)
					--	update cp set allowed_amount = t.allowed_amount
					update cp set allowed_amount = null
					from mcr_dc_prod.dbo.claim_procedure cp
						inner join @claim_procedure t on cp.claim_procedure_id = t.claim_procedure_id
					where cp.claim_id = @claim_id
				end
				else
				begin
					update cp set allowed_amount = t.allowed_amount
					from mcr_dc_prod.dbo.claim_procedure cp
						inner join @claim_procedure t on cp.claim_procedure_id = t.claim_procedure_id
					where cp.claim_id = @claim_id
				end
			end

			update c set 
				allowed_amount = case
					when @remove_allowed_amount = 1 then null		--	8/5/2015
					else @claim_allowed_amount end
			,	repricing_organization_identifier = @L2300_hcp04_repriced_organization_identifier
			,	reject_reason_code = @L2300_hcp13_reject_reason_code
			,	repricing_method_id = case @L2300_hcp01_pricing_methodology
					when '00' then 1
					when '01' then 2
					when '02' then 3
					when '03' then 4
					when '04' then 5
					when '05' then 6
					when '06' then 7
					when '07' then 8
					when '08' then 9
					when '09' then 10
					when '10' then 11
					when '11' then 12
					when '12' then 13
					when '13' then 14
					when '14' then 15
					when '15' then 16
					when '16' then 17					
					else null end
			from mcr_dc_prod.dbo.claim_ub92 c
			where c.claim_id = @claim_id	
			
		end
		
		------------------------------
		--	Non-PAR Claim
		------------------------------
		if @claim_is_par = 0
		begin
			update mcr_dc_prod.dbo.claim set 
				claim_repricing_flag_id = @claim_repricing_flag_id
			,	claim_workflow_id = @claim_workflow_id
			,	hold_until_date = null
			,	claim_processing_flag_id = 
					case 
						when @claim_processing_flag_id > 0 then @claim_processing_flag_id
						when @claim_processing_flag_id = -1 then null
					else claim_processing_flag_id end		
			where claim_id = @claim_id	
		end

		------------------------------
		--	NSA Claim  --PL 2/2/2022
		------------------------------	
		if @add_to_qpa_list = 1
		begin
			exec [dbo].[wf_ib_2170_nsa]
				 @x12_837_2300_id			= @x12_837_2300_id
				,@inbound_file_id			= @inbound_file_id
				,@claim_id					= @claim_id
				,@repricing_claim_type_id	= @repricing_claim_type_id
				,@qpa_type					= @qpa_type
				,@claim_is_par              = @claim_is_par
				--,@debug int = 0				-- this for debug select all variable tables from the SP
		end	

		-------------------------------------------
		--	Save our Repricing External Edits.
		-------------------------------------------
		if exists (
			select 1
			from @external_edit	)
		begin

			------------------------------
			--	Reset previous attempts if this is a "corrected" record of a previous submission or a rerun of a current submission.
			------------------------------
			--	All external edits for this claim for this vendor.
			delete from e
			from mcr_dc_prod.dbo.claim_procedure cp
				inner join mcr_dc_prod.dbo.claim_procedure_external_edit e on cp.claim_procedure_id = e.claim_procedure_id
			where cp.claim_id = @claim_id
			--	and e.external_vendor_name = 'AMPS MBR'				
				and e.external_vendor_name in (
					select distinct e.vendor_name
					from @external_edit e
				)

			--	Just the external edits for this one electronic claim record...leave any past records alone for history.
			delete from e
			from dbo.repricing_external_edit e
			where e.inbound_file_id = @inbound_file_id
				and e.x12_837_2300_id = @x12_837_2300_id


			------------------------------
			--	Map each external edits to it's service line.
			------------------------------
			update e set e.claim_procedure_id = cp.claim_procedure_id
			from @external_edit e
				inner join @claim_procedure cp on e.x12_837_2400_id = cp.x12_837_2400_id
			where e.claim_procedure_id is null
				and cp.claim_procedure_id is not null

			--	Fall back to the 1st service line only if we have to.  This can happen when we don't load revenue lines for UB claims (which is most of the time).
			if exists (
				select 1
				from @external_edit e
				where e.claim_procedure_id is null	)
			begin
				select top 1 @claim_procedure_id = claim_procedure_id
				from mcr_dc_prod.dbo.claim_procedure cp
				where claim_id = @claim_id
				order by claim_procedure_id

				update e set e.claim_procedure_id = @claim_procedure_id
				from @external_edit e
				where e.claim_procedure_id is null

			end

			--------------------------------
			--	Save our repricing external edit details
			--------------------------------
			insert into repricing_external_edit (
					vendor_name
				,	inbound_file_id
				,	x12_837_2300_id
				,	external_ref_number
				,	claim_id
				,	claim_edit_code
				,	claim_edit_description
				,	claim_network_id
				,	claim_billed_amount
				,	claim_allowed_amount
				,	claim_savings_amount
				,	claim_recommended_action

				,	x12_837_2400_id
				,	line_sequence_number
				,	claim_procedure_id
				,	cpt_or_rev_code
				,	line_edit_code
				,	line_edit_description
				,	line_network_id
				,	line_billed_amount
				,	line_allowed_amount
				,	line_savings_amount
				,	line_recommended_action

				,	is_overridable
				,	era_adjustment_group
				,	era_adjustment_reason_code
				,	era_remark_code
				,   claim_ub92_service_id
			)
			select
					e.vendor_name
				,	e.inbound_file_id
				,	e.x12_837_2300_id
				,	e.external_ref_number
				,	@claim_id
				,	e.claim_edit_code
				,	e.claim_edit_description
				,	e.claim_network_id
				,	e.claim_billed_amount
				,	e.claim_allowed_amount
				,	e.claim_savings_amount
				,	e.claim_recommended_action

				,	e.x12_837_2400_id
				,	e.line_sequence_number
				,	e.claim_procedure_id
				,	e.cpt_or_rev_code
				,	e.line_edit_code
				,	e.line_edit_description
				,	e.line_network_id
				,	e.line_billed_amount
				,	e.line_allowed_amount
				,	e.line_savings_amount
				,	e.line_recommended_action

				,	e.is_overridable
				,	e.era_adjustment_group
				,	e.era_adjustment_reason_code
				,	e.era_remark_code
				,   e.claim_ub92_service_id
			from @external_edit e
			order by e.external_ref_number, e.claim_id, e.claim_procedure_id
					,e.line_sequence_number  --12/17/2021  Phan Lam add line_sequence_numbe for QPA display order


			--------------------------------
			--	Save our adjudication external edit details
			--------------------------------
			insert into mcr_dc_prod.dbo.claim_procedure_external_edit (
					claim_procedure_id
				,	external_vendor_name
				,	recommended_action
				,	pend_service_line
				,	edit_code
				,	edit_description
				,	edit_additional_information
				,	is_overridable
				,	era_adjustment_group
				,	era_adjustment_reason_code
				,	era_remark_code
				)
			select distinct		--	use distinct in case we have to roll multiple "same" edits to the 1st service line
				e.claim_procedure_id
			,	e.vendor_name
			,	isnull(e.line_recommended_action, e.claim_recommended_action)
			,	e.pend_serivce_line
			,	isnull(e.line_edit_code, e.claim_edit_code)
			,	isnull(e.line_edit_description, e.claim_edit_description)
			--12/16/2021 modify for QPA display
			,  coalesce(e.claim_additional_information, e.line_edit_description, e.claim_edit_description ) as edit_additional_information

			,	e.is_overridable
			,	e.era_adjustment_group
			,	e.era_adjustment_reason_code
			,	e.era_remark_code

			from @external_edit e
			order by e.claim_procedure_id
				    ,coalesce(e.claim_additional_information, e.line_edit_description, e.claim_edit_description ) --12/17/2021  Phan Lam add line_sequence_numbe for QPA display order

			-----------------------------------
			--	Clear this table to be tidy...we're done with it.
			-----------------------------------
			delete from @external_edit

			--QPA=0 send to review
			if @qpa_send_review = 1
				and @trading_partner_id = 24		--	Multiplan
			begin
				update mcr_dc_prod.dbo.claim 
				set claim_workflow_id = 254949			--QPA Multiplan WebTPA NSA Repricing Review
				where claim_id = @claim_id

			end		

			--------------------------------
			--	Save our mcr_dc_prod claim_nsa multiplan QPA
			--------------------------------
			if exists (select 1 from @claim_nsa)
				and @trading_partner_id = 24		--	Multiplan
			begin
				insert into mcr_dc_prod.dbo.claim_nsa
				(  claim_id
					,claim_type_id
					,claim_procedure_id
					,claim_ub92_service_id
					,line_number
					,nsa_QPA
					,nsa_QPN
					,nsa_vendor
					,qpa_type)
				select 
					claim_id
					,claim_type_id
					,claim_procedure_id	
					,claim_ub92_service_id
					,line_number
					,convert(money,nsa_QPA)
					,nsa_QPN
					,nsa_vendor
					,qpa_type      
				from @claim_nsa

				if @inbound_trading_partner_file_type_id not in (70,73)
				begin
					--	set allowed_amount for nsa_qpa
					update cp set allowed_amount = convert(money,nsa_QPA)
					from mcr_dc_prod.dbo.claim_procedure cp
					inner join @claim_nsa cn on cp.claim_id = cn.claim_id
											and cn.line_number = 0
				end
			end

		end	--	Save our Repricing External Edits
	
	end		--  Save Claim & Lines - Normal OON pricing
	
    -----------------------------------
	--  External edit suppression previous import when current pricing is different
    -----------------------------------
	if exists (select 1 
				from dbo.repricing_external_edit ree 
				where ree.claim_id = @claim_id
				and ree.x12_837_2300_id <> @x12_837_2300_id
				and ree.inbound_file_id <> @inbound_file_id) 
    begin
		exec wf_ib_2190_supress_claim_external_edit
						@Claim_id, @x12_837_2300_id, @trading_partner_id
    end

	-------------------------------------------
	--	P4P  -- PL 8/30/2022.
	-------------------------------------------
	if @trading_partner_id = 276
      begin

	    if exists ( select 1 from dbo.x12_837_2300 
		            where x12_837_2300_id = @x12_837_2300_id
	                  and convert(money,L2300_hcp05_repricing_per_diem_or_flat_rate_amount) > 0 )

        or exists (	select 1 from dbo.x12_837_2400 cp
				    where cp.x12_837_2300_id = @x12_837_2300_id
				    and convert(money,L2400_hcp05_repricing_per_diem_or_flat_rate_amount) > 0 )

		begin
            exec wf_ib_2181_p4p @x12_837_2300_id, @Claim_id, @instance_id 
		end

      end

	------------------------------
	--	Track our repricing effort
	------------------------------
	if @repricing_claim_history_id is not null
	begin
		if @update_claim = 1
			set @comment = 'The claim in iiiput has been updated.'
		else
			set @comment = 'The claim in iiiput was not updated.'
			
		update dbo.repricing_claim_history set
			inbound_file_id = @inbound_file_id
		,	comment = @comment
		,	is_par = @claim_is_par
		,	claim_repricing_flag_id = @claim_repricing_flag_id
		,	claim_workflow_id = @claim_workflow_id
		,	pricing_methodology = @L2300_hcp01_pricing_methodology
		,	allowed_amount = @claim_allowed_amount
		,	savings_amount = @claim_savings_amount
		,	repricing_organization_id = @repriced_organization_identifier
		,	reject_reason_code = @L2300_hcp13_reject_reason_code
		,	exception_reason_code = @L2300_hcp15_exception_reason_code
		,	sent_to_review_queue = @send_to_review_queue
		,	x12_837_2300_id = @x12_837_2300_id
		,	inbound_repricing_methodology_id = @inbound_repricing_methodology_id
		where repricing_claim_history_id = @repricing_claim_history_id
	end
	
	------------------------------
	--	Mark the x12_837_2300 claim as processed
	------------------------------
	update dbo.x12_837_2300 set 
		claim_id = @claim_id
	,	eligibility_id = @eligibility_id	
	,	provider_id_map_id = @provider_id_map_id
	,	vendor_id = @vendor_id
	,	processed = 1
	where x12_837_2300_id = @x12_837_2300_id

	update xcp set xcp.claim_procedure_id = cp.claim_procedure_id
	from dbo.x12_837_2400 xcp 
		inner join @claim_procedure cp on cp.x12_837_2400_id = xcp.x12_837_2400_id
	where xcp.x12_837_2300_id = @x12_837_2300_id
		
	--43459 start JRO refactored this code
	if @nws_post_processing_id > 1
	begin
		/*
			@nws_post_processing_id values
			1 = remove from NWS (never called from here)
			2 = one-way priced claim
			3 = send to senior review queue
			4 = re-apply pricing from [has_pricing] grid record
		*/
		if @debug = 1
			select 'calling inbound logic', @nws_post_processing_id '@nws_post_processing_id'
	
		exec mcr_dc_prod.dbo.network_router_inbound_EDEE_logic
											@p_claim_id							 = @claim_id,
											@p_repricing_claim_history_id		 = @repricing_claim_history_id,
											@p_claim_repricing_flag_id			 = @claim_repricing_flag_id ,
											@p_claim_is_par						 = @claim_is_par,
											@p_current_network_router_claim_grid_id = @current_network_router_claim_grid_id output,
											@p_next_network_router_claim_grid_id = @next_network_router_claim_grid_id output,
											@p_updated_claim_is_par				 = @updated_claim_is_par output,
											@p_next_claim_workflow_id			 = @next_claim_workflow_id output,
											@p_QPA_repricing_claim_history_id	 = @QPA_repricing_claim_history_id output,
											@p_NWSAction						 = @nws_post_processing_id,
											@p_debug							 = 0,
											@p_remove_from_NWS					 = @remove_claim_from_NWS,
											@p_nws_post_processing_id			 = @nws_post_processing_id output,
											@p_nws_update_claim					 = @nws_update_claim output		--43459
	end	--if @nws_post_processing_id > 1
	--43459 end 
		
	return 0

end


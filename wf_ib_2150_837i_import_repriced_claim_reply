			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	We haven't seen anything in the HCP13 during testing but typical values are T1, or T6, so something has gone wrong here if any others.
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	ClearHeatlh only sends HCP01 as 00 or 10.
		if isnull(@L2300_hcp01_pricing_methodology,'') not in ( '00','10')
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The pricing methodology at the claim level is an invalid code [' + isnull(@L2300_hcp01_pricing_methodology,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		declare @ch_code_desc				varchar(100)
		declare @ch_level_of_pricing		varchar(1)
		declare @ch_status_code				varchar(3)
		declare @ch_negotation_type			varchar(1)
		declare @ch_service_applied			varchar(2)
		declare @ch_oon_percentile_used		varchar(3)
		declare @ch_oon_multiplier_used		varchar(4)
		declare @ch_network_used			varchar(5)
		declare @ch_aggregator_used			varchar(5)
		declare @ch_contract_used			varchar(15)
		declare @ch_ineligibile_reason		varchar(10)
		declare @ch_hcp06_flag				varchar(7)
		declare @ch_hcp06_percent			varchar(3)
		declare @ch_hcp06_adjusted_units	varchar(4)
		declare @ch_hcp06_adjusted_charges	varchar(9)
		declare @ch_hcp08_pricing_note		varchar(48)
		declare @ch_nte						varchar(80)


		--	Parse the claim level note segment looking for ClearHealth values.
		select @ch_nte = n.L2300_nte02_claim_note_text
		from dbo.x12_837_2300_NTE n
		where n.x12_837_2300_id = @x12_837_2300_id
			and n.L2300_nte01_note_ref_code = 'ADD'


		if len(@ch_nte) > 0
		begin

			set @ch_level_of_pricing		= substring(@ch_nte,1,1)
			set @ch_status_code				= substring(@ch_nte,2,3)
			set @ch_negotation_type			= substring(@ch_nte,5,1)
			set @ch_service_applied			= substring(@ch_nte,6,2)
			set @ch_oon_percentile_used		= substring(@ch_nte,8,3)
			set @ch_oon_multiplier_used		= substring(@ch_nte,11,4)
			set @ch_network_used			= substring(@ch_nte,23,5)
			set @ch_aggregator_used			= substring(@ch_nte,28,5)
			set @ch_contract_used			= substring(@ch_nte,33,15)
			set @ch_ineligibile_reason		= substring(@ch_nte,68,10)


			select @comment = 'EDI: ClearHealth repricing information:'

				+ case when len(@ch_level_of_pricing) > 0 then 'Level of pricing:' else '' end
				+ case when @ch_level_of_pricing = 'C' then @CRLF + 'Claim level pricing only.' else '' end
				+ case when @ch_level_of_pricing = 'L' then @CRLF + 'Claim and line level pricing.' else '' end
				+ case when @ch_level_of_pricing = 'N' then @CRLF + 'No pricing.' else '' end

				+ case when len(@ch_status_code) > 0 then 'Level of negotiation:' else '' end
				+ case when @ch_status_code = 'SUC' then @CRLF + 'Successful Negotation.' else '' end
				+ case when @ch_status_code = 'FAI' then @CRLF + 'Failed Negotiation.' else '' end
				+ case when @ch_status_code = 'INL' then @CRLF + 'Ineligible.' else '' end
				+ case when @ch_status_code = 'PEN' then @CRLF + 'Pending.' else '' end
				+ case when @ch_status_code = 'PPO' then @CRLF + 'PPO Pricing Reduction.' else '' end
				+ case when @ch_status_code = 'OON' then @CRLF + 'OON Pricing Reduction.' else '' end
				+ case when @ch_status_code = 'NOR' then @CRLF + 'No Reduction.' else '' end

				+ case when len(@ch_negotation_type) > 0 then 'Negotiation type:' else '' end
				+ case when @ch_negotation_type = 'S' then @CRLF + 'Standard Negotiation.' else '' end
				+ case when @ch_negotation_type = 'P' then @CRLF + 'Negotiation Prospective.' else '' end
				+ case when @ch_negotation_type = 'O' then @CRLF + 'Negotiation On-going.' else '' end
				+ case when @ch_negotation_type = 'A' then @CRLF + 'Negotiation Appeal.' else '' end
				+ case when @ch_negotation_type = 'N' then @CRLF + 'Negotiation Not Applicable.' else '' end

				+ case when len(@ch_service_applied) > 0 then 'Service applied:' else '' end
				+ case when @ch_service_applied = 'A1' then @CRLF + 'Primary PPO pricing.' else '' end
				+ case when @ch_service_applied = 'A2' then @CRLF + 'Secondary PPO pricing - Logo.' else '' end
				+ case when @ch_service_applied = 'A3' then @CRLF + 'PPO pricing – Non logo.' else '' end
				+ case when @ch_service_applied = 'A4' then @CRLF + 'CHS OON Pricing - DRG Charge based.' else '' end
				+ case when @ch_service_applied = 'A5' then @CRLF + 'CHS OON Pricing - APC Charge based.' else '' end
				+ case when @ch_service_applied = 'A6' then @CRLF + 'CHS OON Pricing – Medicare based.' else '' end
				+ case when @ch_service_applied = 'A7' then @CRLF + 'Fee Negotiation.' else '' end
				+ case when @ch_service_applied = 'A8' then @CRLF + 'Not Applicable.' else '' end

				+ case when len(@ch_oon_percentile_used) > 0 then 'Percentile used:' + @ch_oon_percentile_used else '' end
				+ case when len(@ch_oon_multiplier_used) > 0 then 'Multiplier used:' + @ch_oon_multiplier_used else '' end

				+ case when len(@ch_network_used) > 0 then 'Network used:' + @ch_network_used else '' end
				+ case when len(@ch_aggregator_used) > 0 then 'Aggregator used:' + @ch_aggregator_used else '' end
				+ case when len(@ch_contract_used) > 0 then 'Contract used:' + @ch_contract_used else '' end
				+ case when len(@ch_ineligibile_reason) > 0 then 'Ineligible reason:' + @ch_ineligibile_reason else '' end

			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
	
		end


		declare @clearhealth_return_codes as table (
			code		varchar(50)
		,	code_type	varchar(50)
		,	description	varchar(100)
		)

		insert into @clearhealth_return_codes ( code, code_type, description )
		values('INLMPIN', 'INLR', 'Ineligible - CMS ID (MPIN) needed to Price Claim')
			,	('INLTYPE', 'INLR', 'Ineligible - Unable to Determine Claim Type')
			,	('INLDRG', 'INLR', 'Ineligible - Unable to group to DRG')
			,	('INLCODE', 'INLR', 'Ineligible - Missing Required Codes for Pricing')
			,	('INLDATA', 'INLR', 'Ineligible - Invalid Claim Data')
			,	('INLPROV', 'INLR', 'Ineligible - Provider Info Issue')
			,	('INLPAT', 'INLR', 'Ineligible - Missing Patient Info needed for Pricing')
			,	('INLOTH', 'INLR', 'Ineligible - Other Reason')
			,	('INLRCV', 'INLR', 'Ineligible - Recovery Claim')
			,	('INLLATE', 'INLR', 'Ineligible - Late Charges Only')
			,	('INLINT', 'INLR', 'Ineligible - Inpatient Interim Claim')
			,	('INLTERM', 'INLR', 'Ineligible - Termed Group')
			,	('INLVDCNBT', 'INLR', 'Ineligible - Adjustment of Void/Cancel Bill Type')
			,	('INLALTPRC', 'INLR', 'Ineligible - Alternate Pricing')
			,	('INLDENTCLM', 'INLR', 'Ineligible - Dental Claim')
			,	('INLCRCLM', 'INLR', 'Ineligible - Client Recalled Claim')
			,	('INLEXCLPRV', 'INLR', 'Ineligible - Excluded Provider')
			,	('INLLMD', 'INLLINE', 'Ineligible Line - Missing data')
			,	('INLLINVD', 'INLLINE', 'Ineligible Line - Invalid data')
			,	('INLLNPA', 'INLLINE', 'Ineligible Line - No Pricing Available')

		--	ToDo:  Parse the HCP06 and HCP08 fixed width values per the companion guide.  Test data didn't use them.
	
		--	ClearHealth only sent HCP04 values for non-par claims during testing.  Here are all the codes from their companion guide.
		--	02.25.2020 In production we got the value CHS for all HCP04 fields
		set @ch_code_desc = null

		if len(@L2300_hcp04_repriced_organization_identifier) > 0
		begin

			select @ch_code_desc = c.description
			from @clearhealth_return_codes c
			where c.code = @L2300_hcp04_repriced_organization_identifier

			if @ch_code_desc is not null
			begin
				set @claim_is_par = 0
				set @send_to_review_queue = 1
				select @comment = 'EDI: ClearHealth has sent an HCP04 code [' + isnull(@L2300_hcp04_repriced_organization_identifier,'') + '] indicating [' + isnull(@ch_code_desc,'unknown') + '].  Please research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end
		end

		--	02.25.2020 In production we got the value CHS for all HCP04 fields
		--	If it isn't CHS or one of the know ineligible codes above...barf.
		if (@L2300_hcp04_repriced_organization_identifier is null
			or @L2300_hcp04_repriced_organization_identifier <> 'CHS'
			)
			and @ch_code_desc is null
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: ClearHealth has sent an HCP04 code [' + isnull(@L2300_hcp04_repriced_organization_identifier,'') + '] that we have never seen before.  Please research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end


		---------------------------------
		--	Determine Claim Repricing Flag
		---------------------------------
		set @claim_repricing_flag_id = null	
		set @inbound_repricing_methodology_id = null
		set @nte02_note_text = null
		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier

		select 
			@claim_repricing_flag_id = claim_repricing_flag_id
		,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
		from dbo.claim_repricing_flag_organization_map 
		where 
			--organization_identifier = @repriced_organization_identifier
			--provider_is_participating = @claim_is_par --39964
			deleted = 0
			and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010
			and nte02_claim_note_text = @ch_status_code


		------------------------------
		--	Claims must have a repricing flag associated with the repricing org id.
		--	Referenced based pricing should NEVER be non-par unless the claim is broken.
		--	If we get here...someone has to contact ClearHealth and research why they couldn't prict the claim.
		------------------------------
		if @claim_repricing_flag_id is null	--	and @claim_is_par = 1	non-par claims must be specifically accounted for in the claim_repricing_flag_map table or you must rewrite the code above.
		begin
			set @send_to_review_queue = 1
			set @comment = 'EDI: A claim repricing flag could not be found.  All ClearHealth claims must be mapped; both par and non-par.  Research why ClearHealth refused to price this claim.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		
	end		--	ClearHealth


	------------------------------
	--	AMPS - Out of Network Pricing (OON) and sometimes Medical Bill Review (MBR)
	------------------------------
	if @trading_partner_id = 459						--	AMPS
	begin
		/*
				AMPS indicated on 01/23/2017 that these would be the only values returned in the HCP segments.

					HCP01	HCP04	Par		EOB Message  (Long Description) 	EOB (Short Description)
					50		AMPS	Non		Duplicate Claim.					Duplicate.
					51		AMPS	Non		Rejected Claim - Missing Data.		Rejected.
					52		AMPS	Non		Client Removed.						Client Removed.
					70		AMPS	Par		Priced at 100%						Priced at 100%
					80		AMPS	Par		Priced by AMPS RBR/MBR				Priced by AMPS Reference Based Repricing and possibly a Medical Bill Review (MBR) edit
					81		DC		Par		Priced by AMPS using Direct Contract.	Priced by AMPS DC.			

			There will be no values sent outside the HCP01 and HCP04.
		*/


		declare @valid_HCP_combinations		bit
		
		set @valid_HCP_combinations = 0
		set @claim_is_par = 0
		
		--	50 - Duplicate Claim
		if @L2300_hcp01_pricing_methodology = '50' and @L2300_hcp04_repriced_organization_identifier = 'AMPS'
		begin
			set @claim_is_par = 0
			set @valid_HCP_combinations = 1
			set @send_to_review_queue = 1
			select @comment = 'EDI: Duplicate Claim.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	51 - Rejected Claim - Missing Data
		if @L2300_hcp01_pricing_methodology = '51' and @L2300_hcp04_repriced_organization_identifier = 'AMPS'
		begin
			set @claim_is_par = 0
			set @valid_HCP_combinations = 1
			set @send_to_review_queue = 1
			select @comment = 'EDI: Rejected Claim - Missing Data.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	52 - Client Removed
		if @L2300_hcp01_pricing_methodology = '52' and @L2300_hcp04_repriced_organization_identifier = 'AMPS'
		begin
			set @claim_is_par = 0
			set @valid_HCP_combinations = 1
			set @send_to_review_queue = 1
			select @comment = 'EDI: AMPS has sent a pricing methodology code [52] which means [Client Removed].  Contact AMPS to determine the course of action for this code.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	70 – Priced by AMPS at 100%
		if @L2300_hcp01_pricing_methodology = '70' and @L2300_hcp04_repriced_organization_identifier = 'AMPS'
		begin
			set @claim_is_par = 1
			set @valid_HCP_combinations = 1
			select @comment = 'EDI: Priced by AMPS at 100%.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	80 - Priced by AMPS MBR at less than 100%
		if @L2300_hcp01_pricing_methodology = '80' and @L2300_hcp04_repriced_organization_identifier = 'AMPS'
		begin
			set @claim_is_par = 1
			set @valid_HCP_combinations = 1
			select @comment = 'EDI: Priced by AMPS MBR.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		
		--	81 - Priced by AMPS using Direct Contract
		if @L2300_hcp01_pricing_methodology = '81' and @L2300_hcp04_repriced_organization_identifier = 'DC'
		begin
			set @claim_is_par = 1
			set @valid_HCP_combinations = 1
			select @comment = 'EDI: Priced by AMPS using Direct Contract.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Invalid HCP01/HCP04 combinations must go to the review queue.
		if @valid_HCP_combinations = 0
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The pricing code combinations at the claim level are invalid [' + isnull(@L2300_hcp01_pricing_methodology,'none') + ']/[' + isnull(@L2300_hcp01_pricing_methodology,'none') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		
		--	The T1 and T6 codes should not appear in an AMPS claim...when they do figure out if we treat them as "usual" or "special"
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The reject reason code [' + @L2300_hcp13_reject_reason_code + '] should not happen for AMPS claims and must be reviewed.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	T6 indicates an error in the claim and it needs to be reviewed.
		if isnull(@L2300_hcp13_reject_reason_code,'')  = 'T6'
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code [' + @L2300_hcp13_reject_reason_code + '] should not happen for AMPS claims and must be reviewed.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
	
		--	All reject codes except T1 go to the review queue
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The reject reason code [' + @L2300_hcp13_reject_reason_code + '] is unexpected and should not happen for AMPS claims and must be reviewed.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier


		-------------------------------------------------------
		--	These AMPS claims sent for OON pricing and maybe also MBR
		-------------------------------------------------------
		if @repricing_configuration_id in (
				53		--	AMPS Professional - OON
			,	54		--	AMPS Institutional - OON
		)
		begin
			--	Get the claim repricing flag
			select 
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where organization_identifier = @repriced_organization_identifier
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010

				--	For AMPS we'll also match the HCP01 pricing methodology (reusing the table's NTE column)
				and nte02_claim_note_text = @L2300_hcp01_pricing_methodology


			--	Non-Par claims can use the generic Non PPO claim repricing flag
			if @claim_repricing_flag_id is null and @claim_is_par = 0
			begin
				set @claim_repricing_flag_id = 1	-- NON PPO
			end
		end

		-------------------------------------------------------
		--	These claims sent for MBR
		-------------------------------------------------------
		if @repricing_configuration_id in (
				--	In Network (INN) claims sent ONLY for MBR review...no pricing!
				78		--	AMPS Professional - INN MBR
			,	79		--	AMPS Institutional - INN MBR
			)
			or exists (
				--	Out of network claims (OON) sent for both reference based repricing (RBR) and Medical Bill Review (MBR)
				select 1
				from dbo.repricing_configuration_employergroup_mbr mbr
				where mbr.repricing_configuration_id = @repricing_configuration_id
					and mbr.employergroup_id  = @employergroup_id
					and mbr.deleted = 0
					and getdate() between mbr.eff_date and mbr.term_date
			)
		begin			
			------------------------------
			--	Is there a service line flagged for denial by Medical Bill Review?  The allowed amount will be zero.
			------------------------------
			if @L2300_hcp01_pricing_methodology = '80'
				and exists (
					--	A zero allowed amount with code '80' indicates the physician reviewer recommends denying the service line.
					select 1
					from dbo.x12_837_2400 cp
					where cp.x12_837_2300_id = @x12_837_2300_id
						and convert(money,cp.L2400_hcp02_repriced_allowed_amount) = 0	)
			begin

				--------------------------------
				--	Medical Bill Review (MBR) claims must be reviewed in the AMPs online portal.
				--------------------------------
				set @send_to_review_queue = 1

				--------------------------------
				--	Save our repricing external edit details
				--------------------------------
				insert into @external_edit (
						vendor_name
					,	inbound_file_id
					,	x12_837_2300_id
					,	external_ref_number
					,	claim_id
					,	claim_edit_code
					,	claim_edit_description
					,	claim_network_id
					,	claim_billed_amount
					,	claim_allowed_amount
					,	claim_savings_amount
					,	claim_recommended_action
					,	x12_837_2400_id
					,	line_sequence_number
					,	claim_procedure_id
					,	cpt_or_rev_code
					,	line_edit_code
					,	line_edit_description
					,	line_network_id
					,	line_billed_amount
					,	line_allowed_amount
					,	line_savings_amount
					,	line_recommended_action
					,	is_overridable
					,	print_on_eop
					,	pend_serivce_line
					,	era_adjustment_group
					,	era_adjustment_reason_code
					,	era_remark_code
				)
				select
						'AMPS MBR'
					,	@inbound_file_id
					,	@x12_837_2300_id
					,	null
					,	@claim_id
					,	c.L2300_hcp04_repriced_organization_identifier			--	claim_edi_code
					,	'AMPS Medical Bill Review recommends denying this service line.'		--	claim_edit_description
					,	c.L2300_hcp04_repriced_organization_identifier			--	claim_network_id
					,	convert(money,c.L2300_clm02_total_claim_chg_amt)		--	claim_billed_amount
					,	convert(money,c.L2300_hcp02_repriced_allowed_amount)	--	claim_allowed_amount
					,	convert(money,c.L2300_hcp03_repriced_savings_amount)	--	claim_savings_amount
					,	'PEND'									--	claim_recommended_action
					,	cp.x12_837_2400_id
					,	cp.L2400_lx01_assigned_num				--	line_sequence_number
					,	null									--	claim_procedure_id
					,	coalesce(cp.L2400_sv101_proc_code, cp.L2400_sv201_service_line_revenue_code, cp.L2400_sv202_procedure_code)	--	cpt_or_rev_code
					,	cp.L2400_hcp04_repriced_organization_identifier			--	line_edit_code
					,	'AMPS Medical Bill Review recommends denying this service line.'		--	line_edit_description
					,	cp.L2400_hcp04_repriced_organization_identifier				--	line_network_id
					,	convert(money,isnull(cp.L2400_sv102_line_charge, cp.L2400_sv203_line_item_charge_amount))	--	line_billed_amount
					,	convert(money,cp.L2400_hcp02_repriced_allowed_amount)	--	line_allowed_amount
					,	convert(money,cp.L2400_hcp03_repriced_savings_amount)	--	line_savings_amount
					,	'PEND'			--	line_recommended_action
					,	1				--	is_overridable
					,	0				--	print_on_eop
					,	1				--	pend_service_line
					,	null			--	era_adjustment_group
					,	null			--	era_adjustment_reason_code
					,	null			--	era_remark_code
				from dbo.x12_837_2300 c
					inner join dbo.x12_837_2400 cp on c.x12_837_2300_id = cp.x12_837_2300_id
				where c.x12_837_2300_id = @x12_837_2300_id
					and convert(money,cp.L2400_hcp02_repriced_allowed_amount) = 0
				order by cp.x12_837_2400_id

				if @repricing_configuration_id in (78,79)
				begin
					-------------------------------------------------------------------------------------------------------------
					--	Remove this after testing real production claim MBR returns
					-------------------------------------------------------------------------------------------------------------
					set @comment = 'An AMPS MBR claim has been received.  Go look at it and be sure it processed correctly. x12_837_2300_id = [' + isnull(convert(varchar,@x12_837_2300_id),'null') + ']'
					exec msdb.dbo.sp_send_dbmail
						@recipients = 'jesse.terrell@webtpa.com',
						@body = @comment,
						@subject = 'AMPS MBR Claim Received'
					-------------------------------------------------------------------------------------------------------------
				end

			end

		end
	end

	------------------------------
	--	Payer Compass
	------------------------------
	if @trading_partner_id = 449		--	Payer Compass
	begin
		set @claim_is_par = 0
		
		--	00 Zero Pricing (Not Covered Under Contract).  Payer Compass uses 00 to indicate an error on the claim and it will have HCP13 = T6 (trapped below).
		if @L2300_hcp01_pricing_methodology = '00'
			set @claim_is_par = 0
		
		--	10 Other Savings (Par).  This can be changed to non-par by the HCP13 value OR the HCP04 like '%_NON'
		if @L2300_hcp01_pricing_methodology = '10'
			set @claim_is_par = 1

		--	14 Adjustment Pricing (Par).  This can be changed to non-par by the HCP13 value OR the HCP04 like '%_NON'
		--	This should ONLY happen on one-way claims.  Round-trip claims should not have this value.
		if @L2300_hcp01_pricing_methodology = '14'
		begin
			set @claim_is_par = 1
			set @comment = 'The pricing methodology [14] on the claim indicates it is an "Adjustment".' + @CRLF
			set @comment = @comment + 'This usually does not occur on round-trip pricing claims.  Please review why we got this status on a Payer Compass claim.' + @CRLF
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Only 00, 10, and 14 allowed for Payer Compass
		if @L2300_hcp01_pricing_methodology not in ( '00','10','14' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The pricing methodology code at the claim level is an invalid code [' + isnull(@L2300_hcp01_pricing_methodology,'null') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0

		--	12/20/2017	The new alliance coal implementation doesn't have 'T1' but does have HCP04 = '%_NON' which indicates priced at zero, we treat these as non-par
		if @L2300_hcp04_repriced_organization_identifier like '%_NON'
			and @L2300_hcp04_repriced_organization_identifier not in (
				'MRBP_NON'		--	Alliance Coal OON claims priced with Medicare Reference Based Repricing
				)
			set @claim_is_par = 0

		--	01/10/2018	Of course, before we even go to production Payer Compass breaks the above rule.
		if @L2300_hcp04_repriced_organization_identifier like '%NON' and @inbound_trading_partner_file_type_id in (1530,1531)		--	EJGallo
			set @claim_is_par = 0

		--	T6 indicates an error in the claim and it needs to be reviewed.
		if isnull(@L2300_hcp13_reject_reason_code,'')  = 'T6'
			and @is_network_router_claim = 0			--40729		
		begin			
			set @claim_is_par = 0			
			set @send_to_review_queue = 1			
			select @comment = 'EDI: The non-par indicator/reject code [' + @L2300_hcp13_reject_reason_code + '] indicates there is an error in this claim that must be reviewed.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	HCP15 6 indicates an error in one of the service lines and it needs to be reviewed.
		if isnull(@L2300_hcp15_exception_reason_code,'')  = '6'
		begin
		--	set @claim_is_par = 0			--	Sharon said to leave the Par flag on the claim and send it to the review queue.
			set @send_to_review_queue = 1
			select @comment = 'EDI: The exception reason code [' + @L2300_hcp15_exception_reason_code + '] indicates there is an error in this claim at the line level that must be reviewed.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	These are the only agreed upon HCP15 values...all others must go the review queue.
		if isnull(@L2300_hcp15_exception_reason_code,'')  not in ( '','6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The exception reason code [' + @L2300_hcp15_exception_reason_code + '] indicates there is an error in this claim at the line level that must be reviewed.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		
		--	These are the only agreed upon HCP13 values...all others must go the review queue.
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	The claim header can be listed as par but with one of the lines listed as non-par with an error.
		if @claim_is_par = 1
		begin
			if exists (
				select 1
				from dbo.x12_837_2400 cp
				where cp.x12_837_2300_id = @x12_837_2300_id
					and (
						cp.L2400_hcp01_pricing_methodology = '00'
						or cp.L2400_hcp13_reject_reason_code in ('T1','T6')
						)	)
			begin
			--	set @claim_is_par = 0			--	Sharon said to leave the Par flag on the claim and send it to the review queue...01/24/2017
				set @send_to_review_queue = 1
				select @comment = 'EDI: The claim level is listed as par but there is a non-par service line on the claim which must be reviewed.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end
		end

		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier

		---------------------------------------------------------
		--	Try the claim_repricing_flag in this order:
		--		Duncan DENIALs
		--		trading_partner_file_type_id + organization_identifier
		--		trading_partner_file_type_id + wildcard organization_identifier
		--		trading_partner_id + organization_identifier
		--		trading_partner_id + wildcard organization_identifier
		---------------------------------------------------------
		if @L2300_hcp04_repriced_organization_identifier = 'DENIAL'
		begin
			--	Put Sharon's special claim repricing flag ID of 412
			--	It should cause adjudication to put eob_id 3289 PC DRH DENY on the claim...so do I "not" need the external edit here?
			set @claim_repricing_flag_id = 412		--	PC DRJ RVW				
			set @send_to_review_queue = 1
			select @comment = 'EDI: Payer Compass has indicated that this Duncan Regional claim should be denied requesting detailed medical records.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--		trading_partner_file_type_id + organization_identifier
		if @claim_repricing_flag_id is null
		begin
			select 
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where 
				organization_identifier = @repriced_organization_identifier
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id
				and trading_partner_file_type_id = @inbound_trading_partner_file_type_id
		end

		--		trading_partner_file_type_id + wildcard organization_identifier
		if @claim_repricing_flag_id is null
		begin
			select 
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where 
				--	Notice the order of this LIKE statement...don't flip it around!
				@repriced_organization_identifier like organization_identifier
				and organization_identifier <> 'MCRPROF'
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id
				and trading_partner_file_type_id = @inbound_trading_partner_file_type_id
		end

		--		trading_partner_id + organization_identifier
		if @claim_repricing_flag_id is null
		begin
			select 
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where 
				organization_identifier = @repriced_organization_identifier
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id
		end

		--		trading_partner_id + wildcard organization_identifier
		if @claim_repricing_flag_id is null
		begin
			select 
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where 
				--	Notice the order of this LIKE statement...don't flip it around!
				@repriced_organization_identifier like organization_identifier
				and organization_identifier <> 'MCRPROF'
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id
				and trading_partner_file_type_id is not null	--	These MUST be trading_partner_file_type specific
				and organization_identifier <> '%'				--	Don't allow the open ended wildcard to match...tooooooo loose
		end
				

		--	Non-Par claims can use the generic Non PPO claim repricing flag
		if @claim_repricing_flag_id is null and @claim_is_par = 0
		begin
			set @claim_repricing_flag_id = 1	-- NON PPO
		end

		--	Add all the claim level and line notes as claim comments just like we do for all pricers
		insert into @claim_comment (claim_id, comment) 
		select distinct
			@claim_id
		,	'Repricer Note: ' + L2300_nte01_definition + ': ' + L2300_nte02_claim_note_text
		from dbo.x12_837_2300_NTE 
		where x12_837_2300_id = @x12_837_2300_id

		insert into @claim_comment (claim_id, comment) 
		select distinct
			@claim_id
		,	'Repricer Note: ' + n.L2400_nte01_definition + ': ' + n.L2400_nte02_claim_note_text
		from dbo.x12_837_2400 l 
			inner join x12_837_2400_NTE n  on l.x12_837_2400_id = n.x12_837_2400_id
		where l.x12_837_2300_id = @x12_837_2300_id

		--	Add PWK segments as comments for this pricer
		insert into @claim_comment (claim_id, comment) 
		select distinct
			@claim_id
		,	'Repricer Note: ' + L2300_pwk06_attachment_control_num
		from dbo.x12_837_2300_PWK 
		where x12_837_2300_id = @x12_837_2300_id

		insert into @claim_comment (claim_id, comment) 
		select distinct
			@claim_id
		,	'Repricer Note: ' + n.L2400_pwk06_attachment_control_num
		from dbo.x12_837_2400 l 
			inner join dbo.x12_837_2400_PWK n  on l.x12_837_2400_id = n.x12_837_2400_id
		where l.x12_837_2300_id = @x12_837_2300_id

		--	Add K3 segments as comments for this pricer
		insert into @claim_comment (claim_id, comment) 
		select distinct
			@claim_id
		,	'Repricer Note: ' + k.L2300_k301_fixed_format_information
		from dbo.x12_837_2300_K3 k
		where k.x12_837_2300_id = @x12_837_2300_id

		insert into @claim_comment (claim_id, comment) 
		select distinct
			@claim_id
		,	'Repricer Note: ' + k.L2400_k301_fixed_format_information
		from dbo.x12_837_2400 l 
			inner join dbo.x12_837_2400_K3 k  on l.x12_837_2400_id = k.x12_837_2400_id
		where l.x12_837_2300_id = @x12_837_2300_id

		--	Per Sharon we want to give the claim's examiner instructions on what to do with these claims.
		if @repriced_organization_identifier = 'PPA'
		begin
			insert into @claim_comment (claim_id, comment) 
			select distinct
				@claim_id
			,	'EDI: Repricer has identified this claim as a PPA billing issue.  Please deny claim back to provider to submit directly to the PPA for correct claim submission.'
			from dbo.x12_837_2300_NTE 
			where x12_837_2300_id = @x12_837_2300_id
		end
        
		--Story#41446
		IF @claim_is_par = 0 AND @is_network_router_claim = 0	
			SET @route_to_claim_workflow_id = 220166  --Payer Compass Repricing Review - EHN
	end


	------------------------------
	--	MagnaCare will use standard HCP01 values and will use the HCP04 field to indicate specific pricing responses (EOB Remarks)
	--	Keep these rules in sync with the one-way rules.
	------------------------------
	if @trading_partner_id = 327		--	MagnaCare
	begin
		
		set @claim_is_par = 1
		
		--	00 Zero Pricing (Not Covered Under Contract)
		if @L2300_hcp01_pricing_methodology = '00'
			set @claim_is_par = 0
		
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0
		
		set @repricing_return_code_id = null
		set @rc_is_par = 0
		set @rc_send_to_review_queue = 0
		set @rc_remark_code = null
		set @rc_remark_description = null
		set @rc_tpa_action = null
		set @rc_rowcount = 0

		select 
			@repricing_return_code_id = rc.repricing_return_code_id
		,	@rc_is_par = rc.is_par
		,	@rc_send_to_review_queue = rc.send_to_review_queue
		,	@rc_remark_code = rc.remark_code
		,	@rc_remark_description = rc.remark_description
		,	@rc_tpa_action = rc.tpa_action

		from dbo.repricing_return_code rc 
		where rc.trading_partner_id = @trading_partner_id
			and rc.remark_code = @L2300_hcp04_repriced_organization_identifier
			and rc.deleted = 0

		--	Should be exactly one match or this needs to go to review queue.
		set @rc_rowcount = @@rowcount

		--	Do what the MagnaCare return code indicates.
		if @rc_rowcount = 1
		begin
			--	set @claim_is_par = @rc_is_par
			if @send_to_review_queue = 0 and @rc_send_to_review_queue = 1
				set @send_to_review_queue = 1

			set @comment = 'EDI: MagnaCare EOB Message: ' + @rc_remark_description
			if @rc_tpa_action is not null
			begin
				if right(@comment,1) <> '.' set @comment = @comment + '.'
				set @comment = @comment + ' TPA Action: ' + @rc_tpa_action
			end
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Missing the MagnaCare return code in our repricing_return_code table.
		if @rc_rowcount = 0
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The MagnaCare repricing_return_code [' + @L2300_hcp04_repriced_organization_identifier + '] is invalid or missing.  This must be resolved by our claim EDI person.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	We have duplicate entries in the repricing_return_code table.  There must be exactly one.
		if @rc_rowcount > 1
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The MagnaCare repricing_return_code [' + @L2300_hcp04_repriced_organization_identifier + '] is listed more than once in our EDI configuration.  This must be resolved by our claim EDI person.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Look to see if Magnacare performed bundled pricing on this claim.  If so the Provider Maintenance department must resolve this "new" bundled service line.
		--	Search the HCP*04 segment and the note segments.
		set @is_bundled_pricing = 0

		if @is_bundled_pricing = 0
		begin
			if exists (
				select 1
				from dbo.x12_837_2300 c
				where c.x12_837_2300_id = @x12_837_2300_id
					and c.L2300_hcp04_repriced_organization_identifier in ('21','27','30','31')	)
			begin
				set @is_bundled_pricing = 1
			end
		end
		if @is_bundled_pricing = 0
		begin
			if exists (
				select 1
				from dbo.x12_837_2300_NTE n
				where n.x12_837_2300_id = @x12_837_2300_id
					and n.L2300_nte02_claim_note_text like '%bundle%'	)
			begin
				set @is_bundled_pricing = 1
			end
		end
		if @is_bundled_pricing = 0
		begin
			if exists (
				select 1
				from dbo.x12_837_2400 cp
				where cp.x12_837_2300_id = @x12_837_2300_id
					and cp.L2400_hcp04_repriced_organization_identifier in ('21','27','30','31')	)
			begin
				set @is_bundled_pricing = 1
			end
		end
		if @is_bundled_pricing = 0
		begin
			if exists (
				select 1
				from dbo.x12_837_2400 cp
					inner join dbo.x12_837_2400_NTE n on n.x12_837_2400_id = cp.x12_837_2400_id
				where cp.x12_837_2300_id = @x12_837_2300_id
					and n.L2400_nte02_claim_note_text like '%bundle%'	)
			begin
				set @is_bundled_pricing = 1
			end
		end

		if @is_bundled_pricing = 1
		begin
			set @send_to_review_queue = 1
			select @comment = 'EDI: The MagnaCare repricing return code indicates this may be bundled pricing.  This must be resolved by reviewing the raw pricing data for the new bundled service line.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		
		--	Magnacare "MagPay" claims must be manually processed.  The vendor needs to be changed to MagPay because we'll be paying Magnacare the check and they in turn will pay the provider.
		--	Note that Sharon decided we could automatically update the claim to the new MagPay vendor.
		set @is_magpay = 0

		--	Any files with these extensions are MagPay claims.  This should be the only indicator we need because MagnaCare says all MagPay claims will be
		--	isolated to separate files with this naming and all claims in these files will be MagPay claims.
		if @trading_partner_filename like '%.d37%' 
			or @trading_partner_filename like '%.u37%'
			or @trading_partner_filename like '%.uc7%'	--	think this is a typo in their documentation or emails but leaving here cause they said so.
		begin
			set @is_magpay = 1
		end

		--	Any time the submitter name is MagnaCare MagPay it's a MagPay claim.
		if @is_magpay = 0
		begin
			set @L1000A_nm103_submitter_last_name = null

			select @L1000A_nm103_submitter_last_name = s.L1000A_nm103_submitter_last_name
			from dbo.x12_837_1000 s
			where s.x12_transaction_id = @x12_transaction_id

			if @L1000A_nm103_submitter_last_name = 'MAGNACARE MAGPAY'
			begin
				set @is_magpay = 1
			end
		end

		if @is_magpay = 0
		begin
			if exists (
				select 1
				from dbo.x12_837_2300 c 
					inner join dbo.x12_837_2010AX p  on c.x12_837_2000A_id = p.x12_837_2000A_id
				where c.x12_837_2300_id = @x12_837_2300_id
					and p.L2010AX_nm101_entity_id_code = '87'		-- pay to provider	
					and p.L2010AX_n301_address1 = 'C/O MAGNACARE'
					and p.L2010AX_n302_address2 = 'PO BOX 7331'
					and p.L2010AX_n401_city = 'GARDEN CITY'
					and p.L2010AX_n402_state = 'NY'	)
			begin
				set @is_magpay = 1
			end
		end

		if @is_magpay = 1
		begin
			set @vendor_id = 1592626	
				--	113410766-00011
				--	C/O MAGNACARE
				--	PO BOX 7331
				--	GARDEN CITY	NY	11530

			update mcr_dc_prod.dbo.claim set vendor_id = @vendor_id 
			where claim_id = @claim_id
				and vendor_id <> @vendor_id

			--	set @send_to_review_queue = 1
			select @comment = 'EDI: Magnacare indicates this is a "MagPay" claim.  The vendor on the claim has been updated.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)			
		end

		--	ToDo:	What will MagnaCare send in HCP13?
				
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0
		
		--	All reject codes except T1 go to the review queue
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		set @claim_repricing_flag_id = null	

		--	MagnaCare uses the HCP04 to communicate EOB remark codes (why not the NTE segments?!)
		set @repriced_organization_identifier = 'MAGNACARE'
		
		select 
			@claim_repricing_flag_id = claim_repricing_flag_id
		,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
		from dbo.claim_repricing_flag_organization_map 
		where organization_identifier = @repriced_organization_identifier
			and provider_is_participating = @claim_is_par
			and deleted = 0
			and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010
				

		--	Non-Par claims can use the generic Non PPO claim repricing flag
		if @claim_repricing_flag_id is null and @claim_is_par = 0
		begin
			set @claim_repricing_flag_id = 1	-- NON PPO
		end

	end

	
	------------------------------
	--	Viant-Beechstreet Par/Non-Par rules in HCP segment
	------------------------------
	if @trading_partner_id  = 27		--	Viant-Beechstreet
	begin
		
		set @claim_is_par = 1
		
		--	00 Zero Pricing (Not Covered Under Contract)
		if @L2300_hcp01_pricing_methodology = '00'
			set @claim_is_par = 0
		
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0
			
		--	T6 Claim has failed Viant business edits or has been rejected
		if @L2300_hcp13_reject_reason_code = 'T6'
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code [' + @L2300_hcp13_reject_reason_code + '] at the claim level indicates the claim was rejected for pricing.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end
		
		--	All reject codes except T1 go to the review queue
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + @L2300_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end		
	end		
	
	
	------------------------------
	--  BCBSAZ additional repricing for HCP 15
	------------------------------
	if @trading_partner_id = 22		--	BCBSAZ
	begin
		/*
			2300 HCP15		Not Present = PPO (par)
							6 = Par Only (par)
							3 = non contracted (non-par)
			2400 HCP01		00 - zero pricing or out of the providers scope of practice
							01 - priced as billed (non-par claim)
							03 - priced at the providers contract rate and fee schedule (par claim)
							04 - this service is included in another procedure (not related to par/non-par bit could explain why zero dollars allowed)
		*/
	
		if @L2300_hcp15_exception_reason_code = ''
		begin
			--	blank hcp15 indicates Par (PPO)
			if @claim_is_par = 0
			begin
				set @send_to_review_queue = 1
				select @comment = 'EDI: The claim appears to be Non-PAR but HCP15 is missing which indicates PPO (best Par)'			
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)				
			end
		end
		if @L2300_hcp15_exception_reason_code = '6'
		begin
			--	hcp15 = 6 indicates Par (though not PPO par)
			if @claim_is_par = 0
			begin
				set @send_to_review_queue = 1
				select @comment = 'EDI: The claim appears to be Non-PAR but HCP15 is 6 which indicates PAR.'			
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)				
			end
		end	
		if @L2300_hcp15_exception_reason_code = '3'
		begin
			--	hcp15 = 3 indicates Non-Par
			set @claim_is_par = 0
		end	
	end	
	

	------------------------------
	--  BSW Bayler Scott & White
	------------------------------
	if @trading_partner_id = 586		--	BSW Bayler Scott & White
	begin
		
		/*
			2300 HCP		BSW does not send anything at the claim level so take everything from the line level.

			2400 HCP01		00 - zero pricing or out of the providers scope of practice
							03 - priced at the providers contract rate and fee schedule (par claim)
		*/
	
		set @claim_level_pricing_found = 0		
		
		set @L2300_hcp01_pricing_methodology = ''
		set @L2300_hcp13_reject_reason_code = ''
		set @L2300_hcp15_exception_reason_code = ''
		
		set @L2400_hcp01_pricing_methodology = ''
		set @L2400_hcp13_reject_reason_code = ''
		set @L2400_hcp04_repriced_organization_identifier = ''

		
		------------------------------
		--	Get claim level stuff from first service line.
		------------------------------
		select top 1
			@L2400_hcp01_pricing_methodology = isnull(l.L2400_hcp01_pricing_methodology,'')
		,	@L2400_hcp13_reject_reason_code = isnull(l.L2400_hcp13_reject_reason_code,'')
		,	@L2400_hcp04_repriced_organization_identifier = isnull(l.L2400_hcp04_repriced_organization_identifier,'')
		
		--	Load these so they can be used for the rest of the claim
		,	@L2300_hcp01_pricing_methodology = isnull(l.L2400_hcp01_pricing_methodology,'')
		,	@L2300_hcp13_reject_reason_code = isnull(l.L2400_hcp13_reject_reason_code,'')
		,	@L2300_hcp15_exception_reason_code = isnull(l.L2400_hcp15_exception_reason_code,'')		
		
		from dbo.x12_837_2400 l
		where l.x12_837_2300_id = @x12_837_2300_id
			and (
				len(L2400_hcp01_pricing_methodology) > 0
				or len(L2400_hcp02_repriced_allowed_amount) > 0
				or len(L2400_hcp03_repriced_savings_amount) > 0
				or len(L2400_hcp04_repriced_organization_identifier) > 0
				or len(L2400_hcp13_reject_reason_code) > 0
				)
		
		order by l.x12_837_2400_id		
		
		if len(@L2400_hcp01_pricing_methodology) > 0
			set @claim_level_pricing_found = 1


		--	Grab the claim level allowed amount
		select 
			@L2300_hcp02_repriced_allowed_amount = convert(varchar,sum(isnull(convert(money,@L2400_hcp02_repriced_allowed_amount),0)))
		,	@L2300_hcp03_repriced_savings_amount = convert(varchar,sum(isnull(convert(money,@L2400_hcp03_repriced_savings_amount),0)))
		from dbo.x12_837_2400 l
		where l.x12_837_2300_id = @x12_837_2300_id
			and (
				len(L2400_hcp01_pricing_methodology) > 0
				or len(L2400_hcp02_repriced_allowed_amount) > 0
				or len(L2400_hcp03_repriced_savings_amount) > 0
				or len(L2400_hcp04_repriced_organization_identifier) > 0
				or len(L2400_hcp13_reject_reason_code) > 0
				)

	
		------------------------------
		--	Claim Par/Non-Par
		------------------------------
		set @claim_is_par = 1

		--	These are the only two we've seen so far
		if isnull(@L2400_hcp01_pricing_methodology,'') not in ( '00','03' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The pricing methodologh code at the first line level is an invalid code [' + @L2400_hcp01_pricing_methodology + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end	
		
		if @L2400_hcp01_pricing_methodology = '00'
		begin
			--if @L2300_hcp02_repriced_allowed_amount = 0
			if (case when try_cast(@L2300_hcp02_repriced_allowed_amount as money) is null then null else cast(@L2300_hcp02_repriced_allowed_amount as money) end) = 0
				and not exists (
					select 1
					from x12_837_2400 cp
					where cp.x12_837_2300_id = @x12_837_2300_id
						and case when try_cast(cp.L2400_hcp02_repriced_allowed_amount as money) is null then 0 else cast(cp.L2400_hcp02_repriced_allowed_amount as money) end >= 0	)	-- jm	06/16/2023	9801
			begin
				set @claim_is_par = 0
			end
		end
		
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2400_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0
		
		--	All reject codes except T1 go to the review queue
		if isnull(@L2400_hcp13_reject_reason_code,'') not in ( '','T1' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the first line level is an invalid code [' + @L2400_hcp13_reject_reason_code + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end	


		------------------------------
		--	Claim Repricing Flag
		------------------------------
		set @claim_repricing_flag_id = null	
		set @repriced_organization_identifier = null
			
		if @claim_is_par = 1
		begin				-- 25063	10/12/2023	jm
			declare @max_from_service_date		date
				,	@max_to_service_date		date
				,	@max_service_date			date

			set @max_from_service_date = null
			set @max_to_service_date = null
			set @max_service_date = null

			select 
				@max_from_service_date = max(cp.from_service_date),
				@max_to_service_date = max(cp.to_service_date)
			from mcr_dc_prod.dbo.claim_procedure cp
			where cp.claim_id = @claim_id

			if @max_service_date is null and @max_to_service_date is not null
			begin
				set @max_service_date = @max_to_service_date;
			end
			if @max_service_date is null and @max_from_service_date is not null
			begin
				set @max_service_date = @max_from_service_date
			end

			if @max_service_date is null			-- should never happen but have to do something here.....
				set @claim_repricing_flag_id = 595

			if @max_to_service_date < '01/01/2024'
			set @claim_repricing_flag_id = 427		--	BSW MERCER H		
		else
				set @claim_repricing_flag_id = 595		--  BSW Premier
		end
		else
			set @claim_repricing_flag_id = 1	-- NON PPO

		set @L2300_ref02_reference = null		--	jm	10/12/2023		25076	BSW | Add new Claim Comment	
		select top 1 @L2300_ref02_reference = L2300_ref02_reference
		from dbo.x12_837_2300_REF r
		where r.x12_837_2300_id = @x12_837_2300_id
		and r.L2300_ref01_code = '9C'
		order by r.x12_837_2300_REF_id
		
		if @L2300_ref02_reference is not null and len(@L2300_ref02_reference) > 0
		begin
			set @comment = 'BSW Internal Claim number = ' + @L2300_ref02_reference + '.';
			insert into @claim_comment (claim_id, comment) values (@claim_id, @comment);
		end

	end

	

	------------------------------
	--  Healthlink			 43775
	------------------------------
	if @trading_partner_id = 797
	begin
		--non par
		if @L2300_hcp01_pricing_methodology in ('00')
			set @claim_is_par = 0

		--par
		if @L2300_hcp01_pricing_methodology in ('01', '02', '03', '04', '06', '07', '08', '10', '14')
			set @claim_is_par = 1

		if isnull(@L2300_hcp01_pricing_methodology,'') not in ( '00', '01', '02', '03', '04', '06', '07', '08', '10', '14' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			set @review_workflow_id = 272995		--Healthlink repricing review
			select @comment = 'EDI: The pricing methodology code at the claim level is an invalid code [' + isnull(@L2300_hcp01_pricing_methodology,'null') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0

		set @claim_repricing_flag_id = null	
		if len(@L2300_hcp01_pricing_methodology) > 0
		begin
			if @claim_repricing_flag_id is null
			begin
				select @claim_repricing_flag_id = claim_repricing_flag_id
					,  @route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
				from dbo.claim_repricing_flag_organization_map 
				where 
					organization_identifier = @L2300_hcp04_repriced_organization_identifier
					and @L2300_hcp01_pricing_methodology in ('01', '02', '03', '04', '06', '07', '08', '10', '14')
					and provider_is_participating = @claim_is_par
					and deleted = 0
					and trading_partner_id = @trading_partner_id
			end --@claim_repricing_flag_id is null
		end --len(@L2300_hcp01_pricing_methodology) > 0

		if @claim_is_par = 1
		begin
			if @claim_repricing_flag_id is null
			begin
				set @comment = 'Claim Repricing Flag not found in table lookup.  ' + @CRLF
				set @comment = @comment + 'L2300_hcp04_repriced_organization_identifier: ' + isnull(@L2300_hcp04_repriced_organization_identifier,'null') + @CRLF
				set @comment = @comment + 'Claim sent to repricing review queue.' + @CRLF				
				set @comment = @comment + 'Data not changed.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

				set @review_workflow_id = 272995		--Healthlink repricing review
				set @send_to_review_queue = 1
			end
		end
		if @claim_is_par = 0 or @claim_repricing_flag_id is null
		begin
			set @claim_repricing_flag_id = 1		-- NON PPO
		end
	end -- @trading_partner_id = 797

	------------------------------
	--  Claim repricing flag	(try claim level then, if necessary, line level lookup)
	--	This may be overridden by trading partner specific code.
	------------------------------
	if @trading_partner_id not in ( 
			24		--	Multiplan
		,	47		--	NCN
		,	99		--	Aetna
		,	224		--	First Health Coventry
		,	327		--	MagnaCare
		,	449		--	Payer Compass
		,	459		--	AMPS - WFM
		,	276		--	Cigna
		,	583		--	Cigna HCH
		,	585		--	ClearHealth
		,	586		--	BSW Bayler Scott & White
		,	797		--	Healthlink
	)
	begin
		set @claim_repricing_flag_id = null	
		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier
		
		--	if the claim is repriciced but the org id is missing look for it on the first procedure record
		if @claim_level_pricing_found = 1 and isnull(@repriced_organization_identifier,'') = ''
		begin
			select top 1
				@repriced_organization_identifier = isnull(c.L2400_hcp04_repriced_organization_identifier,'')
			from dbo.x12_837_2400 c 
			where c.x12_837_2300_id = @x12_837_2300_id
				and ( c.L2400_hcp01_pricing_methodology is not null
					or c.L2400_hcp13_reject_reason_code is not null
					or c.L2400_hcp04_repriced_organization_identifier is not null )		
			order by c.x12_837_2400_id
		end		

		--	44227	HCH Direct - Buiness is unsure, so added lookup for NTE02_claim_text
		if @trading_partner_id = 798
		begin
			select @nte02_note_text = L2300_nte02_claim_note_text
			from dbo.x12_837_2300_NTE
			where x12_837_2300_id = @x12_837_2300_id
				and L2300_nte01_note_ref_code = 'ADD'

			if @nte02_note_text = 'QPA'
			begin
				select @add_to_qpa_list = 1
				  ,@qpa_type = rnc.qpa_type
				  ,@repricing_claim_type_id = 3 
				from dbo.repricing_nsa_config rnc with (nolock)
				where rnc.trading_partner_id = @trading_partner_id
			end

			select top 1
				@claim_repricing_flag_id = claim_repricing_flag_id 
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where organization_identifier = @repriced_organization_identifier
				and nte02_claim_note_text = @nte02_note_text
				and provider_is_participating = 1
				and deleted = 0
				and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010
				order by claim_repricing_flag_organization_map_id
		end

		if @claim_repricing_flag_id is null			--	44227
		begin
		if len(@repriced_organization_identifier) > 0
				select top 1											-- 44227 - Added TOP 1 since @nte02_note_text is queried above and we have multiple HCP04 values
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where organization_identifier = @repriced_organization_identifier
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010
				order by claim_repricing_flag_organization_map_id
		end
				
		--	Cigna can use large numeric ranges for it's organization id
		if @claim_repricing_flag_id is null
			select 
				@claim_repricing_flag_id = claim_repricing_flag_id
			,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
			from dbo.claim_repricing_flag_organization_map 
			where @repriced_organization_identifier between organization_identifier_range_start and organization_identifier_range_end
				and provider_is_participating = @claim_is_par
				and deleted = 0
				and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010				
				

		--	Non-Par claims can use the generic Non PPO claim repricing flag
		if @claim_repricing_flag_id is null and @claim_is_par = 0
		begin
			set @claim_repricing_flag_id = 1	-- NON PPO
		end
	end


	/*----------------------------------------------------------------------------------------------

		7/30/2018	Broke this out of the generic repricing flag search into its own section to 
		mirror dental claims.

		Cigna claims can have lots of edits that we'll want to forward to the claim procedure
		record and then onward to the EOB.

	----------------------------------------------------------------------------------------------*/
	if @trading_partner_id in (
		276		--	CIGNA Inbound Repriced Claims
	,	583		--	CIGNA HCH
	)
	begin
	
		---------------------------------
		--	Determing Par/Non-Par
		---------------------------------
		set @claim_is_par = 1

		--	These are the values we agreed to represent non-par
		if @L2300_hcp01_pricing_methodology = '00' 
			and @L2300_hcp04_repriced_organization_identifier = 'OON' 
			and @L2300_hcp13_reject_reason_code = 'T1'
		begin
			set @claim_is_par = 0
		end
		else if @L2300_hcp01_pricing_methodology = '00'
				or @L2300_hcp04_repriced_organization_identifier = 'OON'
				or @L2300_hcp13_reject_reason_code = 'T1'
		begin
			set @claim_is_par = 0

			set @send_to_review_queue = 1
			select @comment = 'EDI: The Cigna OON pricing indicators are not agreed upon values: pricing methodology [' 
				+ isnull(@L2300_hcp01_pricing_methodology,'') + '], ['
				+ isnull(@L2300_hcp04_repriced_organization_identifier,'') + '], ['
				+ isnull(@L2300_hcp13_reject_reason_code,'') + '].'

			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	These require intervention (usually correction and resubmit for pricing).
		if @L2300_hcp13_reject_reason_code in ('T6')
		begin
			set @claim_is_par = 0

			set @send_to_review_queue = 1
			select @comment = 'EDI: The Cigna repricer reject code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '] indicates the claim is missing information that prevents repricing.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Valid HCP01 values
		if isnull(@L2300_hcp01_pricing_methodology,'') not in ( '00','01','02','03','04','06','07','08','10','14' )
		begin
			set @claim_is_par = 0

			set @send_to_review_queue = 1
			select @comment = 'EDI: Cigna Dental pricing methodology at the claim level is an invalid code [' + isnull(@L2300_hcp01_pricing_methodology,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Valid HCP13 values
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The Cigna non-par indicator/reject code at the claim level is an invalid code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Grab our clearinghouse claim number for external edits and claim comments
		select top 1 @2300_ref_D9 = L2300_ref02_reference
		from dbo.x12_837_2300_REF 
		where x12_837_2300_id = @x12_837_2300_id
			and L2300_ref01_code = 'D9'	-- clearinghouse claim number
		order by x12_837_2300_REF_id -- just for consistency

		if len(@2300_ref_D9) > 0
		begin
			select @comment = 'EDI: Cigna claim reference number is [' + @2300_ref_D9 + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end


		-------------------------------------------
		--	Grab the repricing organization ID
		-------------------------------------------
		set @claim_repricing_flag_id = null	
		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier		--	Don't use line level...there MUST be a claim level network ID for this implementation
		set @claim_pricer_network_name = null
		set @claim_pricer_description_short = null
		set @claim_pricer_description_long = null
		set @claim_pricer_recommended_action = null

		set @claim_era_adjustment_group = null
		set @claim_era_adjustment_reason_code = null
		set @claim_era_remark_code = null


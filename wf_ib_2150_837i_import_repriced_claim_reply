				if @trading_partner_id = 24
					and @multiplan_billed_fair = 1
					and @claim_is_par = 1
					and @line_is_par = 0
				begin
					set @line_is_par = 1
				end

				
				--	All reject codes except T1 go to the review queue
				if isnull(@L2400_hcp13_reject_reason_code,'') not in ( '','T1' )
				begin
					set @line_is_par = 0
					set @send_to_review_queue = 1
					select @comment = 'EDI: The non-par indicator/reject code for procedure line [' + convert(varchar,@line_count) + '] is an invalid code [' + @L2400_hcp13_reject_reason_code + '].'
					insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

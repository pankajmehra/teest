				--------------------------------------------------------------------------------------
				--	Look up the line repricing flag for our line level EOB @external_edits table.
				--	Case rate, per diem, or DRG rate will not have line level details.  Fall back to claim level for those.
				--------------------------------------------------------------------------------------
				if @trading_partner_id in (
						276		--	Cigna
					,	583		--	Cigna HCH
				)
				begin
					set @line_provider_is_participating = @line_is_par

					delete from @nte02_values

					insert into @nte02_values ( x12_837_2400_id, note_text )
					select distinct cp.x12_837_2400_id, cpn.L2400_nte02_claim_note_text
					from dbo.x12_837_2400 cp
						inner join dbo.x12_837_2400_NTE cpn on cp.x12_837_2400_id = cpn.x12_837_2400_id
					where cp.x12_837_2300_id = @x12_837_2300_id
						and len(cpn.L2400_nte02_claim_note_text) > 0

					--	1.	Try an exact match with NTE values
					if @line_repricing_flag_id is null
					begin
						select top 1		--	shouldn't be more than one match but be consistent if there is.
							@line_repricing_flag_id = claim_repricing_flag_id 
						,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
						,	@line_pricer_network_name = @L2400_hcp04_repriced_organization_identifier
						,	@line_pricer_description_short = m.pricer_description_short
						,	@line_pricer_description_long = m.pricer_description_long
						,	@line_pricer_recommended_action = m.pricer_recommended_action				
						,	@line_era_adjustment_group = m.era_adjustment_group
						,	@line_era_adjustment_reason_code = m.era_adjustment_reason_code
						,	@line_era_remark_code = m.era_remark_code
						,	@line_is_overridable = m.is_overridable
						,	@line_pend_service_line = m.pend_service_line
						,	@line_print_on_eop = m.print_on_eop
						from dbo.claim_repricing_flag_organization_map m
						where organization_identifier = @L2400_hcp04_repriced_organization_identifier
							and provider_is_participating = @line_provider_is_participating
							and deleted = 0
							and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010					
							and m.nte02_claim_note_text is not null
							and m.nte02_claim_note_text in (
								select n.note_text
								from @nte02_values n
							)
						order by m.claim_repricing_flag_organization_map_id
					end

					--	2.	Try an exact match without NTE values
					if @line_repricing_flag_id is null
					begin
						select top 1		--	shouldn't be more than one match but be consistent if there is.
							@line_repricing_flag_id = claim_repricing_flag_id 
						,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
						,	@line_pricer_network_name = @L2400_hcp04_repriced_organization_identifier
						,	@line_pricer_description_short = m.pricer_description_short
						,	@line_pricer_description_long = m.pricer_description_long
						,	@line_pricer_recommended_action = m.pricer_recommended_action				
						,	@line_era_adjustment_group = m.era_adjustment_group
						,	@line_era_adjustment_reason_code = m.era_adjustment_reason_code
						,	@line_era_remark_code = m.era_remark_code
						,	@line_is_overridable = m.is_overridable
						,	@line_pend_service_line = m.pend_service_line
						,	@line_print_on_eop = m.print_on_eop
						from dbo.claim_repricing_flag_organization_map m
						where organization_identifier = @L2400_hcp04_repriced_organization_identifier
							and provider_is_participating = @line_provider_is_participating
							and deleted = 0
							and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010					
						order by m.claim_repricing_flag_organization_map_id
					end

					--	3.	Try a numeric range with an NTE vlaue
					if @line_repricing_flag_id is null
					begin
						select top 1		--	shouldn't be more than one match but be consistent if there is.
							@line_repricing_flag_id = claim_repricing_flag_id
						,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
						,	@line_pricer_network_name = @L2400_hcp04_repriced_organization_identifier
						,	@line_pricer_description_short = m.pricer_description_short
						,	@line_pricer_description_long = m.pricer_description_long
						,	@line_pricer_recommended_action = m.pricer_recommended_action				
						,	@line_era_adjustment_group = m.era_adjustment_group
						,	@line_era_adjustment_reason_code = m.era_adjustment_reason_code
						,	@line_era_remark_code = m.era_remark_code
						,	@line_is_overridable = m.is_overridable
						,	@line_pend_service_line = m.pend_service_line
						,	@line_print_on_eop = m.print_on_eop
						from dbo.claim_repricing_flag_organization_map m
						where @L2400_hcp04_repriced_organization_identifier between organization_identifier_range_start and organization_identifier_range_end
							and provider_is_participating = @line_provider_is_participating
							and deleted = 0
							and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010				
							and m.nte02_claim_note_text is not null
							and m.nte02_claim_note_text in (
								select n.note_text
								from @nte02_values n
							)
						order by m.claim_repricing_flag_organization_map_id
					end

					--	4.	Try a numeric range without an NTE vlaue
					if @line_repricing_flag_id is null
					begin
						select top 1		--	shouldn't be more than one match but be consistent if there is.
							@line_repricing_flag_id = claim_repricing_flag_id
						,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
						,	@line_pricer_network_name = @L2400_hcp04_repriced_organization_identifier
						,	@line_pricer_description_short = m.pricer_description_short
						,	@line_pricer_description_long = m.pricer_description_long
						,	@line_pricer_recommended_action = m.pricer_recommended_action				
						,	@line_era_adjustment_group = m.era_adjustment_group
						,	@line_era_adjustment_reason_code = m.era_adjustment_reason_code
						,	@line_era_remark_code = m.era_remark_code
						,	@line_is_overridable = m.is_overridable
						,	@line_pend_service_line = m.pend_service_line
						,	@line_print_on_eop = m.print_on_eop
						from dbo.claim_repricing_flag_organization_map m
						where @L2400_hcp04_repriced_organization_identifier between organization_identifier_range_start and organization_identifier_range_end
							and provider_is_participating = @line_provider_is_participating
							and deleted = 0
							and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010				
						order by m.claim_repricing_flag_organization_map_id
					end

					--	5.	Try a wildcard with and withoug the TPFT		--	all 01.21.2022
					if @claim_repricing_flag_id is null
					begin

						-- 20211007 jm add like query below to handle wildcards - with checking trading_partner_file_type_id
						if @claim_repricing_flag_id is null
							select top 1		--	shouldn't be more than one match but be consistent if there is.
								@line_repricing_flag_id = claim_repricing_flag_id
							,	@route_to_claim_workflow_id = ISNULL(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
							,	@line_pricer_network_name = @L2400_hcp04_repriced_organization_identifier
							,	@line_pricer_description_short = m.pricer_description_short
							,	@line_pricer_description_long = m.pricer_description_long
							,	@line_pricer_recommended_action = m.pricer_recommended_action				
							,	@line_era_adjustment_group = m.era_adjustment_group
							,	@line_era_adjustment_reason_code = m.era_adjustment_reason_code
							,	@line_era_remark_code = m.era_remark_code
							,	@line_is_overridable = m.is_overridable
							,	@line_pend_service_line = m.pend_service_line
							,	@line_print_on_eop = m.print_on_eop
							from dbo.claim_repricing_flag_organization_map m		
							where @L2400_hcp04_repriced_organization_identifier like organization_identifier			
								and provider_is_participating = @line_provider_is_participating
								and deleted = 0
								and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010
								and trading_partner_file_type_id = @inbound_trading_partner_file_type_id

						-- 20211007 jm add like query below to handle wildcards - without checking trading_partner_file_type_id
						if @claim_repricing_flag_id is null
							select top 1		--	shouldn't be more than one match but be consistent if there is.
								@line_repricing_flag_id = claim_repricing_flag_id
							,	@route_to_claim_workflow_id = isnull(@route_to_claim_workflow_id, route_to_claim_workflow_id)	--	We might review these claims if not already routed there.
							,	@line_pricer_network_name = @L2400_hcp04_repriced_organization_identifier
							,	@line_pricer_description_short = m.pricer_description_short
							,	@line_pricer_description_long = m.pricer_description_long
							,	@line_pricer_recommended_action = m.pricer_recommended_action				
							,	@line_era_adjustment_group = m.era_adjustment_group
							,	@line_era_adjustment_reason_code = m.era_adjustment_reason_code
							,	@line_era_remark_code = m.era_remark_code
							,	@line_is_overridable = m.is_overridable
							,	@line_pend_service_line = m.pend_service_line
							,	@line_print_on_eop = m.print_on_eop		
							from dbo.claim_repricing_flag_organization_map m
							where @L2400_hcp04_repriced_organization_identifier like organization_identifier			
								and provider_is_participating = @line_provider_is_participating
								and deleted = 0
								and trading_partner_id = @trading_partner_id	--	jjt 10/14/2010	

					end

					if @line_provider_is_participating = 1 and @line_repricing_flag_id is null
					begin
						set @comment = 'Line Repricing Flag not found in table lookup on line [' + convert(varchar,isnull(@line_count,0)) + '].  ' + @CRLF
						set @comment = @comment + 'L2400_hcp04_repriced_organization_identifier: ' + isnull(@L2400_hcp04_repriced_organization_identifier,'null') + @CRLF
						set @comment = @comment + 'Claim sent to repricing review queue.' + @CRLF					
						set @comment = @comment + 'Data not changed.'
						insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
						set @send_to_review_queue = 1
					end

				end

				------------------------------
				--	Allowed Amount
				------------------------------
				set @allowed_amount = null
				
				if isnumeric(@L2400_hcp02_repriced_allowed_amount) = 1
				begin
					set @allowed_amount = convert(money,@L2400_hcp02_repriced_allowed_amount)
				end

				--------------------------------------------------------------------------------------
				--	44227	Populate Allowed Amount from 2400 HCP07 on claim from HCH Direct when 2300 NTE02 = QPA
				--------------------------------------------------------------------------------------
				if @trading_partner_id = 798
				and @add_to_qpa_list = 1												--QPA
				begin
					set @allowed_amount = convert(money,@L2400_hcp07_repriced_approved_amount)
				end

				if @allowed_amount is null or @allowed_amount < 0
				begin
					set @send_to_review_queue = 1
					select @comment = 'EDI: The repriced service line [' + convert(varchar,@line_count) + '] has an invalid allowed amount.'
					insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
				end

				if @allowed_amount = 0 and @charges > .01		--	01/26/2016	Sharon indicated that some service lines are merely "status" lines with a 1 penny charge...ignore these if they're priced at zero.
				begin
					--	Zero in allowed amount is not usually allowed
					--	Except for Sagamore, PHCS, Beechstree, & TTC, Blue Grass Family Health (BGFH), Aetna as of 1/11/2012 can zero one line and not another, First Health - Coventry, Cigna, MagnaCare, Payer Compass, AMPS, Cigna HCH
					--	jm	06/16/2023	9801	Add BSW (586)
					--  JRO 09/21/2023 24672 Added Evolutions (3)
					if @trading_partner_id not in ( 3, 4,24,27,31,43,99,224,152,276,327,449,459,583, 586 )
					begin
						set @send_to_review_queue = 1
						select @comment = 'EDI: The repriced service line [' + convert(varchar,@line_count) + '] has an invalid allowed amount [0.00].'
						insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)					
					end
					
					--	PHCS : put zero in allowed amount for "out of network" non-par claims & billed fair claims...don't fire this rule if it's billed fair.  Multiplan\Payment Integrity sends 0.00 when recommending a servcie line denial.
					if @trading_partner_id in ( 24 ) and @line_is_par = 1 and @multiplan_billed_fair = 0 and @repricing_configuration_id not in (57,58)
					begin						
						--Omit @trading_partner_id in QPA with 0 amount so we don't have duplicate invalid 0 amount in line  --Phan 1/7/2022
						if  @qpa_send_review = 0
						begin
							set @send_to_review_queue = 1

							select @comment = 'EDI: The repriced service line [' + convert(varchar,@line_count) + '] has an invalid allowed amount [0.00] for a par claim.'
							insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)						
						end
					end

					--	Beechstreet & TTC, BGFH : put zero in allowed amount for "out of network" non-par claims
					if @trading_partner_id in ( 27,31,43 ) and @line_is_par = 1
					begin
						set @send_to_review_queue = 1
						select @comment = 'EDI: The repriced service line [' + convert(varchar,@line_count) + '] has an invalid allowed amount [0.00] for a par claim.'
						insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
					end					
													
				end	

				--	TODO validate an allowed amount > 0 is Par because it doesn't make sense to price a non-par provider.
				
				if @allowed_amount > @charges
				begin
					set @send_to_review_queue = 1
					select @comment = 'EDI: The repriced service line [' + convert(varchar,@line_count) + '] has an allowed amount greater than billed charges.'
					insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
				end		
				
				---------------------------------------------------------
				--	Multiplan : Billed Fair
				---------------------------------------------------------
				if @trading_partner_id = 24
					and @multiplan_billed_fair = 1
				begin
					--	Allowed amount will be zero so override it to 100% billed charges
					set @allowed_amount = @charges
				end									
				
				set @total_allowed_amount = @total_allowed_amount + isnull(@allowed_amount,0)			
			
				
				------------------------------
				--	Savings Amount
				------------------------------
				set @savings_amount = null
				
				if isnumeric(@L2400_hcp03_repriced_savings_amount) = 1
				begin
					set @savings_amount = convert(money,@L2400_hcp03_repriced_savings_amount)
				end

				--	Multiplan : Billed Fair
				if @trading_partner_id = 24
					and @multiplan_billed_fair = 1
				begin
					--	Savings amount will be billed charges so override it to 0
					set @savings_amount = 0
				end

				set @total_savings_amount = @total_savings_amount + isnull(@savings_amount,0)			
				
				
				------------------------------
				--  Service Dates
				------------------------------
				set @2400_DTP_472 = null
				set @workdate = null
				set @from_service_date = null
				set @to_service_date = null
				
				select top 1 @2400_DTP_472 = L2400_dtp02_date	-- should only be one
				from dbo.x12_837_2400_DTP 
				where x12_837_2400_id = @x12_837_2400_id
					and L2400_dtp01_code = '472'	-- service
				order by L2400_dtp02_date	-- just for consistency if we have more than one

				-- from service date
				set @workdate = left(@2400_DTP_472,8)	-- "ccyymmdd" or "ccyymmdd-ccyymmdd"
				if isnumeric(@workdate) = 1
				begin
					set @workdate = substring(@workdate,5,2) + '/' + substring(@workdate,7,2) + '/' + substring(@workdate,1,4)
				end
				if isdate(@workdate) = 1
				begin
					set @from_service_date = convert(datetime,@workdate)
					-- smalldatetime can't hold all possible dates
					if @from_service_date < '01/01/1900' set @from_service_date = '01/01/1900'
					if @from_service_date > '06/01/2059' set @from_service_date = '06/01/2059'
				end

				-- to service date
				set @workdate = right(@2400_DTP_472,8)	-- "ccyymmdd" or "ccyymmdd-ccyymmdd"
				if isnumeric(@workdate) = 1
				begin
					set @workdate = substring(@workdate,5,2) + '/' + substring(@workdate,7,2) + '/' + substring(@workdate,1,4)
				end
				if isdate(@workdate) = 1
				begin
					set @to_service_date = convert(datetime,@workdate)
					-- smalldatetime can't hold all possible dates
					if @to_service_date < '01/01/1900' set @to_service_date = '01/01/1900'
					if @to_service_date > '06/01/2059' set @to_service_date = '06/01/2059'
				end


				------------------------------
				--  Claim Procedure ID
				------------------------------
				set @2400_REF_6R = null
				set @claim_procedure_id = null
				
				--	should contain our claim_procedure_id
				select @2400_REF_6R = L2400_ref02_reference
				from dbo.x12_837_2400_REF 
				where x12_837_2400_id = @x12_837_2400_id
					and L2400_ref01_code = '6R'


				--	validate the returned claim_procedure_id
				IF ISNUMERIC(@2400_REF_6R) = 1 
				    AND @2400_REF_6R  NOT LIKE '%[.$,+-]%'            --44946 Check is Interger value and not decimal  
					AND (LEN(@2400_REF_6R) < 10					--	10 digits is max size for int
						OR
							(
							LEN(@2400_REF_6R) = 10					--	10 digits is max size for int so it must be 2.1 billion or less
							AND
							LEFT(@2400_REF_6R,1) IN ('1','2')		--	2.1 billion is biggest int
							)
						)
				BEGIN
					--	validate our claim_procedure_id exists on our claim
					IF EXISTS (
						SELECT 1 
						FROM mcr_dc_prod.dbo.claim_procedure cp  
						WHERE claim_id = @claim_id
							AND claim_procedure_id = CONVERT(BIGINT,@2400_REF_6R) )    --46467 change INT to BIGINT
					BEGIN
						SET @claim_procedure_id = CONVERT(INT,@2400_REF_6R)
						
						--	be sure we aren't using the same claim_procedure_id as another repriced line
						IF EXISTS( SELECT 1 FROM @claim_procedure WHERE claim_procedure_id = @claim_procedure_id )
						BEGIN
							SET @claim_procedure_id = NULL
						END
					END				
				END
			
				--	try to find the claim procedure by matching line data
				IF @claim_procedure_id IS NULL
				BEGIN
					SELECT TOP 1 @claim_procedure_id = claim_procedure_id
					FROM mcr_dc_prod.dbo.claim_procedure  
					WHERE claim_id = @claim_id
						AND procedurecode_ud = @procedurecode_ud
						AND from_service_date = @from_service_date
						AND to_service_date = @to_service_date
						AND charges = @charges
						AND claim_procedure_id NOT IN (
							SELECT claim_procedure_id
							FROM @claim_procedure	)						
					ORDER BY claim_procedure_id
				END
				
				IF @claim_procedure_id IS NULL
				BEGIN
					--	The revcode on the procedure may not match the original UB service line procedure code
					SELECT TOP 1 @claim_procedure_id = claim_procedure_id
					FROM mcr_dc_prod.dbo.claim_procedure  
					WHERE claim_id = @claim_id
						AND from_service_date = @from_service_date
						AND to_service_date = @to_service_date
						AND charges = @charges
						AND claim_procedure_id NOT IN (
							SELECT claim_procedure_id
							FROM @claim_procedure	)						
					ORDER BY claim_procedure_id				
				END
				
				
				IF @claim_procedure_id IS NULL
				BEGIN
					SET @send_to_review_queue = 1
					SELECT @comment = 'EDI: The repriced service line [' + CONVERT(VARCHAR,@line_count) + '] can not be matched to a service line in iiiput.'
					INSERT INTO @claim_comment (claim_id, comment, sort_order) VALUES (@claim_id, @comment, 99)
				END
				
				------------------------------
				--  Compare Line Data
				------------------------------
				IF @claim_procedure_id IS NOT NULL
				BEGIN
					IF EXISTS (
						SELECT 1
						FROM mcr_dc_prod.dbo.claim_procedure cp 
						WHERE cp.claim_procedure_id = @claim_procedure_id
							AND (
								cp.charges <> @charges
								OR cp.from_service_date <> @from_service_date
								)	)
					BEGIN
						SET @send_to_review_queue = 1
						SET @comment = 'EDI: The service line charges, procedure code, or from service date on the repriced service line [' + CONVERT(VARCHAR,@line_count) + '] is different than the original service line.'
						INSERT INTO @claim_comment (claim_id, comment, sort_order) VALUES (@claim_id, @comment, 99)
					END
				END
				
				------------------------------
				--  store our line data until we're ready to update iiiput
				------------------------------
				IF @claim_procedure_id IS NOT NULL
				BEGIN
					INSERT INTO @claim_procedure (
						claim_procedure_id
					,	allowed_amount
					,	procedurecode_ud
					,	from_service_date
					,	charges
					,	x12_837_2400_id		
					
					,	sequence_number
					,	pricer_network_name
					,	pricer_description_short
					,	pricer_description_long
					,	pricer_recommended_action
					,	era_adjustment_group
					,	era_adjustment_reason_code
					,	era_remark_code
					,	is_overridable
					,	pend_service_line
					,	print_on_eop							
					)
					VALUES (
						@claim_procedure_id
					,	@allowed_amount	
					,	@procedurecode_ud
					,	@from_service_date
					,	@charges
					,	@x12_837_2400_id	
					
					,	@line_count
 					,	@line_pricer_network_name
					,	@line_pricer_description_short
					,	@line_pricer_description_long
					,	@line_pricer_recommended_action
					,	@line_era_adjustment_group
					,	@line_era_adjustment_reason_code
					,	@line_era_remark_code
					,	@line_is_overridable
					,	@line_pend_service_line
					,	@line_print_on_eop						
					)
				END			
			END


			SELECT TOP 1
				@x12_837_2400_id = l.x12_837_2400_id
			,	@L2400_hcp01_pricing_methodology = ISNULL(l.L2400_hcp01_pricing_methodology,'')
			,	@L2400_hcp02_repriced_allowed_amount = ISNULL(l.L2400_hcp02_repriced_allowed_amount,'')
			,	@L2400_hcp03_repriced_savings_amount = ISNULL(l.L2400_hcp03_repriced_savings_amount,'')
			,	@L2400_hcp04_repriced_organization_identifier = ISNULL(l.L2400_hcp04_repriced_organization_identifier,'')
			,	@L2400_hcp07_repriced_approved_amount = ISNULL(l.L2400_hcp07_repriced_approved_amount, '')					--44227	
			,	@L2400_hcp13_reject_reason_code = ISNULL(l.L2400_hcp13_reject_reason_code,'')
			,	@procedurecode_ud = REPLACE(LEFT(L2400_sv202_procedure_code,15),'.','')
			,	@charges = 
					CASE WHEN ISNUMERIC(L2400_sv203_line_item_charge_amount) = 1 THEN CONVERT(MONEY,L2400_sv203_line_item_charge_amount)
					ELSE 0 END

			FROM dbo.x12_837_2400 l
			WHERE l.x12_837_2300_id = @x12_837_2300_id
				AND l.x12_837_2400_id > @x12_837_2400_id
				AND (
					LEN(L2400_hcp01_pricing_methodology) > 0
					OR LEN(L2400_hcp02_repriced_allowed_amount) > 0
					OR LEN(L2400_hcp03_repriced_savings_amount) > 0
					OR LEN(L2400_hcp04_repriced_organization_identifier) > 0
					OR LEN(L2400_hcp13_reject_reason_code) > 0
					)			
			ORDER BY l.x12_837_2400_id	
		END
		
		--	Some trading partners price at both the line and claim level and they should be balanced.
		IF @trading_partner_id IN ( 224 )		--	First Health - Coventry
			AND @total_allowed_amount > 0									--	We found line level dollars
			AND @total_allowed_amount <> ISNULL(@claim_allowed_amount,0)	--	line level and claim level total should match
		BEGIN
			SET @send_to_review_queue = 1
			SELECT @comment = 'EDI: The repriced total service line allowed amount [' + CONVERT(VARCHAR,ISNULL(@total_allowed_amount,0)) + '] does not equal the claim level allowed amount [' + CONVERT(VARCHAR,ISNULL(@claim_allowed_amount,0)) + '].'
			INSERT INTO @claim_comment (claim_id, comment, sort_order) VALUES (@claim_id, @comment, 99)
		END
			
	END
	--  23899
	ELSE
	BEGIN
		IF @claim_repricing_flag_id = 448  --ASA MEDICIAL
		   AND NOT EXISTS (SELECT 1 FROM  @claim_procedure )
		BEGIN

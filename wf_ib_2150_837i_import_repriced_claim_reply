	/*----------------------------------------------------------------------------------------------

		Multiplan/NCN performs 5 different kinds of pricing for WebTPA we call "repricing methodologies".
		Payment Integrity performs a 6th kind of processing called post-adjudication validation.
		
			Default		Traditional Network Pricing (PHCS)
			MLR			Medicare Like Repricing
			MR			Medicare Repricing
			WSR			WaterStone Repricing
			NCN			NCN Repricing
			PI			Payment Integrity post adjudication validation
	
		When we send a claim to Multiplan/NCN we save the repricing methodology on the 
		repricing claim history record.  When the claim comes back we have different rules
		for each of the 5 methodologies and each one is handled below.

		Multiplan sends these HCP01 repricing methdologies.  See the project's spreadsheet for
		full details on the combinations of return codes possible.
			HCP01	Notes
			00		Repriced without savings.  
					Will have an HCP13 T code.
					Either the provider is non-par or the claim is busted.

			14		Repriced with savings.  
					Will not have an HCP13 T code.
					The claim was successfully processed.

		When NCN claims are passed through to Multiplan and then on to WebTPA we sometimes have an
		issue with the concept of "Billed Fair" vs "Non-Par".

			Billed Fair		Pay 100% because the claim is fairly billed as <= the priced allowed amount.
			Non-Par			The provider is non-particpating.

		On both of the above scenarios NCN is using the same HCP01 pricing methdology:

			00		Repriced without savings.  

		This dual use of the same pricing methodology means we can't use automation to decide which of
		the two pricing scenarios NCN is trying to communicate so all '00' claims from NCN must go to
		their respective manual review queues for a provider maintenance person to examine.

		The general "global" Multiplan rules are at the top.  Each of the pricing methodologies then
		has it's own section for their specific rules.  We'll use the pricing methodology under which
		we transmitted the claim to the Multiplan to determine how we'll process the return values.

	----------------------------------------------------------------------------------------------*/

	declare @multiplan_note_codes table (
		nte02_claim_note_text		varchar(80)
	)

	delete from @external_edit

	declare @multiplan_billed_fair		bit

	if @trading_partner_id = 24		--	Multiplan - Reprice In
		and isnull(@outbound_repricing_methodology_id,0) <> @PI_pricing		--	Payment Integrity post-adjudication processing handled below Multiplan repricing
	begin

		if @debug = 1
			insert into dbo.application_log (application_type_id, program_step, program_data, stack_trace, instance_id, is_error, error_message, trading_partner_id)
			values (
					7
				,	'wf_ib_2150_837i_import_repriced_claim_reply - multiplan start'
				,	'@x12_837_2300_id : ' + isnull(convert(varchar,@x12_837_2300_id), 'null') + ' : ' + '@repricing_claim_history_id : ' + isnull(convert(varchar,@repricing_claim_history_id), 'null')	-- program_data
				,	null
				,	@instance_id
				,	0
				,	@error_message	
				,	@trading_partner_id )	

		---------------------------------
		--	Start with Par and turn it non-par if needed.
		---------------------------------
		set @claim_is_par = 1
		set @multiplan_billed_fair = 0

		---------------------------------
		--	We must have the methodology under which we sent the claim
		---------------------------------
		if @outbound_repricing_methodology_id is null
		--@NSA_pricing =  = 11       --  No Supprises Act QPA Pricing
			or @outbound_repricing_methodology_id not in ( @Default_pricing, @MLR_pricing, @MR_pricing, @WSR_pricing, @NCN_pricing, @NSA_pricing )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			
			if @outbound_repricing_methodology_id is null
				select @comment = 'EDI:  The outbound pricing methodology is missing from this claim.  Please forward this claim number to iiiPUT issues to correct the problem.'
			else
				select @comment = 'EDI:  The outbound pricing methodology on the claim is invalid for Multiplan.  Please forward this claim number to iiiPUT issues to correct the problem.'

			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end


		---------------------------------
		--	Multiplan/NCN Global Rules
		---------------------------------

		---------------------------------
		--	Determine Par/Non-Par
		---------------------------------
		
		--	00 Zero Pricing (Not Covered Under Contract)
		if @L2300_hcp01_pricing_methodology = '00'		--	More edits on this code down below
			set @claim_is_par = 0
	
		--	T1 Cannot Identify Provider as TPO (Third Party Organization) Participant
		if @L2300_hcp13_reject_reason_code = 'T1'
			set @claim_is_par = 0

		--	T6 Claim does not contain enough information for repricing
		--	These require intervention (usually correction and resubmit for pricing).
		if @L2300_hcp13_reject_reason_code = 'T6'
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The repricer reject code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '] indicates the claim is missing information that prevents repricing.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Multiplan only sends HCP13 as blank, T1, or T6 so something has gone wrong here.
		if isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The non-par indicator/reject code at the claim level is an invalid code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Multiplan only sends HCP01 as 00, 10, or 14 so something has gone wrong here.
		if isnull(@L2300_hcp01_pricing_methodology,'') not in ( '00','01','10','14' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: The pricing methodology at the claim level is an invalid code [' + isnull(@L2300_hcp01_pricing_methodology,'') + '].'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end

		--	Multiplan always sends either T1 or T6 with HCP01 00 so if we find something else we have missed our agreed upon handshake.
		if @L2300_hcp01_pricing_methodology= '00' and isnull(@L2300_hcp13_reject_reason_code,'') not in ( '','T1','T6' )
		begin
			set @claim_is_par = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: Multiplan has sent an invalid pricing methodology [00] and reject reason code [' + isnull(@L2300_hcp13_reject_reason_code,'') + '] combination.  We expect 00 with T1 or T6.  Please research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
		end


		---------------------------------
		--	Determine Claim Repricing Flag
		---------------------------------
		set @claim_repricing_flag_id = null	
		set @inbound_repricing_methodology_id = null
		set @nte02_note_text = null
		set @repriced_organization_identifier = @L2300_hcp04_repriced_organization_identifier

		--	Load our repricer notes into a work table.  We need to see if there is a code that helps find the claim_repricing_flag_id
		delete from @multiplan_note_codes		--	In case we make this some kinda loop and forget to reset the table

		--	Grab the claim level notes			
		insert into @multiplan_note_codes ( nte02_claim_note_text )
		select distinct n.L2300_nte02_claim_note_text
		from dbo.x12_837_2300_NTE n 
		where
			n.x12_837_2300_id = @x12_837_2300_id
			
		--	Grab the line level notes
		insert into @multiplan_note_codes ( nte02_claim_note_text )
		select distinct n.L2400_nte02_claim_note_text
		from dbo.x12_837_2400 l 
			inner join dbo.x12_837_2400_NTE n  on l.x12_837_2400_id = n.x12_837_2400_id
		where l.x12_837_2300_id = @x12_837_2300_id

			
		--	We just want the code at the front of the note in cases like this:  '01 Repriced Claim' we just need the '01' code (for now)
		update @multiplan_note_codes set nte02_claim_note_text =
			--	trim the code out of the note text by searching for the first space
			case when CHARINDEX(' ', nte02_claim_note_text) > 0 then SUBSTRING(nte02_claim_note_text, 1, CHARINDEX(' ', nte02_claim_note_text) -1 )
					else nte02_claim_note_text end

		
		--	if the claim is repriciced but the org id is missing look for it on the first procedure record
		if @claim_level_pricing_found = 1 and isnull(@repriced_organization_identifier,'') = ''
		begin
			select top 1
				@repriced_organization_identifier = isnull(c.L2400_hcp04_repriced_organization_identifier,'')
			from dbo.x12_837_2400 c 
			where c.x12_837_2300_id = @x12_837_2300_id
				and ( c.L2400_hcp01_pricing_methodology is not null
					or c.L2400_hcp13_reject_reason_code is not null
					or c.L2400_hcp04_repriced_organization_identifier is not null )		
			order by c.x12_837_2400_id
		end


		-----------------------------------------
		--	In addition to the usual flags for determining par/non-par we have this rule below.  This came
		--	about because Multiplan was sending us "billed fair" indicators that were the SAME as the non-par
		--	indicators and we couldn't tell them apart.  Well, now we can use these values to determing "billed fair"
		-----------------------------------------
		if @repriced_organization_identifier = '254'
			and @L2300_hcp01_pricing_methodology = '00'
			and @L2300_hcp13_reject_reason_code = 'T1'
			and exists (select 1 from @multiplan_note_codes n where n.nte02_claim_note_text = 'DI4')	--	Billed Fair
		begin
			set @multiplan_billed_fair = 1
			set @claim_is_par = 1
		end


		----------------------------------------
		--	I want to add some extra comments here from the Multiplan EOB Language documents
		----------------------------------------
		--	repriced_organization_identifier ='200'
		insert into @claim_comment (claim_id, comment, sort_order)
		select @claim_id
		,	case n.nte02_claim_note_text
				--	PAR
				when 'ZL' then 'EDI: Negotiated through MultiPlan; reduction is not billable to patient.'
				when 'MRN' then 'EDI: Pricing negotiated by NCN'	

				--	NON-PAR
				when 'ZNA' then 'EDI: Multiplan Reject Reason: Claim Routed to Negotiation Services but was denied'

			end
		,	99
		from @multiplan_note_codes n
		where 
			@repriced_organization_identifier ='200'
			and n.nte02_claim_note_text in (
				--	PAR
				'ZL'		--	Negotiated through MultiPlan; reduction is not billable to patient.
			,	'MRN'		--	EDI: Pricing negotiated by NCN

				--	NON-PAR
			,	'ZNA'		--	Claim Routed to Negotiation Services but was denied

		)

		--	repriced_organization_identifier ='222'
		--	Mostly Healthcare Highways for the Oklahoma office acquisition (OHN)
		insert into @claim_comment (claim_id, comment, sort_order)
		select @claim_id
		,	case n.nte02_claim_note_text
				--	PAR
				when 'CCD' then 'EDI: This claim was repriced using rates negotiated by Comanche County Hosp Authority'
				when 'CCH' then 'EDI: This claim was repriced using rates negotiated by Comanche County Hosp Authority'				

				when 'GPP' then 'EDI: This claim was repriced using rates negotiated by Great Plains Medical Center'
				when 'GPR' then 'EDI: This claim was repriced using rates negotiated by Great Plains Medical Center'	
							
				when 'JCH' then 'EDI: This claim was repriced using rates negotiated by Jackson County Memorial Hospital'
				when 'JCI' then 'EDI: This claim was repriced using rates negotiated by Jackson County Memorial Hospital'
				when 'JCO' then 'EDI: This claim was repriced using rates negotiated by Jackson County Memorial Hospital'
				when 'JCP' then 'EDI: This claim was repriced using rates negotiated by Jackson County Memorial Hospital'

				when 'OHN' then 'EDI: This claim was repriced using rates negotiated by Oklahoma Health Network'


					where h.repricing_claim_history_id =@QPA_repricing_claim_history_id
									
					end									

					exec [dbo].[wf_ib_2170_nsa]
						 @x12_837_2300_id			= @x12_837_2300_id_hop1				--reset to hop1
						,@inbound_file_id			= @inbound_file_id_hop1				--reset to hop1

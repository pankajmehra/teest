		,	line_network_id
		,	line_billed_amount
		,	line_allowed_amount
		,	line_savings_amount
		,	is_overridable
		,	era_adjustment_group
		,	era_adjustment_reason_code
		,	era_remark_code
		)
		select distinct
			'Payment Integrity'						--	vendor_name
		,	@inbound_file_id						--	inbound_file_id
		,	c.x12_837_2300_id
		,	cr.L2300_ref02_reference				--	external_ref_number
		,	@claim_id								--	claim_id
		,	cn.L2300_nte02_claim_note_text			--	claim_edit_code
		,	case cn.L2300_nte02_claim_note_text
				when 'CPC' then 'The claim is not eligible to route to the Payment Integrity claim review process due to valid reasons such as threshold limitations.'
				when '51' then 'The claim was submitted without pricing information (No HCP segment) and is not eligible to route to the Payment Integrity claim review process.'
				when 'CR0' then 'The claim was successfuly submitted to Payment Integrity and no edits were found.'
				when 'CR1' then 'Payment Integrity indicates the entire claim should be denied.'
				when 'CR2' then 'Payment Integrity indicates one or more service lines should be denied.'
				when 'CR3' then 'Payment Integrity indicates the claim is suspect and should be reviewed.'
				else null end
		,	case cn.L2300_nte02_claim_note_text
				when 'CPC' then 'NONE'
				when '51' then 'NONE'
				when 'CR0' then 'NONE'
				when 'CR1' then 'DENY'
				when 'CR2' then 'DENY'
				when 'CR3' then 'REVIEW'
				else null end
		,	c.L2300_hcp04_repriced_organization_identifier
		,	convert(money,c.L2300_clm02_total_claim_chg_amt)		--	claim_billed_amount
		,	convert(money,c.L2300_hcp02_repriced_allowed_amount)	--	claim_allowed_amount
		,	convert(money,c.L2300_hcp03_repriced_savings_amount)	--	claim_savings_amount
			,	cp.x12_837_2400_id
		,	cp.L2400_lx01_assigned_num				--	line_sequence_number
	--	,	cpr.L2400_ref02_reference				--	claim_procedure_id
		,	case when @repricing_claim_type_id = 2 then cpr.L2400_ref02_reference else null end	--	claim_procedure_id
		,	case when @repricing_claim_type_id = 3 then cpr.L2400_ref02_reference else null end	--	claim_ub92_service_id
		,	coalesce(cp.L2400_sv101_proc_code, cp.L2400_sv201_service_line_revenue_code, cp.L2400_sv202_procedure_code)	--	cpt_or_rev_code
		,	cpn.L2400_nte02_claim_note_text			--	line_edit_code
		,	case
				when @repricing_claim_type_id = 3 and cpn.L2400_nte02_claim_note_text like '%LAF1%' then 'The Payment Integrity UB92 detail note indicates a UB92 detail line should be denied.' 
				when cpn.L2400_nte02_claim_note_text like '%LAF1%' then 'The Payment Integrity service line note indicates the service line should be denied.'				
				when cn.L2300_nte02_claim_note_text in ('CR1','CR2','CR3') and isnull(convert(money,cp.L2400_hcp02_repriced_allowed_amount),0.00) = 0.00 and isnull(convert(money,cp.L2400_hcp03_repriced_savings_amount),0.00) > 0.00 then 'The Payment Integrity service line allowed amount indicates the service line should be denied.'
				else null end
		,	case 
				when cpn.L2400_nte02_claim_note_text like '%LAF1%' then 'DENY'
				when cn.L2300_nte02_claim_note_text in ('CR1','CR2','CR3') and isnull(convert(money,cp.L2400_hcp02_repriced_allowed_amount),0.00) = 0.00 and isnull(convert(money,cp.L2400_hcp03_repriced_savings_amount),0.00) > 0.00 then 'DENY'
				else null end
		,	cp.L2400_hcp04_repriced_organization_identifier
		,	convert(money,isnull(cp.L2400_sv102_line_charge, cp.L2400_sv203_line_item_charge_amount))
		,	convert(money,cp.L2400_hcp02_repriced_allowed_amount)	--	line_allowed_amount
		,	convert(money,cp.L2400_hcp03_repriced_savings_amount)	--	line_savings_amount
		,	0		--	is_overridable
		,	null	--	era_adjustment_group
		,	null	--	era_adjustment_reason_code
		,	null	--	era_remark_code
		from dbo.x12_837_2300 c
			left join dbo.x12_837_2300_REF cr on c.x12_837_2300_id = cr.x12_837_2300_id and cr.L2300_ref01_code = '9A'	--	external_ref_number
			left join dbo.x12_837_2300_NTE cn on c.x12_837_2300_id = cn.x12_837_2300_id

			inner join dbo.x12_837_2400 cp on c.x12_837_2300_id = cp.x12_837_2300_id
			left join dbo.x12_837_2400_REF cpr on cpr.x12_837_2400_id = cp.x12_837_2400_id and cpr.L2400_ref01_code = '6R'	--	claim_procedure_id
			left join dbo.x12_837_2400_NTE cpn on cp.x12_837_2400_id = cpn.x12_837_2400_id
		where
			c.x12_837_2300_id = @x12_837_2300_id
		
		--	The '6R' REF segment contains the claim_ub92_service_id for UB92 claims so lets go get the 1st claim_procedure_id on the claim.
		if @repricing_claim_type_id = 3		--	UB92
		begin
			set @claim_procedure_id = null

			select top 1 @claim_procedure_id = cp.claim_procedure_id
			from mcr_dc_prod.dbo.claim_procedure cp
			where cp.claim_id = @claim_id
			order by cp.claim_procedure_id

			update @multiplan_payment_integrity_records set claim_procedure_id = @claim_procedure_id
		end

		--	If we don't have a claim_procedure_id, use the first one on the claim.  We MUST have one.
		if exists ( select 1 from @multiplan_payment_integrity_records r where r.claim_procedure_id is null )
		begin
			set @claim_procedure_id = null

			select top 1 @claim_procedure_id = cp.claim_procedure_id
			from mcr_dc_prod.dbo.claim_procedure cp
			where cp.claim_id = @claim_id
			order by cp.claim_procedure_id

			update @multiplan_payment_integrity_records set claim_procedure_id = @claim_procedure_id
			where claim_procedure_id is null
		end


		--	Make claim comments out of these because they aren't handled in the code below.
		insert into @claim_comment (claim_id, comment, sort_order)
		select distinct @claim_id, 'EDI: ' + n.claim_edit_code, 99
		from @multiplan_payment_integrity_records n
		where n.claim_edit_code not in (
				'CPC'
			,	'51'
			,	'CR0'
			,	'CR1'
			,	'CR2'
			,	'CR3'
			)
			or ( n.line_edit_code is not null and n.line_edit_code not like '%LAF1%' )


		-----------------------------------------------------
		--	Validate the 3 possible Payment Integrity scenarioes
		-----------------------------------------------------
		declare @is_payer_integrity_scenario_valid		bit

		set @is_payer_integrity_scenario_valid = 0


		/*-------------------------------------------------------------------------------------------------------
		1.	If a Payment Integrity claim is submitted with pricing information on the HCP Segment, and is not
			eligible to route to the Payment Integrity claim review process due to valid reasons such as threshold
			limitations.

			2300*HCP*04 = 54
			2300*NTE*02 = CPC

			2400*HCP*04 = 54
			2400*NTE segment will not be populated
		-------------------------------------------------------------------------------------------------------*/
		if @L2300_hcp04_repriced_organization_identifier = '54'
		begin

			--	We "should" disable this line after we're comfortable with the implementation and automate the response for this scenario.
			--	set @send_to_review_queue = 1

			--	This value is required for scenario #1
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.claim_edit_code = 'CPC'
			)
			begin
				--	This can be overridden in the validation just below.
				set @is_payer_integrity_scenario_valid = 1

				select @comment = 'EDI: Multiplan/Payment Integrity is unable to review this claim due to valid reasons such as threshold limitations.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end

			--	There should be no line level notes for scenario #1
			if exists (
			select 1
			from @multiplan_payment_integrity_records n
			where n.line_edit_code is not null
			)
			begin
				set @is_payer_integrity_scenario_valid = 0

				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid line level note.  We expect there to be no line level notes for network ID 54.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end
		end

		--	Validate note code '54' only exists with network ID '54'.
		if @L2300_hcp04_repriced_organization_identifier <> '54'
		begin
			if exists (
				select 1
				from @multiplan_payment_integrity_records n
				where n.claim_edit_code = 'CPC'
			)
			begin
				set @is_payer_integrity_scenario_valid = 0

				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid note.  We do not expect note code CPC without a network ID 54.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end			
		end


		/*-------------------------------------------------------------------------------------------------------
		2.	If a Payment Integrity claim is submitted without pricing information (No HCP segment) and is not
			eligible to route to the Payment Integrity claim review process.

			We should never encounter this scenario.  We send an HCP segment with ALL professional claims.
			We don't send an HCP segment with ANY institutional claim but Payment Integrity takes the charged
			amount as the HCP allowed.  They made that decision all on their on.

			2300*HCP*04 = 57
			2300*NTE*02 = 51

			2400*HCP*04 = 57
			2400*NTE segment will not be populated
		-------------------------------------------------------------------------------------------------------*/
		if @L2300_hcp04_repriced_organization_identifier = '57'
		begin

			--	Yes, this is a "valid" scenario, but we should never receive this scenario, so send to review queue.
			set @is_payer_integrity_scenario_valid = 0
			set @send_to_review_queue = 1
			select @comment = 'EDI: Multiplan/Payment Integrity sent us a network ID [57] that we should never encounter.  Please send to iii:PUT issues for research.'
			insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

			--	This value is required for scenario #2
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.claim_edit_code = '51'
			)
			begin
				--	This can be overridden in the validation just below.
			--	set @is_payer_integrity_scenario_valid = 0			this whole scenario is invalid according to our current arrangement

				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity is unable to review this claim because WebTPA did not transmit the HCP pricing segment.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end

			--	There should be no line level notes for scenario #2
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.line_edit_code is not null					
			)
			begin
			--	set @is_payer_integrity_scenario_valid = 0			this whole scenario is invalid according to our current arrangement

				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid line level note.  We expect there to be no line level notes for network ID 57.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end
		end

		--	Validate note code '51' only exists with network ID '57'.
		if @L2300_hcp04_repriced_organization_identifier <> '57'
		begin
			if exists (
				select 1
				from @multiplan_payment_integrity_records n
				where n.claim_edit_code = '51'
			)
			begin
				set @send_to_review_queue = 1
				set @is_payer_integrity_scenario_valid = 0
				select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid note.  We do not expect note code 51 without a network ID 57.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end			
		end


		/*-------------------------------------------------------------------------------------------------------
		3.	If a Payment Integrity claim is submitted (with or without pricing information), and is eligible to
			route to the Payment Integrity claim review process.

			a.	Pay Claim
				2300*HCP*04 = 290
				2300*NTE*02 = CR0

				2400*HCP*04 = 290
				2400*NTE segment will not be populated

			b.	Deny whole claim; see claim comments.
				2300*HCP*04 = 290
				2300*HCP*02 = allowed will be zero
				2300*HCP*03 = savings will be covered charges
				2300*NTE*02 = CR1

				2400*HCP*04 = 290
				2400*HCP*02 = allowed will be zero
				2400*HCP*03 = savings will be covered charges
				2400*NTE*02 = will contain LAF1 for all lines ???  Yes in test files.

			c.	Deny one or more lines; see claim comments.		
				2300*HCP*04 = 290
				2300*NTE*02 = CR2

				2400*HCP*04 = 290
				2400*NTE*02 = will contain LAF1 for denied lines

			d.	Suspect claim; see claim comments.
				2300*HCP*04 = 290
				2300*NTE*02 = CR3

				2400*HCP*04 = 290
				2400*NTE*02 = can, but not always, contain LAF1 for suspect lines


		-------------------------------------------------------------------------------------------------------*/
		if @L2300_hcp04_repriced_organization_identifier = '290'
		begin

			--	We should disable this line after we're comfortable with the implementation and automate the response for this scenario.
			--	set @send_to_review_queue = 1

			--	Scenario 3a : Pay claim
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.claim_edit_code = 'CR0'
			)
			begin
				--	This can be overridden in the validation just below.
				set @is_payer_integrity_scenario_valid = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has reviewed this claim and did not find any issues.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

				--	There should be no line level notes for scenario #1
				if exists (
				select 1
				from @multiplan_payment_integrity_records n
				where n.line_edit_code is not null
				)
				begin
					set @is_payer_integrity_scenario_valid = 0

					set @send_to_review_queue = 1
					select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid line level note.  We expect there to be no line level notes for network ID 290 with a claim level note CR0.  Please send to iii:PUT issues for research.'
					insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
				end
			end

			--	Scenario 3b : Deny whole claim
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.claim_edit_code = 'CR1'
			)
			begin
				--	This can be overridden in the validation just below.
				set @is_payer_integrity_scenario_valid = 1

				set @send_to_review_queue = 1	--	We may opt to not send these to the review queue after we're comfortable with it.
				select @comment = 'EDI: Multiplan/Payment Integrity has reviewed this claim and recommended WebTPA deny the entire claim.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

			end

			--	Scenario 3c : One or more line denials
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.claim_edit_code = 'CR2'
			)
			begin
				--	This can be overridden in the validation just below.
				set @is_payer_integrity_scenario_valid = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has reviewed this claim and is recommending one or more lines be denied.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

				--	There should be at least one line with a denial note containing LAF1.
				if exists (
					select 1
					from @multiplan_payment_integrity_records n
					where n.line_edit_code like '%LAF1%'
				)
				begin
				
					--	Save a claim comment indicating which line(s) Payment Integrity wants to deny.
					if @repricing_claim_type_id = 3		--	UB92
					begin
						insert into @claim_comment (claim_id, comment, sort_order)
						select 
							@claim_id
						,	'EDI: Multiplan/Payment Integrity has indicated to deny UB92 detail service line [' + isnull(convert(varchar,n.line_sequence_number),'??') + '].'
						,	99
						from @multiplan_payment_integrity_records n
						where n.line_edit_code like '%LAF1%'
						order by n.line_sequence_number
					end
					else
					begin
						insert into @claim_comment (claim_id, comment, sort_order)
						select 
							@claim_id
						,	'EDI: Multiplan/Payment Integrity has indicated to deny service line [' + isnull(convert(varchar,n.line_sequence_number),'??') + '].'
						,	99
						from @multiplan_payment_integrity_records n
						where n.line_edit_code like '%LAF1%'
						order by n.line_sequence_number
					end

				end
				else
				begin
					--	We should have at least one line level note indicating which line(s) to deny.
					set @is_payer_integrity_scenario_valid = 0

					set @send_to_review_queue = 1
					select @comment = 'EDI: Multiplan/Payment Integrity has indicated to deny one or more lines but failed to indicate which ones in the line notes.  Please send to iii:PUT issues for research.'
					insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
				end
			end

			--	Scenario 3d : One or more line denials
			if exists (
				select 1
				from @multiplan_payment_integrity_records n 
				where n.claim_edit_code = 'CR3'
			)
			begin
				--	This can be overridden in the validation just below.
				set @is_payer_integrity_scenario_valid = 1

				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has reviewed this claim and indicated it is "suspect" and should be reviewed.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)

				--	At least sometimes (maybe always), there be line level notes containing LAF1 for "suspect" claims.
				if exists (
					select 1
					from @multiplan_payment_integrity_records n
					where n.line_edit_code like '%LAF1%'
				)
				begin

					--	Save a claim comment indicating which line(s) Payment Integrity wants to deny.
					if @repricing_claim_type_id = 3		--	UB92
					begin
						insert into @claim_comment (claim_id, comment, sort_order)
						select 
							@claim_id
						,	'EDI: Multiplan/Payment Integrity has indicated to deny UB92 detail service line [' + isnull(convert(varchar,n.line_sequence_number),'??') + '].'
						,	99
						from @multiplan_payment_integrity_records n
						where n.line_edit_code like '%LAF1%'
						order by n.line_sequence_number
					end
					else
					begin
						insert into @claim_comment (claim_id, comment, sort_order)
						select 
							@claim_id
						,	'EDI: Multiplan/Payment Integrity has indicated to deny service line [' + isnull(convert(varchar,n.line_sequence_number),'??') + '].'
						,	99
						from @multiplan_payment_integrity_records n
						where n.line_edit_code like '%LAF1%'
						order by n.line_sequence_number
					end

				end
			end

		end

		--	Validate note codes 'CRx' and 'LAF1' only exists with network ID '290'.
		if @L2300_hcp04_repriced_organization_identifier <> '290'
		begin
			if exists (
				select 1
				from @multiplan_payment_integrity_records n
				where n.claim_edit_code in ( 'CR0', 'CR1', 'CR2', 'CR3' )
					or n.line_edit_code like '%LAF1%'
			)
			begin
				set @is_payer_integrity_scenario_valid = 0

				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has sent an invalid note.  We do not expect note codes CR0, CR1, CR2, CR3, or LAF1 without a network ID 290.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end			
		end	


		-----------------------------------------------------
		--	Only these scenarios can have a supplemental file record
		--	so move the rest along and skip the supp queue.
		-----------------------------------------------------
		if not exists (
			select 1
			from @multiplan_payment_integrity_records n
			where n.claim_edit_code in ( 'CR1','CR2','CR3' )	)
		begin
			set @in_process_supplemental_workflow_id = null
		end

		-----------------------------------------------------
		--	Be sure if we "need" supplemental processing we have a queue to route to.
		-----------------------------------------------------
		if exists (
			select 1
			from @multiplan_payment_integrity_records n
			where n.claim_edit_code in ( 'CR1','CR2','CR3' )	)
		begin
			if @in_process_supplemental_workflow_id is null
			begin
				set @send_to_review_queue = 1
				select @comment = 'EDI: Multiplan/Payment Integrity has sent a claim edit that requires supplemental processing but the supplementatl processing queue is missing.  Please send to iii:PUT issues for research.'
				insert into @claim_comment (claim_id, comment, sort_order) values (@claim_id, @comment, 99)
			end
		end

		-------------------------------------------
		--	Save our payment integrity records.  Some
		--	of these may be updated by the supplemenatl CSV file.
		-------------------------------------------
		delete from e
		from repricing_external_edit e
		where e.inbound_file_id = @inbound_file_id
			and e.claim_id = @claim_id

		--	These three should be sent to the claim procedure records...the rest not.
		update r set
			r.is_overridable = 1
		,	r.era_adjustment_group = 'PI'
		,	r.era_adjustment_reason_code = '97'
		from @multiplan_payment_integrity_records r
		where r.claim_edit_code in ( 'CR1','CR2','CR3' )


		insert into repricing_external_edit (
				vendor_name
			,	inbound_file_id
			,	x12_837_2300_id
			,	external_ref_number
			,	claim_id
			,	claim_edit_code
			,	claim_edit_description
			,	claim_network_id
			,	claim_billed_amount
			,	claim_allowed_amount
			,	claim_savings_amount
			,	claim_recommended_action
			,	x12_837_2400_id
			,	line_sequence_number
			,	claim_procedure_id
			,	claim_ub92_service_id
			,	cpt_or_rev_code
			,	line_edit_code
			,	line_edit_description
			,	line_network_id
			,	line_billed_amount
			,	line_allowed_amount
			,	line_savings_amount
			,	line_recommended_action
			,	is_overridable
			,	era_adjustment_group
			,	era_adjustment_reason_code
			,	era_remark_code
			,	print_on_eop
			,	pend_service_line
		)
		select
				'Payment Integrity'	'vendor_name'
			,	@inbound_file_id	'inbound_file_id'
			,	x12_837_2300_id

        --US#45202 Capture history for emails sent previously so that the next product email can be determined

		DROP TABLE IF EXISTS [#last_sent];

		WITH hist AS
		(
			SELECT
				[person_key] = COALESCE([m].[ssn], [m].[email], [m].[phone]),
				[product_id] = [c].[product_id],
				[rownum] = ROW_NUMBER() OVER
					  (
						  PARTITION BY COALESCE([m].[ssn], [m].[email], [m].[phone])
						  ORDER BY [c].[created_date] DESC,
						  [c].[hart_vol_claim_connect_communication_id] desc
					  )
			FROM [EDee].[dbo].[hart_vol_claim_connect_communication] [c]
			INNER JOIN [dbo].[member] [m]
				ON [m].[member_id] = [c].[member_id]
			WHERE [c].[deleted] = 0
			  AND [c].[communication_type] = 'Email'
			  AND [c].[communication_frequency] = 'Q'
		)
		SELECT
			[person_key],
			[last_product_id] = [product_id]
		INTO [#last_sent]
		FROM hist
		WHERE [rownum] = 1;

        DROP TABLE IF EXISTS [#all_hart_vol_subscrbr_unique];

		WITH ranked AS
		(
			SELECT
				[a].*,
				[b].[product_rank] AS [last_sent_rank]
			FROM [#all_hart_vol_subscrbr_with_dupes] [a]
			LEFT JOIN [#last_sent] [ls]
				ON [ls].[person_key] = [a].[person_key]
			LEFT JOIN [#all_hart_vol_subscrbr_with_dupes] [b]
				ON [b].[person_key] = [a].[person_key]
			  AND [b].[product_id] = [ls].[last_product_id]
		),
		final_pick AS
		(
			SELECT *,
				  [target_rank] = CASE
									  WHEN [last_sent_rank] IS NULL THEN 1
									  WHEN [last_sent_rank] >= [max_rank] THEN 1
									  ELSE [last_sent_rank] + 1
								  END
			FROM ranked
		),

		final_dedup AS
		(
			SELECT *,
					ROW_NUMBER() OVER
					(
						PARTITION BY [member_id]
						ORDER BY [product_rank], [product_id]
					) AS rownum
			FROM final_pick
			WHERE [product_rank] = [target_rank]
		)
		SELECT *
		INTO [#all_hart_vol_subscrbr_unique]
		FROM final_dedup
		WHERE rownum = 1;
 


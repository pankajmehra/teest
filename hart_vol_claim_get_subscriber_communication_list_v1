        -- declare @arg_current_increment_year int=NULL, @arg_current_increment int=null, @member_id int; drop table if exists #tab_product_id_duped create table #tab_product_id_duped ([hart_vol_claim_connect_template_type_id] int, template_type_ud varchar(100), product_id INT, product_hierarchy tinyint, communication_frequency varchar(5));  drop table if exists #all_hart_vol_subscrbr_with_dupes Insert #tab_product_id_duped ([hart_vol_claim_connect_template_type_id], template_type_ud, product_id, product_hierarchy, communication_frequency) select [hart_vol_claim_connect_template_type_id], template_type_ud, product_id, product_hierarchy, communication_frequency from [EDee].[dbo].[hart_vol_claim_connect_template_type] order by product_hierarchy

Execution time: < 1 second
Created:        04/17/2026 AJ - US #46007
Modified:       07/15/2026 - US #47101 - Updated duplicate validation to exclude
                Comment and Thru Date and to validate both inserts and updates. 
*******************************************************************************************/

ALTER   PROCEDURE [web].[group_holdover_sav]
    @source VARCHAR(255),
    @parent_employergroup_id INT,
    @employergroup_id INT,
    @employergroup_ud VARCHAR(15),
    @group_contract_id INT,
    @benefitplan_id INT,
    @effective_date DATETIME,
    @thru_date DATETIME,
    @use_received_date BIT,
    @use_incurred_date BIT,
    @comment VARCHAR(255),
    @p_user_id INT,
    @p_call_stack VARCHAR(MAX),
    @group_holdover_table_id INT OUTPUT,
    @status_message VARCHAR(255) OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY

        ---------------------------------------
        -- Required Logging for All Procedures
        ---------------------------------------
        DECLARE @debug BIT;
        DECLARE @instance_id UNIQUEIDENTIFIER;
        DECLARE @application_name VARCHAR(100);
        DECLARE @stored_procedure NVARCHAR(128);
        DECLARE @application_step VARCHAR(100);
        DECLARE @key_name VARCHAR(100);
        DECLARE @key_value VARCHAR(100);
        DECLARE @row_count INT;
        DECLARE @start_time DATETIME;
        DECLARE @previous_step_time DATETIME;
        DECLARE @step_time DATETIME;
        DECLARE @step_duration BIGINT;
        DECLARE @total_duration BIGINT;
        DECLARE @error_comment VARCHAR(8000);
        DECLARE @error_message VARCHAR(8000);
        DECLARE @is_error BIT;

        DECLARE @created_user VARCHAR(50) =
        (
            SELECT DISTINCT
                   'WEBTPA\' + SU.login_name
            FROM dbo.sec_user SU
            WHERE SU.sec_user_id = @p_user_id
        );

        DECLARE @modified_user VARCHAR(50) =
        (
            SELECT DISTINCT
                   'WEBTPA\' + SU.login_name
            FROM dbo.sec_user SU
            WHERE SU.sec_user_id = @p_user_id
        );

        EXEC sp_set_session_context 'user_name', @created_user;
        EXEC sp_set_session_context 'user_id', @p_user_id;

        ---------------------------------------
        -- Initialize Debug Variables
        ---------------------------------------
        SET @debug = 1;
        SET @instance_id = ISNULL(@instance_id, NEWID());

        -- Maintain a call stack for error reporting
        IF @p_call_stack IS NULL
            SET @p_call_stack = '';
        ELSE
            SET @p_call_stack =
                @p_call_stack
                + ' | '
                + ISNULL(OBJECT_NAME(@@PROCID), 'unknown');

        -- Add parameter list to call stack.
        SET @p_call_stack =
            LEFT
            (
                @p_call_stack
                + ' : Parameter List : '
                + '@p_user_id='
                + ISNULL(CONVERT(VARCHAR, @p_user_id), 'null'),
                8000
            );

        SET @application_name = 'Nexus/Websphere Web Client';
        SET @stored_procedure = OBJECT_NAME(@@PROCID);
        SET @start_time = GETDATE();
        SET @previous_step_time = @start_time;

        SET @application_step = 'Start';
        SET @key_name = NULL;
        SET @key_value = NULL;
        SET @row_count = NULL;
        SET @step_time = GETDATE();
        SET @step_duration =
            DATEDIFF(MILLISECOND, @previous_step_time, @step_time);
        SET @previous_step_time = @step_time;
        SET @total_duration =
            DATEDIFF(MILLISECOND, @start_time, @step_time);
        SET @error_comment = NULL;
        SET @is_error = 0;

        IF @debug = 1
        BEGIN
            INSERT INTO application_log
            (
                application_name,
                stored_procedure,
                application_step,
                key_name,
                key_value,
                row_count,
                step_time,
                step_duration,
                total_duration,
                call_stack,
                comment,
                is_error,
                error_message,
                instance_id
            )
            VALUES
            (
                @application_name,
                @stored_procedure,
                @application_step,
                @key_name,
                @key_value,
                @row_count,
                @start_time,
                @step_duration,
                @total_duration,
                NULL,
                @comment,
                @is_error,
                @error_message,
                @instance_id
            );
        END;

        ------------------- performance monitoring code end ------------------------

        SET @source = 'MCRDC';

        DECLARE @existing_records INT; 

        ----------------------------------------------------
        -- Check for duplicates. --47101
        -- Comment and Thru Date are intentionally excluded --47101
        -- from the duplicate comparison. --47101
        -- The current record is excluded during an update. --47101
        ----------------------------------------------------
        SELECT
            @existing_records = COUNT(*) 
        FROM [mcr_dc_prod].[dbo].[group_holdover_table] 
        WHERE source = @source 
          AND deleted = 0 
		  AND 
          ( 
              parent_employergroup_id = @parent_employergroup_id 
              OR 
              ( 
                  parent_employergroup_id IS NULL 
                  AND @parent_employergroup_id IS NULL 
              ) 
          ) 
          AND 
          ( 
              employergroup_id = @employergroup_id 
              OR 
              ( 
                  employergroup_id IS NULL 
                  AND @employergroup_id IS NULL 
              ) 
          ) 
          AND 
          ( 
              employergroup_ud = @employergroup_ud 
              OR 
              ( 
                  employergroup_ud IS NULL 
                  AND @employergroup_ud IS NULL 
              ) 
          ) 
          AND 
          ( 
              group_contract_id = @group_contract_id 
              OR 
              ( 
                  group_contract_id IS NULL 
                  AND @group_contract_id IS NULL 
              ) 
          ) 
          AND 
          ( 
              benefitplan_id = @benefitplan_id 
              OR 
              ( 
                  benefitplan_id IS NULL 
                  AND @benefitplan_id IS NULL 
              ) 
          ) 
          AND effective_date = CAST(@effective_date AS DATE) 
          AND use_received_date = @use_received_date 
          AND use_incurred_date = @use_incurred_date 
          AND 
          ( 
              @group_holdover_table_id IS NULL 
              OR group_holdover_table_id <> @group_holdover_table_id 
          ); 

        ----------------------------------------------------
        -- Return duplicate error for an insert or update. --47101
        ----------------------------------------------------
        IF @existing_records > 0 
        BEGIN
            SET @group_holdover_table_id = -1; 
            SET @status_message = 'Duplicate record'; 
            RETURN -1; 
        END; 

        ----------------------------------------------------
        -- Update an existing record. --47101
        ----------------------------------------------------
        IF @group_holdover_table_id IS NOT NULL 
           AND EXISTS 
           ( 
               SELECT 1 
               FROM [mcr_dc_prod].[dbo].[group_holdover_table] 
               WHERE group_holdover_table_id = @group_holdover_table_id 
                 AND deleted = 0 
           ) 
        BEGIN

            UPDATE [mcr_dc_prod].[dbo].[group_holdover_table]
            SET source = @source,
                parent_employergroup_id = @parent_employergroup_id,
                employergroup_id = @employergroup_id,
                employergroup_ud = @employergroup_ud,
                group_contract_id = @group_contract_id,
                benefitplan_id = @benefitplan_id,
                effective_date = CAST(@effective_date AS DATE),
                thru_date = CAST(@thru_date AS DATE),
                use_received_date = @use_received_date,
                use_incurred_date = @use_incurred_date,
                comment = @comment,
                modified_user = @modified_user,
                modified_date = GETDATE()
            WHERE group_holdover_table_id = @group_holdover_table_id;

            SET @status_message = 'Update record Successful';

        END;
        ELSE 
        BEGIN

            ----------------------------------------------------
            -- Insert a new record. --47101
            ----------------------------------------------------
            INSERT INTO [mcr_dc_prod].[dbo].[group_holdover_table]
            (
                [source],
                [employergroup_id],
                [employergroup_ud],
                [group_contract_id],
                [benefitplan_id],
                [effective_date],
                [thru_date],
                [use_received_date],
                [use_incurred_date],
                [comment],
                [created_date],
                [created_user],
                [deleted],
                [parent_employergroup_id]
            )
            VALUES
            (
                @source,
                @employergroup_id,
                @employergroup_ud,
                @group_contract_id,
                @benefitplan_id,
                CAST(@effective_date AS DATE),
                CAST(@thru_date AS DATE),
                @use_received_date,
                @use_incurred_date,
                @comment,
                GETDATE(),
                @created_user,
                0,
                @parent_employergroup_id
            );

            SET @group_holdover_table_id =
                CONVERT(INT, SCOPE_IDENTITY()); 

            SET @status_message = 'Insert record Successful';

        END;

        ------------------- performance monitoring code start ------------------------

        SET @application_step = 'Complete';
        SET @key_name = NULL;
        SET @key_value = NULL;
        SET @row_count = NULL;
        SET @step_time = GETDATE();
        SET @step_duration =
            DATEDIFF(MILLISECOND, @previous_step_time, @step_time);
        SET @previous_step_time = @step_time;
        SET @total_duration =
            DATEDIFF(MILLISECOND, @start_time, @step_time);
        SET @error_comment = NULL; 
        SET @is_error = 0;

        IF @debug = 1
        BEGIN
            INSERT INTO application_log
            (
                application_name,
                stored_procedure,
                application_step,
                key_name,
                key_value,
                row_count,
                step_time,
                step_duration,
                total_duration,
                call_stack,
                comment,
                is_error,
                error_message,
                instance_id
            )
            VALUES
            (
                @application_name,
                @stored_procedure,
                @application_step,
                @key_name,
                @key_value,
                @row_count,
                @start_time,
                @step_duration,
                @total_duration,
                NULL,
                @error_comment,
                @is_error,
                @error_message,
                @instance_id
            );
        END;

        ------------------- performance monitoring code end ------------------------

        -- If we got here, we did not encounter any unexpected errors.
        RETURN 0;

    END TRY

    BEGIN CATCH

        SET @error_message =
              'A database error occurred:'
            + CHAR(13) + CHAR(10)
            + 'Procedure Name: ' + '[web].[group_holdover_sav]' 
            + CHAR(13) + CHAR(10)
            + 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR(30))
            + CHAR(13) + CHAR(10)
            + 'Error Description: ' + ERROR_MESSAGE()
            + CHAR(13) + CHAR(10)
            + 'User: ' + SUSER_SNAME();

        THROW;

    END CATCH;

END;

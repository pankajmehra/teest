	    ,''                               -- cCheckMessage2				    
	    ,ISNULL(@micr_line, '')           -- cMicrline					    
	    ,ISNULL(@check_amount_char, '')   -- cCheckAmount					    
	    ,''                               -- cBankLogo					    
	    ,''                               -- cAdminLine1					    
